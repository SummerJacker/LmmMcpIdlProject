// MCP task-level contract. This file does not replace or modify the five base IDLs.
module MCP_Swarm_Task {
  typedef string UnitID;
  typedef string TaskID;

  enum TaskState {
    PENDING,
    RUNNING,
    COMPLETED,
    PARTIAL_COMPLETED,
    FAILED,
    TIMEOUT,
    CANCELLED,
    REJECTED
  };

  enum CancellationEffect {
    NOT_APPLICABLE,         // operation is not a cancellation
    CANCEL_CONFIRMED,       // local/mock task ended and its motion state was cleared
    STOP_REQUESTED,         // stop was requested, but base IDL cannot clear a task point/path
    STATE_ONLY_CANCELLED    // state was cancelled but no stop RPC could be confirmed
  };

  struct Point2D {
    float x;
    float y;
  };

  struct CapabilityFlag {
    boolean supported;
    string reason;
  };

  struct Capabilities {
    CapabilityFlag target_point_navigation;
    CapabilityFlag path_tasks;
    CapabilityFlag static_geometric_formation;
    CapabilityFlag continuous_follow_formation;
    CapabilityFlag final_yaw;
    CapabilityFlag navigation_speed;
    CapabilityFlag strict_cancel;
    CapabilityFlag real_unit_rpc;
  };

  struct UnitSnapshot {
    UnitID unit_id;
    string run_mode;       // sim | real
    boolean online;
    boolean online_verified;
    boolean rpc_available;
    boolean busy;
    boolean mock;
  };

  struct FleetSnapshot {
    sequence<UnitSnapshot> units;
    boolean rpc_enabled;
  };

  enum FormationType {
    line,
    triangle,
    column
  };

  struct StaticFormationRequest {
    FormationType formation_type;
    sequence<UnitID> unit_ids;
    float spacing_m;
    Point2D anchor;
    float heading_rad;
    float tolerance_m;
    unsigned long timeout_ms;
  };

  struct FollowMember {
    UnitID unit_id;
    float distance_m;
  };

  struct FollowFormationRequest {
    UnitID leader_id;
    sequence<FollowMember> followers;
  };

  struct AirGroundFollower {
    UnitID unit_id;
    float distance_m;
    float angle_deg;       // chain angle in degrees, converted to radians at the Console boundary
  };

  struct AirGroundFormationRequest {
    UnitID air_leader_id;  // UAV leader (A*)
    float air_altitude_m;  // UAV flight altitude
    sequence<AirGroundFollower> ground_followers;  // UGV chain (G*), first follows the air leader
  };

  struct FollowMotionSegment {
    float linear_velocity;
    float angular_velocity;
    unsigned long duration_ms;
    unsigned long buffer_ms;
  };

  struct MotionCommandRequest {
    UnitID unit_id;
    float linear_velocity;
    float angular_velocity;
    unsigned long duration_ms;
  };

  struct FollowMemberStatus {
    UnitID unit_id;
    float requested_distance_m;
    float effective_distance_m;
  };

  struct UnitTaskResult {
    UnitID unit_id;
    TaskState state;
    float progress_pct;
    string message;
    string error_code;
  };

  // Logical payload carried in the HTTP/MCP response envelope's data field.
  struct TaskResult {
    boolean success;
    TaskID task_id;
    string task_type;
    TaskState state;
    float progress_pct;
    string message;
    string error_code;
    sequence<UnitTaskResult> unit_results;
    unsigned long elapsed_ms;
    unsigned long started_at_ms;
    CancellationEffect cancellation_effect;
  };

  struct FormationStatus {
    boolean has_active_formation;
    string state;          // IDLE | CREATING | READY | MOVING | FAILED
    UnitID leader_id;
    sequence<FollowMemberStatus> followers;
    string active_move_task_id;
    string message;
    string error_code;
  };

  const string ERR_OK = "";
  const string ERR_UNIT_NOT_FOUND = "UNIT_NOT_FOUND";
  const string ERR_UNIT_OFFLINE = "UNIT_OFFLINE";
  const string ERR_UNIT_BUSY = "UNIT_BUSY";
  const string ERR_TASK_CONFLICT = "TASK_CONFLICT";
  const string ERR_TASK_NOT_FOUND = "TASK_NOT_FOUND";
  const string ERR_TASK_ALREADY_CANCELLED = "TASK_ALREADY_CANCELLED";
  const string ERR_TARGET_OUT_OF_BOUNDS = "TARGET_OUT_OF_BOUNDS";
  const string ERR_SAFETY_REJECTED = "SAFETY_REJECTED";
  const string ERR_FORMATION_NOT_READY = "FORMATION_NOT_READY";
  const string ERR_FORMATION_CONFLICT = "FORMATION_CONFLICT";
  const string ERR_UNSUPPORTED_CAPABILITY = "UNSUPPORTED_CAPABILITY";
  const string ERR_RPC_DISABLED = "RPC_DISABLED";
  const string ERR_INTERNAL_ERROR = "INTERNAL_ERROR";

  interface SwarmTaskControl {
    Capabilities getCapabilities();
    FleetSnapshot getFleetSnapshot();

    // Base Ground_Unit.setTaskPoint supports x/y only: no final yaw or task speed.
    TaskResult navigateTo(
      in UnitID unit_id,
      in Point2D target,
      in float tolerance_m,
      in unsigned long timeout_ms
    );

    TaskResult followPath(
      in UnitID unit_id,
      in sequence<Point2D> points,
      in float tolerance_m,
      in unsigned long timeout_ms
    );

    // Computes local geometry, rotates by heading_rad and translates by anchor.
    // Does not establish persistent leader/follower relationships.
    TaskResult createStaticFormation(in StaticFormationRequest request);

    // Console atomically sets leader/followers, dispatches formation data,
    // enables Follow mode and reports READY only after all required steps succeed.
    FormationStatus createFollowFormation(in FollowFormationRequest request);

    // Hybrid air-ground formation: a UAV leader + a UGV ground chain.
    FormationStatus createAirGroundFormation(in AirGroundFormationRequest request);
    TaskResult moveFollowFormation(in Point2D target);
    TaskResult moveFollowFormationSequence(
      in sequence<FollowMotionSegment> segments
    );
    TaskResult executeMotion(in MotionCommandRequest request);
    FormationStatus getFormationStatus();
    FormationStatus disbandFormation();

    TaskResult getTaskStatus(in TaskID task_id);
    TaskResult cancelTask(in TaskID task_id);

    // Sends Unit_MA_Stop only; it does not cancel task state or disband formation.
    TaskResult stopUnits(in sequence<UnitID> unit_ids);
  };
};
