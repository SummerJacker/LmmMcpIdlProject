// ============================================================
// MCP-IDL: MCP Swarm Task Interface Definition Language
// 大模型 ↔ MCP Server ↔ Console 的任务级接口契约
//
// 版本: 1.0
// 职责: 定义大模型可调用的任务级能力接口，不定义底层如何执行
// 原则: 先定义契约，再写代码；契约即文档；契约即测试标准
// ============================================================

module MCP_Swarm_Task {

  // ==========================================================
  // 基础类型定义
  // ==========================================================

  typedef string UnitID;       // 智能体标识，如 "GV1"、"AV1"
  typedef string TaskID;       // 任务唯一标识 (UUID v4)

  // ==========================================================
  // 任务状态机
  //
  // PENDING ──→ RUNNING ──→ COMPLETED
  //                │    ╰──→ PARTIAL_COMPLETED
  //                │    ╰──→ FAILED
  //                │    ╰──→ TIMEOUT
  //                │    ╰──→ CANCELLED
  //                ╰── REJECTED (入口校验不通过)
  // ==========================================================

  enum TaskState {
    PENDING,              // 任务已创建，等待执行
    RUNNING,              // 任务执行中
    COMPLETED,            // 全部单元成功
    FAILED,               // 全部单元失败
    PARTIAL_COMPLETED,    // 部分单元成功，部分失败
    TIMEOUT,              // 执行超时
    CANCELLED,            // 被用户取消
    REJECTED              // 被安全校验拒绝
  };

  // ==========================================================
  // 数据结构
  // ==========================================================

  struct Pose2D {
    float x;              // x 坐标 (米)
    float y;              // y 坐标 (米)
    float yaw;            // 朝向角 (弧度)，不关心时填 0.0
  };

  enum FormationType {
    LINE,                 // 直线编队
    TRIANGLE,             // 正三角形编队
    COLUMN,               // 纵队
    WEDGE                 // 楔形 (预留)
  };

  // 编队请求 —— 只接受语义化参数，不对大模型暴露底层实现细节
  struct FormationRequest {
    FormationType formation_type;       // 编队类型
    sequence<UnitID> unit_ids;          // 参与单元 (空 = 自动选择全部可用地面单元)
    float spacing_m;                    // 间距 (米)
    Pose2D anchor;                      // 锚点 (可选，空 = 以当前位姿自动计算)
    float heading_rad;                  // 编队朝向 (可选，空 = 以 leader 朝向为准)
  };

  // 单个单元的任务结果
  struct UnitTaskResult {
    UnitID unit_id;
    TaskState state;
    float progress_pct;                 // 0.0 ~ 100.0
    string message;                     // 人类可读的状态描述
    string error_code;                  // 空 = 无错误，否则为 ErrorCode 常量
  };

  // 整体任务结果
  struct TaskResult {
    boolean success;                    // 整体是否成功
    TaskID task_id;
    string task_type;                   // "goto_pose" | "goto_pose_batch" | "execute_formation"
    TaskState state;
    float progress_pct;
    string message;
    string error_code;
    sequence<UnitTaskResult> unit_results;  // 每个单元的子结果
    unsigned long elapsed_ms;
    unsigned long started_at_ms;
  };

  // ==========================================================
  // 统一错误码
  // 大模型可以根据 error_code 决定下一步行为
  // ==========================================================

  const string ERR_OK                    = "";
  const string ERR_UNIT_NOT_FOUND        = "UNIT_NOT_FOUND";
  const string ERR_UNIT_OFFLINE          = "UNIT_OFFLINE";
  const string ERR_UNIT_BUSY             = "UNIT_BUSY";
  const string ERR_TARGET_OUT_OF_BOUNDS  = "TARGET_OUT_OF_BOUNDS";
  const string ERR_TARGET_IN_NOGO_ZONE   = "TARGET_IN_NOGO_ZONE";
  const string ERR_SPEED_OUT_OF_BOUNDS   = "SPEED_OUT_OF_BOUNDS";
  const string ERR_DISTANCE_TOO_FAR      = "DISTANCE_TOO_FAR";
  const string ERR_LOW_BATTERY           = "LOW_BATTERY";
  const string ERR_TASK_NOT_FOUND        = "TASK_NOT_FOUND";
  const string ERR_TASK_ALREADY_CANCELLED = "TASK_ALREADY_CANCELLED";
  const string ERR_SAFETY_REJECTED       = "SAFETY_REJECTED";
  const string ERR_INTERNAL_ERROR        = "INTERNAL_ERROR";
  const string ERR_RPC_DISABLED          = "RPC_DISABLED";

  // ==========================================================
  // MCP Swarm Task Control Interface
  // 大模型可调用的全部任务级接口
  // ==========================================================

  interface SwarmTaskControl {

    // ----------------------------------------------------------
    // 导航类任务
    // ----------------------------------------------------------

    /// 令单个智能体自主导航到目标点位
    /// 返回 task_id，大模型轮询 getTaskStatus 获取进度
    /// 安全约束: 目标必须在允许区域内、距离不超过 100m、速度不超过上限
    TaskResult gotoPose(
      in UnitID unit_id,              // 智能体标识 (如 "GV1")
      in Pose2D target,               // 目标位姿
      in float tolerance_m,           // 到达容差 (默认 0.15m，最小 0.02m)
      in unsigned long timeout_ms     // 超时 (默认 30000ms)
    );

    /// 多智能体并发导航到各自目标点
    /// 所有目标一次性校验，任一失败即整体 REJECTED
    /// 各单元独立执行，全部到达后返回 COMPLETED 或 PARTIAL_COMPLETED
    TaskResult gotoPoseBatch(
      in sequence<UnitID> unit_ids,       // 与 targets 一一对应
      in sequence<Pose2D> targets,        // 每个单元的目标位姿
      in float tolerance_m,
      in unsigned long timeout_ms
    );

    // ----------------------------------------------------------
    // 编队类任务
    // ----------------------------------------------------------

    /// 执行编队任务
    /// 内部流程: 规划目标点 → 并发导航 → (可选)建立编队关系
    /// 大模型只需指定 formation_type + spacing_m，无需理解底层参数
    TaskResult executeFormation(
      in FormationRequest request
    );

    // ----------------------------------------------------------
    // 任务管理
    // ----------------------------------------------------------

    /// 查询任务进度，包含每个 unit 的子状态
    /// 大模型应轮询此接口直到 state ∈ {COMPLETED, FAILED, CANCELLED, TIMEOUT}
    TaskResult getTaskStatus(
      in TaskID task_id
    );

    /// 取消运行中的任务
    /// 所有相关智能体立即停止，任务状态变为 CANCELLED
    /// 已完成的不可取消 (返回 ERR_TASK_ALREADY_CANCELLED)
    TaskResult cancelTask(
      in TaskID task_id
    );
  };
};
