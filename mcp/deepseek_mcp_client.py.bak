def parse_args() -> argparse.Namespace:
    """
    解析命令行参数。

    @returns: argparse.Namespace
    """

    parser = argparse.ArgumentParser(description="DeepSeek-powered MCP client for firstmcp demo.")
    parser.add_argument("--server-spec", default="main.py", help="MCP server spec for fastmcp call, default: main.py")
    parser.add_argument(
        "--model",
        default="deepseek-ai/DeepSeek-V3.2",
        help="SiliconFlow model name, default: deepseek-ai/DeepSeek-V3.2",
    )
    parser.add_argument(
        "--api-key-env",
        default="DEEPSEEK_API_KEY",
        help="Environment variable name for DeepSeek API key, default: DEEPSEEK_API_KEY",
    )
    parser.add_argument(
        "--llm-connect-timeout-s",
        type=float,
        default=10.0,
        help="LLM HTTP connect timeout in seconds; <=0 disables connect timeout (default: 10)",
    )
    parser.add_argument(
        "--llm-read-timeout-s",
        type=float,
        default=0.0,
        help="LLM HTTP read timeout in seconds; <=0 disables read timeout for long reasoning (default: 0)",
    )
    parser.add_argument(
        "--action-wait-mode",
        choices=["none", "auto"],
        default="auto",
        help="Post-action wait strategy: auto waits for move duration and syncs fleet status, none disables waiting",
    )
    parser.add_argument(
        "--action-settle-extra-ms",
        type=int,
        default=300,
        help="Extra settle time after action command (ms), default: 300",
    )
    parser.add_argument(
        "--action-sync-timeout-ms",
        type=int,
        default=2000,
        help="Timeout for post-action status sync polling (ms), default: 2000",
    )
    parser.add_argument(
        "--action-sync-poll-ms",
        type=int,
        default=200,
        help="Poll interval for post-action status sync (ms), default: 200",
    )
    parser.add_argument(
        "--action-stable-pos-delta-m",
        type=float,
        default=0.01,
        help="Stable check position delta threshold (m) between polls, default: 0.01",
    )
    parser.add_argument(
        "--action-stable-yaw-delta-rad",
        type=float,
        default=0.03,
        help="Stable check yaw delta threshold (rad) between polls, default: 0.03",
    )
    parser.add_argument(
        "--action-stable-linear-speed-mps",
