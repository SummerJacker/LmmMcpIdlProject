        help="Disable post-run metric verification and automatic follow-up scheduling",
    )
    return parser.parse_args()


def build_system_prompt() -> str:
    """
    构建 LLM 系统提示词，强制结构化 JSON 输出。

    @returns: 系统提示词
    """

    alias_lines: list[str] = []
    for cfg in load_robot_configs(str(MCP_PROJECT_ROOT / "robots.json")):
        alias_lines.append(
            f"  - robot_id={cfg.robot_id!r} <-> unit_id={cfg.unit_id!r} (tools accept either as robot_id)"
        )
    alias_block = "\n".join(alias_lines) if alias_lines else "  (no robots.json entries; use list_robots)"

    return (
        "You are a tool planner for an MCP robot server connected to a Qt console (SAU) via HTTP.\n\n"
        "Core objective:\n"
        "- Focus on selecting robots and target points.\n"
        "- Prefer computing motion parameters from tools, not manual velocity guessing.\n\n"
        "Available tools:\n"
        "1) list_robots()\n"
        "2) get_robot_status(robot_id)\n"
        "3) get_fleet_status(robot_ids_csv=\"\")\n"
        "4) compute_relative_pose(robot_from, robot_to)\n"
        "5) compute_remaining_distance(robot_a, robot_b, target_distance_m=1.0)\n"
        "6) compute_navigation_hint(robot_id, target_x, target_y, max_linear_m_s=0.2, max_angular_rad_s=0.6)\n"
        "7) plan_line_targets(robot_ids_csv=\"\", spacing_m=1.0)\n"
        "8) send_move(robot_id, linear_velocity, angular_velocity, duration_ms=1000)\n"
        "9) stop_robot(robot_id)\n"
        "10) emergency_stop_all()\n\n"
        "Robot alias table (robot_id <-> unit_id):\n"
        f"{alias_block}\n\n"
        "Output rules:\n"
        "- Output JSON only, no markdown.\n"
        "- Preferred format: {\"phases\":[{\"name\":\"...\",\"steps\":[{\"tool\":\"...\",\"args\":{...}}]}]}.\n"
        "- Backward compatible: {\"steps\":[...]} or {\"tool\":\"...\",\"args\":{...}}.\n"
        "- Tool name must be one of SUPPORTED_TOOLS.\n\n"
        "Mandatory control loop (keep this order):\n"
        "1) Clarify task and pick robots/targets.\n"
        "2) list_robots when robot identity is ambiguous.\n"
        "3) Observe states via get_fleet_status/get_robot_status (must include pose yaw and speed).\n"
        "   For single-robot movement, still call get_fleet_status first to keep global situational awareness.\n"
        "4) Validate observation data; if invalid, re-observe instead of moving.\n"
        "5) Compute geometry via compute_relative_pose / compute_remaining_distance / compute_navigation_hint.\n"
        "6) Decide strategy from computed values.\n"
        "7) Act via send_move/stop_robot (prefer single-robot micro-cycle).\n"
        "8) Verify by get_robot_status/get_fleet_status and repeat loop until converging.\n\n"
        "Parameter binding rule (distance task):\n"
        "- In compute_remaining_distance(robot_a, robot_b, target_distance_m), robot_a MUST be the mover.\n"
        "- robot_b is the reference robot that should stay fixed in this micro-cycle.\n"
        "- If user says 'move GV3 to be 1m from GV2', call robot_a=GV3, robot_b=GV2.\n\n"
        "Motion policy:\n"
        "- For point navigation, prefer compute_navigation_hint then use its suggested rotate/move parameters.\n"
        "- Prefer turn-then-move micro-cycles; do not skip yaw alignment reasoning.\n"
        "- Keep final target stable; do not drift target_x/target_y unless user intent explicitly changes stage goal.\n"
        "- Do not invent complex velocity profiles when a target point + navigation hint is enough.\n\n"
        "Multi-robot policy:\n"
        "- If robots share the same pose, first break symmetry by assigning different target points.\n"
        "- Use plan_line_targets for line formation target assignment.\n"
        "- Avoid identical send_move parameters to colocated robots.\n"
        "- Prefer moving one robot then verify, unless emergency stop.\n\n"
        "ID policy:\n"
        "- Prefer unit_id strings returned by list_robots/get_fleet_status (e.g., GV1).\n"
        "- If user says GV*, pass GV* directly (or mapped alias from table).\n\n"
        "Safety / tool rejection (must honor and relay to the user):\n"
        f"- send_move returns success=false with message containing speed_out_of_bounds when "
        f"|linear_velocity|>{LINEAR_VELOCITY_MAX_ABS_M_S} m/s or "
        f"|angular_velocity|>{ANGULAR_VELOCITY_MAX_ABS_RAD_S} rad/s (MCP adapter; console HTTP mirrors this).\n"
        "- send_move returns success=false with message containing unit_not_bound when robot_id is not in "
        "robots.json and is not a configured unit_id.\n"
        "- When the user specifies a concrete speed and robot label (e.g. a vehicle number), do NOT stop with "
        "list_robots-only clarification phases: include send_move using the user's literal robot_id and "
        "requested linear_velocity/angular_velocity so the tool returns the definitive error JSON; in follow-up "
        "turns, set done=true with reason quoting that tool message if execution already surfaced the failure.\n"
    )


def build_llm_request_timeout(
    *,
    connect_timeout_s: float,
    read_timeout_s: float,
) -> float | tuple[float | None, float | None] | None:
    """
    构造 requests.post 的 timeout 参数（支持关闭读超时）。

    @param connect_timeout_s: 连接超时秒数；<=0 视为不限制
    @param read_timeout_s: 读取超时秒数；<=0 视为不限制
    @returns: requests 可接受的 timeout 值（None/float/tuple）
    """

    c = float(connect_timeout_s)
    r = float(read_timeout_s)
    c_val: float | None = c if c > 0 else None
    r_val: float | None = r if r > 0 else None
    if c_val is None and r_val is None:
        return None
    if c_val is None and r_val is not None:
        return r_val
    return (c_val, r_val)


def call_deepseek_json(
    *,
    api_key: str,
    model: str,
    system_prompt: str,
    user_text: str,
    connect_timeout_s: float = 10.0,
    read_timeout_s: float = 0.0,
) -> dict[str, Any]:
    """
    调用 SiliconFlow 并返回 JSON 对象（不做工具级 schema 校验）。

    @param api_key: SiliconFlow API Key
    @param model: 模型名
    @param system_prompt: 系统提示词
    @param user_text: 用户输入或重规划输入
    @param connect_timeout_s: HTTP 连接超时（秒）
    @param read_timeout_s: HTTP 读取超时（秒）
    @returns: 解析后的 JSON dict
    @throws RuntimeError: API 失败或输出非 JSON
    """

    payload = {
        "model": model,
        "messages": [
            {"role": "system", "content": system_prompt},
            {"role": "user", "content": user_text},
        ],
        "temperature": 0,
    }
    headers = {"Authorization": f"Bearer {api_key}", "Content-Type": "application/json"}
    timeout_cfg = build_llm_request_timeout(
        connect_timeout_s=connect_timeout_s,
        read_timeout_s=read_timeout_s,
    )
    resp = requests.post(SILICONFLOW_CHAT_COMPLETIONS_URL, headers=headers, json=payload, timeout=timeout_cfg)
    if resp.status_code >= 400:
        raise RuntimeError(f"SiliconFlow API error {resp.status_code}: {resp.text}")

    data = resp.json()
    content = data["choices"][0]["message"]["content"]
    content_trim = content.strip()
    if content_trim.startswith("```"):
        m = re.search(r"```(?:json)?\s*([\s\S]*?)\s*```", content_trim, flags=re.IGNORECASE)
        if m:
            content_trim = m.group(1).strip()
    if content_trim and content_trim[0] not in "{[":
        first_obj = content_trim.find("{")
        first_arr = content_trim.find("[")
        cand = [i for i in (first_obj, first_arr) if i >= 0]
        if cand:
            content_trim = content_trim[min(cand):]
    try:
        parsed = json.loads(content_trim)
    except json.JSONDecodeError as e:
        raise RuntimeError(f"LLM output is not valid JSON: {content}") from e
    if not isinstance(parsed, dict):
        raise RuntimeError(f"LLM output is not a JSON object: {parsed}")
    return parsed


def call_deepseek(
    *,
    api_key: str,
    model: str,
    user_text: str,
    connect_timeout_s: float = 10.0,
    read_timeout_s: float = 0.0,
) -> dict[str, Any]:
    """
    调用 SiliconFlow（OpenAI 兼容）Chat Completions 获取工具计划结果。

    @param api_key: SiliconFlow API Key
    @param model: 模型名（例如 deepseek-ai/DeepSeek-V3.2）
    @param user_text: 用户自然语言输入
    @param connect_timeout_s: HTTP 连接超时（秒），<=0 不限制
    @param read_timeout_s: HTTP 读取超时（秒），<=0 不限制
    @returns: 解析后的 JSON dict，支持 {"tool","args"} 或 {"steps":[...]}
    @throws RuntimeError: 当 API 调用失败或输出不可解析
    """

    parsed = call_deepseek_json(
        api_key=api_key,
        model=model,
        system_prompt=build_system_prompt(),
        user_text=user_text,
        connect_timeout_s=connect_timeout_s,
        read_timeout_s=read_timeout_s,
    )

    if isinstance(parsed.get("steps"), list):
        for i, step in enumerate(parsed["steps"]):
            if not isinstance(step, dict):
                raise RuntimeError(f"Invalid step at index {i}: {step}")
            tool = step.get("tool")
            args = step.get("args")
            if args is None:
                args = {}
            if tool not in SUPPORTED_TOOLS or not isinstance(args, dict):
                raise RuntimeError(f"Invalid step at index {i}: {step}")
            step["args"] = args
    elif isinstance(parsed.get("phases"), list):
        for pi, phase in enumerate(parsed["phases"]):
            if not isinstance(phase, dict):
                raise RuntimeError(f"Invalid phase at index {pi}: {phase}")
            steps = phase.get("steps")
            if not isinstance(steps, list):
                raise RuntimeError(f"Invalid phase steps at index {pi}: {phase}")
            for si, step in enumerate(steps):
                if not isinstance(step, dict):
                    raise RuntimeError(f"Invalid step at phase {pi} index {si}: {step}")
                tool = step.get("tool")
                args = step.get("args")
                if args is None:
                    args = {}
                if tool not in SUPPORTED_TOOLS or not isinstance(args, dict):
                    raise RuntimeError(f"Invalid step at phase {pi} index {si}: {step}")
                step["args"] = args
    elif "done" in parsed:
        done_raw = parsed.get("done")
        done_ok = isinstance(done_raw, bool) or (isinstance(done_raw, str) and done_raw.strip().lower() in {"true", "false"})
        if not done_ok:
            raise RuntimeError(f"Invalid done flag from LLM: {parsed}")
    else:
        tool = parsed.get("tool")
        args = parsed.get("args")
        if args is None:
            args = {}
        if tool not in SUPPORTED_TOOLS or not isinstance(args, dict):
            raise RuntimeError(f"Invalid tool plan from LLM: {parsed}")
        parsed["args"] = args
    return parsed


def normalize_plan_steps(plan: dict[str, Any]) -> list[dict[str, Any]]:
    """
    将 LLM 输出统一规范为步骤列表，支持单步与多步计划。

    @param plan: LLM 返回的 JSON 对象
    @returns: 形如 [{"tool": "...", "args": {...}}, ...] 的步骤列表
    @throws RuntimeError: 当结构非法、工具名非法或参数不是对象
    """

    if isinstance(plan.get("steps"), list):
        raw_steps = plan["steps"]
    else:
        raw_steps = [plan]

    steps: list[dict[str, Any]] = []
    for i, item in enumerate(raw_steps):
        if not isinstance(item, dict):
            raise RuntimeError(f"Invalid step at index {i}: not an object")
        tool = item.get("tool")
        args = item.get("args")
        if args is None:
            args = {}
        if tool not in SUPPORTED_TOOLS or not isinstance(args, dict):
            raise RuntimeError(f"Invalid step at index {i}: {item}")
        steps.append({"tool": tool, "args": args})
    if not steps:
        raise RuntimeError(f"Empty steps from LLM: {plan}")
    return steps


def normalize_plan_phases(plan: dict[str, Any]) -> list[dict[str, Any]]:
    """
    将 LLM 输出规范为阶段列表，统一执行路径，便于扩展多机器人多阶段编排。

    @param plan: LLM 输出 JSON
    @returns: [{"name": "...", "steps": [{"tool": "...", "args": {...}}]}]
    """

    if isinstance(plan.get("phases"), list):
        phases: list[dict[str, Any]] = []
        for idx, p in enumerate(plan["phases"]):
            if not isinstance(p, dict):
                raise RuntimeError(f"Invalid phase at index {idx}: {p}")
            name = str(p.get("name", f"phase_{idx + 1}"))
            steps = normalize_plan_steps({"steps": p.get("steps", [])})
            phases.append({"name": name, "steps": steps})
        if not phases:
            raise RuntimeError(f"Empty phases from LLM: {plan}")
        return _ensure_single_robot_phase_starts_with_fleet_observe(phases)
    return _ensure_single_robot_phase_starts_with_fleet_observe(
        [{"name": "phase_1", "steps": normalize_plan_steps(plan)}]
    )


def _ensure_single_robot_phase_starts_with_fleet_observe(
    phases: list[dict[str, Any]],
) -> list[dict[str, Any]]:
    """
    对单机器人动作阶段强制补齐全队观测（get_fleet_status）。

    规则：
    - 若某 phase 包含动作工具，且该 phase 仅涉及 1 台机器人动作，
      则在该 phase 第一个动作前必须有 get_fleet_status；
    - 对同一 phase 内连续动作，要求“每个动作后到下一动作前”至少一次 get_fleet_status；
    - 若缺失则自动注入 get_fleet_status(robot_ids_csv="")。

    @param phases: 规范化阶段列表
    @returns: 注入后的阶段列表（原地安全复制）
    """

    patched: list[dict[str, Any]] = []
    for ph in phases:
        name = str(ph.get("name", "phase"))
        src_steps = ph.get("steps") or []
        steps = [dict(s) for s in src_steps if isinstance(s, dict)]
        action_idx: list[int] = []
        action_ids: set[str] = set()
        for idx, st in enumerate(steps):
            tool = str(st.get("tool", "")).strip()
            if tool in ACTION_TOOLS:
                action_idx.append(idx)
                if tool in {"send_move", "stop_robot"}:
                    rid = str((st.get("args") or {}).get("robot_id", "")).strip().upper()
                    if rid:
                        action_ids.add(rid)
        if action_idx and len(action_ids) == 1:
            first = action_idx[0]
            pre_steps = steps[:first]
            has_fleet_obs = any(str(s.get("tool", "")).strip() == "get_fleet_status" for s in pre_steps)
            if not has_fleet_obs:
                steps.insert(first, {"tool": "get_fleet_status", "args": {"robot_ids_csv": ""}})
                logger.info("enforce single-robot global observe: injected get_fleet_status before first action")
            i = 0
            while i < len(steps):
                tool_i = str((steps[i] or {}).get("tool", "")).strip()
                if tool_i not in ACTION_TOOLS:
                    i += 1
                    continue
                j = i + 1
                has_mid_fleet_obs = False
                while j < len(steps):
                    tool_j = str((steps[j] or {}).get("tool", "")).strip()
                    if tool_j in ACTION_TOOLS:
                        break
                    if tool_j == "get_fleet_status":
                        has_mid_fleet_obs = True
                    j += 1
                if j < len(steps) and not has_mid_fleet_obs:
                    steps.insert(i + 1, {"tool": "get_fleet_status", "args": {"robot_ids_csv": ""}})
                    logger.info("enforce single-robot micro-loop: injected get_fleet_status between actions")
                    i += 2
                    continue
                i += 1
        patched.append({"name": name, "steps": steps})
    return patched


def compact_step_sequence(steps: list[dict[str, Any]]) -> str:
    """
    将步骤列表压缩为单行指令序列，便于查看 LLM 生成的执行链路。

    @param steps: 标准化后的步骤列表
    @returns: 形如 "get_robot_status(robot_id=GV1) -> send_move(...)" 的单行文本
    """

    parts: list[str] = []
    for step in steps:
        tool = str(step.get("tool", ""))
        args = step.get("args") or {}
        if isinstance(args, dict) and args:
            arg_txt = ",".join([f"{k}={v}" for k, v in args.items()])
            parts.append(f"{tool}({arg_txt})")
        else:
            parts.append(f"{tool}()")
    return " -> ".join(parts)


def has_action_step(steps: list[dict[str, Any]]) -> bool:
    """@param steps: 标准化步骤 @returns: 是否包含动作工具"""

    return any(s.get("tool") in ACTION_TOOLS for s in steps)


def has_action_in_phases(phases: list[dict[str, Any]]) -> bool:
    """@param phases: 规划阶段 @returns: 是否任一阶段包含动作工具"""

    for phase in phases:
        if has_action_step(phase.get("steps") or []):
            return True
    return False


def audit_phases_control_loop_structure(phases: list[dict[str, Any]]) -> list[str]:
    """
    审计非模板规划是否遵循“观测→决策→计算→移动→复核”的基本闭环结构。

    规则（面向 LLM 自由规划）：
    1) 每个动作段前必须存在观测/计算步骤；
    2) 动作段后到下一动作段前必须存在复核步骤；
    3) 同一动作段不应同时移动多台机器人（避免并发耦合失稳）。

    @param phases: normalize_plan_phases 输出
    @returns: 违规问题列表；空表示通过
    """

    issues: list[str] = []
    flat_steps: list[dict[str, Any]] = [s for p in phases for s in (p.get("steps") or [])]
    if not flat_steps:
        return issues
    action_idxs = [i for i, s in enumerate(flat_steps) if s.get("tool") in ACTION_TOOLS]
    if not action_idxs:
        return issues

    obs_tools = READ_ONLY_TOOLS
    segment_start = 0
    k = 0
    n = len(action_idxs)
    while k < n:
        i = action_idxs[k]
        pre = flat_steps[segment_start:i]
        if not any(str(s.get("tool", "")) in obs_tools for s in pre):
            issues.append("control-loop: action step has no observation/computation before it.")

        # 连续动作段 [i, j]（中间无非动作）
        j = i
        action_ids: list[str] = []
        while k < n and action_idxs[k] == j:
            st = flat_steps[j]
            if st.get("tool") == "send_move":
                rid = str((st.get("args") or {}).get("robot_id", "")).strip()
                if rid:
                    action_ids.append(rid)
            k += 1
            j += 1
            if k >= n or action_idxs[k] != j:
                break

        uniq_ids = sorted({x.upper() for x in action_ids})
        if len(uniq_ids) > 1:
            issues.append(
                f"control-loop: consecutive action segment moves multiple robots {uniq_ids}; "
                "move one robot then verify before moving next."
            )

        next_action_idx = action_idxs[k] if k < n else len(flat_steps)
        post = flat_steps[j:next_action_idx]
        if not any(str(s.get("tool", "")) in obs_tools for s in post):
            issues.append("control-loop: action step has no verification before next action.")
        segment_start = j

    return issues


def send_move_signature(args: dict[str, Any]) -> tuple[float, float, int]:
    """
    将 send_move 的运动参数规范为可比较的三元组（避免浮点抖动）。

    @param args: 工具参数字典
    @returns: (linear_velocity, angular_velocity, duration_ms)
    """

    lv = float(args.get("linear_velocity", 0.0))
    av = float(args.get("angular_velocity", 0.0))
    dur = int(args.get("duration_ms", 1000))
    return (round(lv, 6), round(av, 6), dur)


def fleet_poses_from_mcp_result(mcp_result: dict[str, Any]) -> dict[str, tuple[float, float, float]]:
    """
    从 get_fleet_status 的 MCP 返回中解析各 robot_id / unit_id 对应的 (x, y, yaw_rad)。

    @param mcp_result: run_mcp_call / LocalToolRunner 返回体
    @returns: 键为 robot_id_input 或 unit_id，值为位姿三元组
    """

    raw = extract_tool_json_string(mcp_result)
    if not raw:
        return {}
    try:
        outer = json.loads(raw)
    except json.JSONDecodeError:
        return {}
    if not outer.get("success"):
        return {}
    data = outer.get("data") or {}
    items = data.get("items") or []
    out: dict[str, tuple[float, float, float]] = {}
    for it in items:
        if not isinstance(it, dict) or not it.get("success"):
            continue
        inner = it.get("data") or {}
        pose = inner.get("pose") or {}
        x = float(pose.get("x", 0.0))
        y = float(pose.get("y", 0.0))
        yaw = float(pose.get("yaw", 0.0))
        triple = (x, y, yaw)
        rid_in = it.get("robot_id_input")
        if rid_in:
            out[str(rid_in)] = triple
        uid = inner.get("unit_id")
        if uid:
            out[str(uid)] = triple
    return out


def fleet_states_from_mcp_result(mcp_result: dict[str, Any]) -> dict[str, dict[str, float]]:
    """
    从 get_fleet_status 的 MCP 返回中解析位姿与速度状态。

    @param mcp_result: run_mcp_call / LocalToolRunner 返回体
    @returns: 键为 robot_id_input 或 unit_id，值含 x/y/yaw/linear_m_s/angular_rad_s
    """

    raw = extract_tool_json_string(mcp_result)
    if not raw:
        return {}
    try:
        outer = json.loads(raw)
    except json.JSONDecodeError:
        return {}
    if not outer.get("success"):
        return {}
    data = outer.get("data") or {}
    items = data.get("items") or []
    out: dict[str, dict[str, float]] = {}
    for it in items:
        if not isinstance(it, dict) or not it.get("success"):
            continue
        inner = it.get("data") or {}
        pose = inner.get("pose") or {}
        speed = inner.get("speed") or {}
        state = {
            "x": float(pose.get("x", 0.0)),
            "y": float(pose.get("y", 0.0)),
            "yaw": float(pose.get("yaw", 0.0)),
            "linear_m_s": float(speed.get("linear_m_s", 0.0)),
            "angular_rad_s": float(speed.get("angular_rad_s", 0.0)),
        }
        rid_in = it.get("robot_id_input")
        if rid_in:
            out[str(rid_in)] = dict(state)
        uid = inner.get("unit_id")
        if uid:
            out[str(uid)] = dict(state)
    return out


def is_robot_state_stable(
    prev_state: dict[str, float],
    curr_state: dict[str, float],
    *,
    pos_delta_tol_m: float,
    yaw_delta_tol_rad: float,
    linear_speed_tol_mps: float,
    angular_speed_tol_radps: float,
) -> bool:
    """
    判定机器人在两次采样间是否稳定（位姿变化小 + 当前速度小）。

    @param prev_state: 上一帧状态
    @param curr_state: 当前帧状态
    @param pos_delta_tol_m: 平面位移阈值
    @param yaw_delta_tol_rad: 航向变化阈值
    @param linear_speed_tol_mps: 线速度阈值
    @param angular_speed_tol_radps: 角速度阈值
    @returns: 是否满足双条件判稳
    """

    dx = float(curr_state.get("x", 0.0)) - float(prev_state.get("x", 0.0))
    dy = float(curr_state.get("y", 0.0)) - float(prev_state.get("y", 0.0))
    dpos = float(math.hypot(dx, dy))
    dyaw = abs(_normalize_angle(float(curr_state.get("yaw", 0.0)) - float(prev_state.get("yaw", 0.0))))
    lv = abs(float(curr_state.get("linear_m_s", 0.0)))
    av = abs(float(curr_state.get("angular_rad_s", 0.0)))
    return (
        dpos <= max(0.0, float(pos_delta_tol_m))
        and dyaw <= max(0.0, float(yaw_delta_tol_rad))
        and lv <= max(0.0, float(linear_speed_tol_mps))
        and av <= max(0.0, float(angular_speed_tol_radps))
    )


def is_robot_pose_quasi_stable(
    prev_state: dict[str, float],
    curr_state: dict[str, float],
    *,
    pos_delta_tol_m: float,
    yaw_delta_tol_rad: float,
) -> bool:
    """
    放宽判稳：仅看位姿变化（用于 stop 后的兜底判稳）。

    @param prev_state: 上一帧状态
    @param curr_state: 当前帧状态
    @param pos_delta_tol_m: 平面位移阈值
    @param yaw_delta_tol_rad: 航向变化阈值
    @returns: 位姿变化是否足够小
    """

    dx = float(curr_state.get("x", 0.0)) - float(prev_state.get("x", 0.0))
    dy = float(curr_state.get("y", 0.0)) - float(prev_state.get("y", 0.0))
    dpos = float(math.hypot(dx, dy))
    dyaw = abs(_normalize_angle(float(curr_state.get("yaw", 0.0)) - float(prev_state.get("yaw", 0.0))))
    return dpos <= max(0.0, float(pos_delta_tol_m)) and dyaw <= max(0.0, float(yaw_delta_tol_rad))


def _poses_all_coincident(
    triples: list[tuple[float, float, float]],
    *,
    pos_tol: float,
    yaw_tol: float,
) -> bool:
    """@param triples: 至少两个位姿 @returns: 是否两两在容差内视为同一点同朝向"""

    if len(triples) < 2:
        return False
    x0, y0, yw0 = triples[0]
    for x, y, yw in triples[1:]:
        if abs(x - x0) > pos_tol or abs(y - y0) > pos_tol:
            return False
        if abs(_normalize_angle(yw - yw0)) > yaw_tol:
            return False
    return True


def audit_phases_identical_send_move_when_colocated(
    phases: list[dict[str, Any]],
    run_tool: Callable[[str, dict[str, Any]], dict[str, Any]],
    *,
    pos_tol: float = 1e-6,
    yaw_tol: float = 1e-5,
) -> list[str]:
    """
    审计 LLM 计划：在**执行前**快照上，若计划中（跨所有 phase扁平化后）存在多车
    使用完全相同的 send_move(v, ω, T)，且 get_fleet_status 显示这些车当前位姿重合，
    则判定为退化规划（易叠车）。扁平化可避免模型把同构指令拆到两个 phase 绕过校验。

    @param phases: normalize_plan_phases 的输出
    @param run_tool: 同步工具调用 (tool_name, args) -> mcp_result
    @param pos_tol: 位置判定容差（米）
    @param yaw_tol: 朝向判定容差（弧度）
    @returns: 问题描述列表；非空时不应执行原计划
    """

    flat_steps: list[dict[str, Any]] = [s for p in phases for s in (p.get("steps") or [])]
    issues: list[str] = []
    groups: dict[tuple[float, float, int], list[str]] = {}
    for step in flat_steps:
        if step.get("tool") != "send_move":
            continue
        args = step.get("args") or {}
        if not isinstance(args, dict):
            continue
        rid = str(args.get("robot_id", "")).strip()
        if not rid:
            continue
        sig = send_move_signature(args)
        groups.setdefault(sig, []).append(rid)
    scope = "plan(all phases, pre-execution fleet snapshot)"
    for sig, rids in groups.items():
        uniq = sorted(set(rids))
        if len(uniq) < 2:
            continue
        csv = ",".join(uniq)
        try:
            res = run_tool("get_fleet_status", {"robot_ids_csv": csv})
        except Exception as e:
            issues.append(f"{scope}: identical send_move {sig} on robots {uniq} but fleet check failed: {e}")
            continue
        poses = fleet_poses_from_mcp_result(res)
        triples: list[tuple[float, float, float]] = []
        missing: list[str] = []
        for r in uniq:
            t = poses.get(r)
            if t is None:
                missing.append(r)
            else:
                triples.append(t)
        if missing:
            issues.append(f"{scope}: identical send_move {sig} on {uniq} but missing pose for ids {missing}")
            continue
        if _poses_all_coincident(triples, pos_tol=pos_tol, yaw_tol=yaw_tol):
            issues.append(
                f"{scope}: identical send_move(linear, angular, duration)={sig} for robots {uniq} "
                "while fleet_status reports the SAME pose — trajectories would stay stacked."
            )
    return issues


def build_plan_audit_replan_prompt(
    user_text: str,
    phases: list[dict[str, Any]],
    audit_issues: list[str],
) -> str:
    """
    构造计划审计失败后的 LLM 纠偏提示（结构化闭环 + 几何安全约束）。

    @param user_text: 用户原始自然语言
    @param phases: 被拒绝的计划
    @param audit_issues: 计划审计输出（几何退化 / 闭环结构违规）
    @returns: 作为 user 消息传给 call_deepseek 的全文
    """

    lines: list[str] = []
    lines.append("Plan validation FAILED before execution. Revise the plan; do NOT repeat this error.")
    lines.append("")
    lines.append("Detected issues:")
    for iss in audit_issues:
        lines.append(f"- {iss}")
    lines.append("")
    lines.append("Must follow:")
    lines.append("- Call list_robots and/or get_fleet_status first; use unit_id values exactly as returned.")
    lines.append("- Even for single-robot movement, include get_fleet_status in observation stage.")
    lines.append("- Enforce loop in each correction cycle: Observe -> Decide -> Compute -> Act -> Verify.")
    lines.append("- Before EACH action, include get_fleet_status/get_robot_status/compute_remaining_distance.")
    lines.append("- After EACH action, include verification tools before next action.")
    lines.append("- Move ONE robot per correction micro-cycle when possible; avoid coupled multi-robot actions.")
    lines.append(
        "- Never issue the same send_move(linear_velocity, angular_velocity, duration_ms) to different robot_id "
        "values if those robots currently share the same (x, y, yaw)."
    )
    lines.append("- Break symmetry: stagger durations, change angular_velocity first, move one robot at a time,")
    lines.append("  or use compute_remaining_distance repeatedly to close spacing along a line.")
    lines.append("")
    lines.append("Rejected plan (phases JSON):")
    lines.append(json.dumps(phases, ensure_ascii=False))
    lines.append("")
    lines.append(f"Original user request:\n{user_text}")
    lines.append("")
    lines.append('Output JSON only: revised {"phases":[{"name":"...","steps":[...]}]} with executable tools.')
    return "\n".join(lines)


def needs_action_from_user_intent(user_text: str) -> bool:
    """
    依据自然语言是否包含动作/编队意图，判断是否需要动作步骤。

    @param user_text: 用户输入
    @returns: True 表示应包含 send_move/stop 等动作
    """

    t = user_text.lower()
    keywords = [
        "移动",
        "前进",
        "后退",
        "转",
        "排成",
        "相距",
        "跟随",
        "靠近",
        "line",
        "formation",
        "move",
        "distance",
    ]
    return any(k in t for k in keywords)


def parse_distance_goal_request(user_text: str) -> tuple[str, str, float] | None:
    """
    从自然语言中提取“两个机器人 + 目标间距”意图。

    @param user_text: 用户输入
    @returns: (robot_a, robot_b, target_distance_m)；无法识别则返回 None
    """

    ids = re.findall(r"(?:GV|AV)\d+|robot_[A-Za-z0-9_]+", user_text, flags=re.IGNORECASE)
    if len(ids) < 2:
        return None
    nums = re.findall(r"(\d+(?:\.\d+)?)\s*m", user_text, flags=re.IGNORECASE)
    if not nums:
        nums = re.findall(r"(\d+(?:\.\d+)?)\s*米", user_text)
    target = float(nums[0]) if nums else 1.0
    return ids[0], ids[1], target


def parse_single_mover_distance_request(user_text: str) -> tuple[str, str, float] | None:
    """
    解析“单移动方 + 参照方 + 间距”的距离控制请求。

    示例：
    - 移动小车3，移动到距离小车2一米处
    - 将GV3移动到距离GV2 1m

    @param user_text: 用户输入
    @returns: (mover_robot_id, reference_robot_id, target_distance_m)；无法识别返回 None
    """

    def _norm_ref(token: str) -> str:
        """@param token: 文本机器人标识 @returns: 归一化引用"""

        t = token.strip()
        m_gv = re.fullmatch(r"(GV|AV)\s*(\d+)", t, flags=re.IGNORECASE)
        if m_gv:
            return f"{m_gv.group(1).upper()}{int(m_gv.group(2))}"
        m_robot = re.fullmatch(r"robot[_\s-]?(\d+)", t, flags=re.IGNORECASE)
        if m_robot:
            return f"robot_{int(m_robot.group(1))}"
        m_zh = re.fullmatch(r"(?:小车|机器人)\s*(\d+)", t)
        if m_zh:
            return f"GV{int(m_zh.group(1))}"
        m_no = re.fullmatch(r"(\d+)\s*号车", t)
        if m_no:
            return f"GV{int(m_no.group(1))}"
        return _normalize_robot_ref_from_text(t)

    t = user_text
    m_move = re.search(
        r"(?:移动|让|将|move)\s*"
        r"((?:GV|AV)\s*\d+|robot[_\s-]?\d+|robot_[A-Za-z0-9_]+|(?:小车|机器人)\s*\d+|\d+\s*号车)",
        t,
        flags=re.IGNORECASE,
    )
    m_ref = re.search(
        r"(?:距离|distance\s*from|from)\s*"
        r"((?:GV|AV)\s*\d+|robot[_\s-]?\d+|robot_[A-Za-z0-9_]+|(?:小车|机器人)\s*\d+|\d+\s*号车)",
        t,
        flags=re.IGNORECASE,
    )
    if not m_move or not m_ref:
        return None
    mover = _norm_ref(str(m_move.group(1)))
    ref = _norm_ref(str(m_ref.group(1)))
    if not mover or not ref or mover.upper() == ref.upper():
        return None
    nums = re.findall(r"(\d+(?:\.\d+)?)\s*m", t, flags=re.IGNORECASE)
    if not nums:
        nums = re.findall(r"(\d+(?:\.\d+)?)\s*米", t)
    target = float(nums[0]) if nums else 1.0
    return mover, ref, target


def infer_single_mover_target_with_llm(
    *,
    api_key: str,
    model: str,
    user_text: str,
    mover_robot_id: str,
    reference_robot_id: str,
    target_distance_m: float,
    fleet_snapshot_json: str,
    args: argparse.Namespace,
) -> tuple[float, float] | None:
    """
    让 LLM 基于全队状态快照决策“单移动方距离任务”的具体目标点。

    @param api_key: LLM API Key
    @param model: 模型名
    @param user_text: 用户原始自然语言
    @param mover_robot_id: 移动车
    @param reference_robot_id: 参照车
    @param target_distance_m: 目标距离
    @param fleet_snapshot_json: get_fleet_status 原始 JSON 字符串
    @param args: 客户端参数（超时配置）
    @returns: (target_x, target_y)；失败返回 None
    """

    sys_prompt = (
        "You are a target-point planner for a robot fleet.\n"
        "Given fleet status and a distance objective, output one concrete target point for mover robot.\n"
        "Output JSON only.\n"
        "Schema:\n"
        "{"
        "\"mover_robot_id\":\"...\","
        "\"reference_robot_id\":\"...\","
        "\"target_distance_m\":1.0,"
        "\"target_x\":0.0,"
        "\"target_y\":0.0,"
        "\"reason\":\"...\""
        "}\n"
        "Rules:\n"
        "- Keep mover_robot_id and reference_robot_id unchanged.\n"
        "- target point should satisfy distance to reference ~= target_distance_m.\n"
        "- Prefer a point requiring less mover displacement from current pose.\n"
        "- Do not output tool calls."
    )
    user_prompt = (
        f"User request:\n{user_text}\n\n"
        f"Mover: {mover_robot_id}\n"
        f"Reference: {reference_robot_id}\n"
        f"Target distance(m): {float(target_distance_m)}\n\n"
        "Latest fleet snapshot JSON:\n"
        f"{fleet_snapshot_json}\n\n"
        "Return JSON only."
    )
    try:
        obj = call_deepseek_json(
            api_key=api_key,
            model=model,
            system_prompt=sys_prompt,
            user_text=user_prompt,
            connect_timeout_s=float(args.llm_connect_timeout_s),
            read_timeout_s=float(args.llm_read_timeout_s),
        )
    except Exception as e:
        logger.warning("single_mover target llm failed: %s", e)
        return None
    tx = obj.get("target_x")
    ty = obj.get("target_y")
    if not isinstance(tx, (int, float)) or not isinstance(ty, (int, float)):
        logger.warning("single_mover target llm invalid target payload: %s", obj)
        return None
    return (float(tx), float(ty))


def infer_template_route_with_llm(
    *,
    api_key: str,
    model: str,
    user_text: str,
    fleet_snapshot_json: str,
    args: argparse.Namespace,
) -> dict[str, Any] | None:
    """
    让 LLM 基于自然语言与全队状态进行一次性模板路由决策。

    @param api_key: LLM API Key
    @param model: 模型名
    @param user_text: 用户原始自然语言
    @param fleet_snapshot_json: get_fleet_status 快照 JSON 文本
    @param args: 客户端参数（超时配置）
    @returns: {"template","params","reason"}；失败返回 None
    """

    sys_prompt = (
        "You are a template router for robot-control tasks.\n"
        "Choose exactly ONE template based on user request and current fleet state.\n"
        "Output JSON only.\n"
        "Allowed templates:\n"
        "- single_point\n"
        "- single_mover_distance\n"
        "- single_robot_route\n"
        "- complex_intent\n"
        "- llm_plan\n"
        "Schema:\n"
        "{"
        "\"template\":\"single_point|single_mover_distance|single_robot_route|complex_intent|llm_plan\","
        "\"params\":{},"
        "\"reason\":\"...\""
        "}\n"
        "Rules:\n"
        "- single_point params: {\"robot_id\":\"...\",\"target_x\":num,\"target_y\":num}\n"
        "- single_mover_distance params: {\"mover_robot_id\":\"...\",\"reference_robot_id\":\"...\",\"target_distance_m\":num}\n"
        "- single_robot_route params: {\"robot_id\":\"...\",\"waypoints\":[[x,y],...]}\n"
        "- For vague/complex multi-robot constraints choose complex_intent.\n"
        "- If no template is confident choose llm_plan."
    )
    user_prompt = (
        f"User request:\n{user_text}\n\n"
        "Latest fleet snapshot JSON:\n"
        f"{fleet_snapshot_json}\n\n"
        "Return JSON only."
    )
    try:
        obj = call_deepseek_json(
            api_key=api_key,
            model=model,
            system_prompt=sys_prompt,
            user_text=user_prompt,
            connect_timeout_s=float(args.llm_connect_timeout_s),
            read_timeout_s=float(args.llm_read_timeout_s),
        )
    except Exception as e:
        logger.warning("template router llm failed: %s", e)
        return None
    if not isinstance(obj, dict):
        return None
    tpl = str(obj.get("template", "")).strip()
    params = obj.get("params")
    reason = str(obj.get("reason", "")).strip()
    allowed = {"single_point", "single_mover_distance", "single_robot_route", "complex_intent", "llm_plan"}
    if tpl not in allowed:
        logger.warning("template router invalid template: %s", obj)
        return None
    if not isinstance(params, dict):
        params = {}
    return {"template": tpl, "params": params, "reason": reason}


_CN_VEHICLE_DIGIT: dict[str, int] = {
    "零": 0,
    "一": 1,
    "二": 2,
    "两": 2,
    "三": 3,
    "四": 4,
    "五": 5,
    "六": 6,
    "七": 7,
    "八": 8,
    "九": 9,
    "十": 10,
}


def _cn_vehicle_token_to_int(token: str) -> int | None:
    """
    将「七号」「十二」等车号用语转为非负整数（仅覆盖常见编队车号，不保证任意中文数字）。

    @param token: 号车前的中文或阿拉伯数字串
    @returns: 车号；无法解析时为 None
    """

    s = token.strip()
    if not s:
        return None
    if s.isdigit():
        return int(s)
    if len(s) == 1:
        return _CN_VEHICLE_DIGIT.get(s)
    if s == "十":
        return 10
    if s.startswith("十") and len(s) >= 2:
        tail = s[1:]
        u = _CN_VEHICLE_DIGIT.get(tail)
        if u is not None:
            return 10 + u
    if s.endswith("十") and len(s) >= 2:
        head = s[:-1]
        u = _CN_VEHICLE_DIGIT.get(head)
        if u is not None:
            return u * 10
    return None


def parse_explicit_linear_speed_m_s(user_text: str) -> float | None:
    """
    从自然语言中提取用户显式要求的线速度（m/s）；未写明则返回 None。

    @param user_text: 用户输入
    @returns: 速度 m/s 或 None
    """

    t = user_text.replace("／", "/")
    pats = (
        r"每秒\s*(\d+(?:\.\d+)?)\s*米",
        r"(\d+(?:\.\d+)?)\s*米\s*/\s*秒",
        r"(\d+(?:\.\d+)?)\s*m\s*/\s*s",
        r"(\d+(?:\.\d+)?)\s*米每秒",
    )
    for pat in pats:
        m = re.search(pat, t, flags=re.IGNORECASE)
        if m:
            try:
                return float(m.group(1))
            except ValueError:
                return None
    return None


def fleet_known_robot_keys_from_snapshot_json(fleet_snapshot_json: str) -> set[str]:
    """
    从 get_fleet_status 内层 JSON 文本收集当前快照中出现的 robot_id_input / unit_id。

    @param fleet_snapshot_json: 工具返回的结构化 JSON 字符串
    @returns: 标识集合（大小写保持原样）
    """

    try:
        outer = json.loads(fleet_snapshot_json)
    except json.JSONDecodeError:
        return set()
    if not outer.get("success"):
        return set()
    data = outer.get("data") or {}
    items = data.get("items") or []
    keys: set[str] = set()
    for it in items:
        if not isinstance(it, dict) or not it.get("success"):
            continue
        inner = it.get("data") or {}
        rid_in = it.get("robot_id_input")
        if rid_in:
            keys.add(str(rid_in))
        uid = inner.get("unit_id")
        if uid:
            keys.add(str(uid))
    return keys


def _fleet_snapshot_contains_robot(snapshot_keys: set[str], robot_id: str) -> bool:
    """
    @param snapshot_keys: fleet_known_robot_keys_from_snapshot_json 输出
    @param robot_id: 已部分规范化的车标识
    @returns: 快照中是否可解析到该车（含 robots.json 别名与大小写不敏感）
    """

    rid = robot_id.strip()
    if not rid:
        return False
    if rid in snapshot_keys:
        return True
    ru = rid.upper()
    for k in snapshot_keys:
        if k.upper() == ru:
            return True
    try:
        for cfg in load_robot_configs(str(MCP_PROJECT_ROOT / "robots.json")):
            candidates = {cfg.robot_id, cfg.unit_id}
            if rid in candidates or ru in {c.upper() for c in candidates}:
                if cfg.robot_id in snapshot_keys or cfg.unit_id in snapshot_keys:
                    return True
                for k in snapshot_keys:
                    if k.upper() == cfg.robot_id.upper() or k.upper() == cfg.unit_id.upper():
                        return True
    except Exception:
        pass
    return False


def _robot_numeric_pair(robot_id: str) -> tuple[int | None, int | None]:
    """
    @param robot_id: 车标识
    @returns: (GV/AV 编号, robot_N 编号)；无法解析的分量为 None
    """

    t = robot_id.strip()
    m = re.fullmatch(r"(GV|AV)(\d+)", t, flags=re.IGNORECASE)
    gvn: int | None = int(m.group(2)) if m else None
    m2 = re.fullmatch(r"robot_(\d+)", t, flags=re.IGNORECASE)
    rn: int | None = int(m2.group(1)) if m2 else None
    return gvn, rn


def _same_vehicle_alias(a: str, b: str) -> bool:
    """@param a: 车标识 @param b: 车标识 @returns: 是否视为同一逻辑车"""

    if a.strip().upper() == b.strip().upper():
        return True
    ga, ra = _robot_numeric_pair(_normalize_robot_ref_from_text(a))
    gb, rb = _robot_numeric_pair(_normalize_robot_ref_from_text(b))
    nums = [n for n in (ga, ra, gb, rb) if n is not None]
    if len(nums) >= 2 and len(set(nums)) == 1:
        return True
    if ga is not None and gb is not None and ga == gb:
        return True
    if ra is not None and rb is not None and ra == rb:
        return True
    if ga is not None and rb is not None and ga == rb:
        return True
    if ra is not None and gb is not None and ra == gb:
        return True
    return False


def collect_user_mentioned_vehicle_indices(user_text: str) -> set[int]:
    """
    从用户句中提取显式车号对应的数字编号（GVn / robot_n / n号车 等归一为同一整数）。

    @param user_text: 用户输入
    @returns: 车号集合；无显式车号时为空
    """

    mentions = collect_user_mentioned_vehicle_ids_normalized(user_text)
    nums: set[int] = set()
    for m in mentions:
        g, r = _robot_numeric_pair(_normalize_robot_ref_from_text(m))
        if g is not None:
            nums.add(int(g))
        if r is not None:
            nums.add(int(r))
    return nums


def fleet_snapshot_covers_vehicle_index(snapshot_keys: set[str], n: int) -> bool:
    """
    @param snapshot_keys: fleet_known_robot_keys_from_snapshot_json 结果
    @param n: 车号数字（与 GVn、robot_n 对齐）
    @returns: 快照中是否存在该车
    """

    for cand in (f"GV{n}", f"AV{n}", f"robot_{n}"):
        if _fleet_snapshot_contains_robot(snapshot_keys, cand):
            return True
    return False


def preflight_user_request_against_fleet(user_text: str, fleet_snapshot_json: str) -> str | None:
    """
    在模板路由 LLM 调用之前做确定性预检：显式超速、点名车辆不在当前 fleet 快照。

    与 MCP 工具返回的 `speed_out_of_bounds` / `unit_not_bound` 语义对齐，便于用户立即看到拒绝原因而无需再等路由或错误模板。

    @param user_text: 用户原始输入
    @param fleet_snapshot_json: get_fleet_status 内层 JSON 文本
    @returns: 若本轮应终止则返回已格式化的多行错误说明；通过预检则为 None
    """

    speed = parse_explicit_linear_speed_m_s(user_text)
    if speed is not None and speed > float(LINEAR_VELOCITY_MAX_ABS_M_S):
        return (
            "[REJECT] speed_out_of_bounds\n"
            f"  requested linear speed: {speed} m/s\n"
            f"  max_safe (MCP config): {LINEAR_VELOCITY_MAX_ABS_M_S} m/s\n"
            "  (stop here; no template router call. Lower speed or use send_move for tool-level JSON.)"
        )
    keys = fleet_known_robot_keys_from_snapshot_json(fleet_snapshot_json)
    nums = collect_user_mentioned_vehicle_indices(user_text)
    if not nums:
        return None
    missing = sorted(n for n in nums if not fleet_snapshot_covers_vehicle_index(keys, n))
    if missing:
        return (
            "[REJECT] unit_not_bound\n"
            f"  user referenced vehicle index(es): {missing}\n"
            "  not present in current get_fleet_status snapshot (Qt bind table).\n"
            "  (stop here; no template router call. Use list_robots IDs or bind units in console.)"
        )
    return None


def collect_user_mentioned_vehicle_ids_normalized(user_text: str) -> set[str]:
    """
    收集用户语句中显式点名的车辆标识（规范化后可能同时含 GVn 与 robot_n）。

    @param user_text: 用户输入
    @returns: 非空时点名为集合；无显式车号则为空集
    """

    out: set[str] = set()
    for m in re.finditer(r"(\d+)\s*号车", user_text):
        n = int(m.group(1))
        out.add(f"GV{n}")
        out.add(f"robot_{n}")
    for m in re.finditer(r"([零一二三四五六七八九十两]{1,3})\s*号车", user_text):
        val = _cn_vehicle_token_to_int(m.group(1))
        if val is not None:
            out.add(f"GV{val}")
            out.add(f"robot_{val}")
    for m in re.finditer(r"(?:小车|机器人)\s*(\d+)", user_text):
        n = int(m.group(1))
        out.add(f"GV{n}")
        out.add(f"robot_{n}")
    for m in re.finditer(r"(GV|AV)\s*(\d+)", user_text, flags=re.IGNORECASE):
        out.add(f"{m.group(1).upper()}{int(m.group(2))}")
    for m in re.finditer(r"robot[_\s-]?(\d+)", user_text, flags=re.IGNORECASE):
        out.add(f"robot_{int(m.group(1))}")
    return out


def validate_decomposed_point_tasks_before_execute(
    tasks: list[tuple[str, float, float]] | None,
    *,
    fleet_snapshot_json: str,
    user_text: str,
    log_label: str,
) -> list[tuple[str, float, float]] | None:
    """
    LLM 点位拆解执行前门禁：显式超速、fleet 存在性、用户点名与任务车一致性。

    @param tasks: infer_multi_robot_point_tasks_with_llm 输出
    @param fleet_snapshot_json: get_fleet_status JSON
    @param user_text: 原始用户句
    @param log_label: 日志/终端前缀说明
    @returns: 通过校验则原样返回 tasks；否则 None 并打印终止原因
    """

    if not tasks:
        return None
    speed = parse_explicit_linear_speed_m_s(user_text)
    if speed is not None and speed > float(LINEAR_VELOCITY_MAX_ABS_M_S):
        print(
            f"Planner> abort {log_label}: explicit speed {speed} m/s > max_safe "
            f"{LINEAR_VELOCITY_MAX_ABS_M_S} m/s; use full tool plan / send_move for tool-level refusal."
        )
        logger.warning("decomposed tasks rejected (%s): speed %s", log_label, speed)
        return None
    keys = fleet_known_robot_keys_from_snapshot_json(fleet_snapshot_json)
    missing_fleet = [rid for rid, _, _ in tasks if not _fleet_snapshot_contains_robot(keys, rid)]
    if missing_fleet:
        print(
            f"Planner> abort {log_label}: tasks reference robots not in fleet snapshot: {missing_fleet}. "
            "Fallback to full tool planner."
        )
        logger.warning("decomposed tasks rejected (%s): missing fleet %s", log_label, missing_fleet)
        return None
    mentions = collect_user_mentioned_vehicle_ids_normalized(user_text)
    if mentions:
        absent = [m for m in mentions if not _fleet_snapshot_contains_robot(keys, m)]
        if absent:
            print(
                f"Planner> abort {log_label}: user mentioned vehicles not in fleet: {absent}. "
                "Fallback to full tool planner."
            )
            logger.warning("decomposed tasks rejected (%s): user mentions absent %s", log_label, absent)
            return None
        task_ids = {rid for rid, _, _ in tasks}
        for m in mentions:
            if not any(_same_vehicle_alias(m, tid) for tid in task_ids):
                print(
                    f"Planner> abort {log_label}: user mentioned {m} but decomposed tasks target {sorted(task_ids)}. "
                    "Fallback to full tool planner."
                )
                logger.warning(
                    "decomposed tasks rejected (%s): mention %s not covered by tasks",
                    log_label,
                    m,
                )
                return None
    return tasks


def infer_multi_robot_point_tasks_with_llm(
    *,
    api_key: str,
    model: str,
    user_text: str,
    fleet_snapshot_json: str,
    args: argparse.Namespace,
) -> list[tuple[str, float, float]] | None:
    """
    让 LLM 将自然语言拆解为“每台车单独点位目标”列表。

    @param api_key: LLM API Key
    @param model: 模型名
    @param user_text: 用户原始自然语言
    @param fleet_snapshot_json: get_fleet_status 快照 JSON 文本
    @param args: 客户端参数（超时配置）
    @returns: [(robot_id, target_x, target_y), ...]；失败返回 None
    """

    sys_prompt = (
        "You are a decomposition planner for robot point-goal tasks.\n"
        "Convert user request into independent per-robot point targets.\n"
        "Output JSON only.\n"
        "Schema:\n"
        "{"
        "\"tasks\":[{\"robot_id\":\"...\",\"target_x\":0.0,\"target_y\":0.0}],"
        "\"reason\":\"...\""
        "}\n"
        "Rules:\n"
        "- Keep one task per robot.\n"
        "- Use robot ids from fleet snapshot when possible.\n"
        "- If user says origin/原点, use target (0,0).\n"
        "- If the user names a vehicle not present in the fleet snapshot, return \"tasks\":[] and explain in reason.\n"
        "- If the user requests explicit linear speed above safe demo limits, return \"tasks\":[] (non-point intent).\n"
        "- If the request is rush/speed-only with no point target, return \"tasks\":[].\n"
        "- Do not output tool calls."
    )
    user_prompt = (
        f"User request:\n{user_text}\n\n"
        "Latest fleet snapshot JSON:\n"
        f"{fleet_snapshot_json}\n\n"
        "Return JSON only."
    )
    try:
        obj = call_deepseek_json(
            api_key=api_key,
            model=model,
            system_prompt=sys_prompt,
            user_text=user_prompt,
            connect_timeout_s=float(args.llm_connect_timeout_s),
            read_timeout_s=float(args.llm_read_timeout_s),
        )
    except Exception as e:
        logger.warning("multi-point decomposition llm failed: %s", e)
        return None
    tasks_obj = obj.get("tasks") if isinstance(obj, dict) else None
    if not isinstance(tasks_obj, list):
        logger.warning("multi-point decomposition invalid tasks payload: %s", obj)
        return None
    if not tasks_obj:
        logger.info("multi-point decomposition returned empty tasks (likely non-point intent)")
        return None
    out: list[tuple[str, float, float]] = []
    seen: set[str] = set()
    for it in tasks_obj:
        if not isinstance(it, dict):
            continue
        rid_raw = str(it.get("robot_id", "")).strip()
        tx = it.get("target_x")
        ty = it.get("target_y")
        if not rid_raw or not isinstance(tx, (int, float)) or not isinstance(ty, (int, float)):
            continue
        rid = _normalize_robot_ref_from_text(rid_raw)
        rk = rid.upper()
        if not rid or rk in seen:
            continue
        seen.add(rk)
        out.append((rid, float(tx), float(ty)))
    return out if out else None


def execute_decomposed_single_point_tasks(
    *,
    tasks: list[tuple[str, float, float]],
    user_text: str,
    args: argparse.Namespace,
    api_key: str,
    model: str,
) -> None:
    """
    按“逐车单点模板”串行执行 LLM 拆解任务，并做一次几何验收/补动作。

    @param tasks: [(robot_id, target_x, target_y), ...]
    @param user_text: 用户原始输入
    @param args: 客户端参数
    @param api_key: LLM API Key
    @param model: 模型名
    """

    for rid_task, tx_task, ty_task in tasks:
        print(
            f"[INTENT_TARGETS] llm_decompose robot={rid_task} "
            f"target=({float(tx_task):.3f},{float(ty_task):.3f})"
        )
        run_closed_loop_point_template(
            args=args,
            robot_id=rid_task,
            target_x=float(tx_task),
            target_y=float(ty_task),
        )
        run_mcp_call(server_spec=args.server_spec, tool="stop_robot", args={"robot_id": rid_task})
    fres_mp = run_mcp_call(server_spec=args.server_spec, tool="get_fleet_status", args={"robot_ids_csv": ""})
    poses_mp = fleet_poses_from_mcp_result(fres_mp)
    cfg_path = str(MCP_PROJECT_ROOT / "robots.json")
    if len(tasks) == 1:
        rid1, tx1, ty1 = tasks[0]
        goal_mp = CompletionGoal(
            kind="point_goal",
            robot_ids=[rid1],
            target_m=0.0,
            target_points={rid1: (float(tx1), float(ty1))},
        )
    else:
        goal_mp = CompletionGoal(
            kind="multi_point",
            robot_ids=[rid for rid, _, _ in tasks],
            target_m=0.0,
            target_points={rid: (float(tx), float(ty)) for rid, tx, ty in tasks},
        )
    ok_mp, reason_mp, metrics_mp = verify_completion_goal(
        goal_mp,
        poses_mp,
        tol_m=float(args.closed_loop_tolerance_m),
        config_path=cfg_path,
    )
    if ok_mp:
        print(f"[VERIFY] multi-point 已达标: {reason_mp}")
        return
    if not args.no_completion_followup:
        print("[VERIFY] multi-point 未达标，触发一次性 LLM 验证/补动作。")
        once_prompt = build_completion_followup_prompt(
            user_text,
            round_idx=1,
            max_rounds=1,
            metrics=metrics_mp,
            reason=reason_mp,
            goal=goal_mp,
        )
        once_plan = call_deepseek(
            api_key=api_key,
            model=model,
            user_text=once_prompt,
            connect_timeout_s=float(args.llm_connect_timeout_s),
            read_timeout_s=float(args.llm_read_timeout_s),
        )
        once_phases = normalize_plan_phases(once_plan)
        _emit_plan_preamble(
            once_plan,
            once_phases,
            verbose=args.verbose,
            log_event="LLM one-shot multi-point verify followup",
            terminal_header="Plan(multi-point-verify-once)",
        )
        once_phases, _ = _audit_phases_degenerate_or_replan(
            user_text, once_plan, once_phases, args=args, api_key=api_key, model=model
        )
        if once_phases is not None and has_action_in_phases(once_phases):
            _execute_phases_with_runtime_replan(
                phases=once_phases,
                user_text=user_text,
                args=args,
                api_key=api_key,
                model=model,
                exec_label="MultiPointVerifyOnce",
                terminal_header="Plan(runtime-fix-multi-point-verify-once)",
            )


def parse_triangle_goal_request(user_text: str) -> tuple[list[str], float] | None:
    """
    从自然语言中提取“三角形编队”目标（3 个机器人 + 目标边长）。

    @param user_text: 用户输入
    @returns: ([robot_a, robot_b, robot_c], side_length_m)；无法识别则返回 None
    """

    t = user_text.lower()
    if ("三角" not in user_text) and ("triangle" not in t):
        return None
    ids = re.findall(r"(?:GV|AV)\d+|robot_[A-Za-z0-9_]+", user_text, flags=re.IGNORECASE)
    uniq: list[str] = []
    for rid in ids:
        k = rid.upper()
        if k not in [u.upper() for u in uniq]:
            uniq.append(rid)
    if len(uniq) < 3:
        return None
    nums = re.findall(r"(\d+(?:\.\d+)?)\s*m", user_text, flags=re.IGNORECASE)
    if not nums:
        nums = re.findall(r"(\d+(?:\.\d+)?)\s*米", user_text)
    side = float(nums[0]) if nums else 1.0
    return uniq[:3], side


def parse_triangle_intent_side(user_text: str) -> float | None:
    """
    仅识别“三角形”意图与目标边长（不要求输入里显式带机器人 ID）。

    @param user_text: 用户输入
    @returns: 目标边长；若非三角形意图返回 None
    """

    t = user_text.lower()
    if ("三角" not in user_text) and ("triangle" not in t):
        return None
    nums = re.findall(r"(\d+(?:\.\d+)?)\s*m", user_text, flags=re.IGNORECASE)
    if not nums:
        nums = re.findall(r"(\d+(?:\.\d+)?)\s*米", user_text)
    return float(nums[0]) if nums else 1.0


def parse_line_goal_request(user_text: str) -> tuple[list[str], float] | None:
    """
    从自然语言中提取“多机器人排成一行等间距”目标。

    @param user_text: 用户输入
    @returns: ([robot_1,...], spacing_m)；无法识别则返回 None
    """

    t = user_text.lower()
    if (
        ("一行" not in user_text)
        and ("一排" not in user_text)
        and ("直线" not in user_text)
        and ("一列" not in user_text)
        and ("纵队" not in user_text)
        and ("队列排开" not in user_text)
        and ("成排" not in user_text)
        and ("line" not in t)
    ):
        return None
    ids = re.findall(r"(?:GV|AV)\d+|robot_[A-Za-z0-9_]+", user_text, flags=re.IGNORECASE)
    uniq: list[str] = []
    for rid in ids:
        if rid.upper() not in [u.upper() for u in uniq]:
            uniq.append(rid)
    if len(uniq) < 2:
        return None
    nums = re.findall(r"(\d+(?:\.\d+)?)\s*m", user_text, flags=re.IGNORECASE)
    if not nums:
        nums = re.findall(r"(\d+(?:\.\d+)?)\s*米", user_text)
    spacing = float(nums[0]) if nums else 1.0
    return uniq, spacing


def parse_line_baseline_from_text(user_text: str) -> tuple[float | None, float | None]:
    """
    从自然语言中解析直线编队的基准线约束（y=... 或 x=...）。

    @param user_text: 用户输入
    @returns: (baseline_y, baseline_x)
    """

    t = user_text
    m_y = re.search(r"y\s*=\s*(-?\d+(?:\.\d+)?)", t, flags=re.IGNORECASE)
    if not m_y:
        m_y = re.search(r"以\s*y\s*=\s*(-?\d+(?:\.\d+)?)\s*为基准", t, flags=re.IGNORECASE)
    if not m_y:
        m_y = re.search(r"以\s*y\s*(-?\d+(?:\.\d+)?)\s*为基准", t, flags=re.IGNORECASE)
    m_x = re.search(r"x\s*=\s*(-?\d+(?:\.\d+)?)", t, flags=re.IGNORECASE)
    if not m_x:
        m_x = re.search(r"以\s*x\s*=\s*(-?\d+(?:\.\d+)?)\s*为基准", t, flags=re.IGNORECASE)
    if not m_x:
        m_x = re.search(r"以\s*x\s*(-?\d+(?:\.\d+)?)\s*为基准", t, flags=re.IGNORECASE)
    by = float(m_y.group(1)) if m_y else None
    bx = float(m_x.group(1)) if m_x else None
    return by, bx


def parse_right_triangle_goal_request(user_text: str) -> tuple[list[str], float, float] | None:
    """
    解析“直角三角形”目标（3 车 + 两条直角边长度）。

    @param user_text: 用户输入
    @returns: ([r1,r2,r3], leg_a_m, leg_b_m)；若无法识别返回 None
    """

    t = user_text.lower()
    if ("直角三角形" not in user_text) and ("right triangle" not in t):
        return None
    ids = re.findall(r"(?:GV|AV)\d+|robot_[A-Za-z0-9_]+", user_text, flags=re.IGNORECASE)
    uniq: list[str] = []
    for rid in ids:
        if rid.upper() not in [u.upper() for u in uniq]:
            uniq.append(rid)
    if len(uniq) < 3:
        return None
    nums = re.findall(r"(\d+(?:\.\d+)?)\s*m", user_text, flags=re.IGNORECASE)
    if not nums:
        nums = re.findall(r"(\d+(?:\.\d+)?)\s*米", user_text)
    if len(nums) >= 2:
        a, b = float(nums[0]), float(nums[1])
    elif len(nums) == 1:
        a = b = float(nums[0])
    else:
        a = b = 1.0
    return uniq[:3], a, b


def parse_convoy_goal_request(user_text: str) -> tuple[list[str], float | None, int | None] | None:
    """
    解析“队列共同前进”目标。

    @param user_text: 用户输入
    @returns: (robots, speed_mps|None, duration_ms|None)
    """

    t = user_text.lower()
    keywords = ["队列", "共同前进", "一起前进", "convoy", "in line and move", "formation move"]
    if not any(k in t or k in user_text for k in keywords):
        return None
    ids = re.findall(r"(?:GV|AV)\d+|robot_[A-Za-z0-9_]+", user_text, flags=re.IGNORECASE)
    uniq: list[str] = []
    for rid in ids:
        if rid.upper() not in [u.upper() for u in uniq]:
            uniq.append(rid)
    speed = None
    m_speed = re.search(r"(\d+(?:\.\d+)?)\s*m/s", user_text, flags=re.IGNORECASE)
    if m_speed:
        speed = float(m_speed.group(1))
    duration_ms = None
    m_ms = re.search(r"(\d+)\s*ms", user_text, flags=re.IGNORECASE)
    m_s = re.search(r"(\d+(?:\.\d+)?)\s*s\b", user_text, flags=re.IGNORECASE)
    if m_ms:
        duration_ms = int(m_ms.group(1))
    elif m_s:
        duration_ms = int(float(m_s.group(1)) * 1000.0)
    return uniq, speed, duration_ms


def parse_point_goal_request(user_text: str) -> tuple[str, float, float] | None:
    """
    解析“机器人移动到指定点位”目标。

    支持示例：
    - GV3 到 (2.0, 1.5)
    - 让 robot_2 前往 3,4
    - move GV1 to (1.2, -0.6)

    @param user_text: 用户输入
    @returns: (robot_id, target_x, target_y)；无法识别返回 None
    """

    multi = parse_multi_point_goal_request(user_text)
    if multi:
        return multi[0]

    patterns = [
        r"((?:GV|AV)\d+|robot[_\s-]?\d+|robot_[A-Za-z0-9_]+|机器人\s*\d+|小车\s*\d+|\d+\s*号车).{0,10}(?:到|前往|去到|移动到|to|move to)\s*\(?\s*(-?\d+(?:\.\d+)?)\s*[,，\s]\s*(-?\d+(?:\.\d+)?)\s*\)?",
        r"(?:到|前往|去到|移动到|to)\s*\(?\s*(-?\d+(?:\.\d+)?)\s*[,，\s]\s*(-?\d+(?:\.\d+)?)\s*\)?.{0,10}((?:GV|AV)\d+|robot[_\s-]?\d+|robot_[A-Za-z0-9_]+|机器人\s*\d+|小车\s*\d+|\d+\s*号车)",
    ]
    for p in patterns:
        m = re.search(p, user_text, flags=re.IGNORECASE)
        if not m:
            continue
        g = m.groups()
        if len(g) != 3:
            continue
        if re.match(
            r"^(?:GV|AV)\d+|robot[_\s-]?\d+|robot_[A-Za-z0-9_]+|机器人\s*\d+|小车\s*\d+|\d+\s*号车$",
            g[0],
            flags=re.IGNORECASE,
        ):
            rid, sx, sy = g[0], g[1], g[2]
        else:
            sx, sy, rid = g[0], g[1], g[2]
        return _normalize_robot_ref_from_text(str(rid)), float(sx), float(sy)
    m_origin = re.search(
        r"((?:GV|AV)\d+|robot[_\s-]?\d+|robot_[A-Za-z0-9_]+|机器人\s*\d+|小车\s*\d+|\d+\s*号车)"
        r".{0,14}(?:到|前往|去到|移动到|回到|返回|to|move to).{0,8}(?:原点|坐标原点|origin)\b",
        user_text,
        flags=re.IGNORECASE,
    )
    if m_origin:
        return _normalize_robot_ref_from_text(str(m_origin.group(1))), 0.0, 0.0
    return None


def _normalize_robot_ref_from_text(token: str) -> str:
    """
    归一化自然语言中的机器人引用。

    @param token: 文本中的机器人标识（如 GV2 / robot2 / robot_2 / 机器人2）
    @returns: 规范化后的 robot 引用（优先 robot_N / GVN）
    """

    t = token.strip()
    m_zh = re.fullmatch(r"机器人\s*(\d+)", t)
    if m_zh:
        return f"robot_{int(m_zh.group(1))}"
    m_small = re.fullmatch(r"小车\s*(\d+)", t)
    if m_small:
        return f"GV{int(m_small.group(1))}"
    m_no = re.fullmatch(r"(\d+)\s*号车", t)
    if m_no:
        return f"GV{int(m_no.group(1))}"
    m_gv = re.fullmatch(r"(GV|AV)\s*(\d+)", t, flags=re.IGNORECASE)
    if m_gv:
        return f"{m_gv.group(1).upper()}{int(m_gv.group(2))}"
    m_robot = re.fullmatch(r"robot[_\s-]?(\d+)", t, flags=re.IGNORECASE)
    if m_robot:
        return f"robot_{int(m_robot.group(1))}"
    return t


def parse_multi_point_goal_request(user_text: str) -> list[tuple[str, float, float]]:
    """
    解析“多机器人 -> 多点位”目标。

    @param user_text: 用户输入
    @returns: [(robot_id, x, y), ...]；无法识别返回空列表
    """

    out: list[tuple[str, float, float]] = []
    p = (
        r"((?:GV|AV)\d+|robot[_\s-]?\d+|robot_[A-Za-z0-9_]+|机器人\s*\d+)"
        r".{0,10}?(?:移动到|到|前往|去到|move to|to)\s*[（(]?\s*"
        r"(-?\d+(?:\.\d+)?)\s*[,，]\s*(-?\d+(?:\.\d+)?)\s*[）)]?"
    )
    for m in re.finditer(p, user_text, flags=re.IGNORECASE):
        rid = _normalize_robot_ref_from_text(str(m.group(1)))
        out.append((rid, float(m.group(2)), float(m.group(3))))
    return out


def parse_single_robot_multi_waypoints_request(user_text: str) -> tuple[str, list[tuple[float, float]]] | None:
    """
    解析“单机器人按顺序经过多个点位”的请求。

    示例：
    - 将3号车移动到(0,2)然后再移动到(1,2)
    - GV3 到 (0,2) 再到 (1,2) 再到 (2,2)

    @param user_text: 用户输入
    @returns: (robot_id, waypoints)；无法识别返回 None
    """

    ids = re.findall(r"(?:GV|AV)\d+|robot_[A-Za-z0-9_]+", user_text, flags=re.IGNORECASE)
    if not ids:
        m_no = re.search(r"(\d+)\s*号车", user_text)
        if m_no:
            ids = [f"robot_{int(m_no.group(1))}"]
    uniq_ids: list[str] = []
    for rid in ids:
        rr = rid.strip()
        if rr and rr.upper() not in [x.upper() for x in uniq_ids]:
            uniq_ids.append(rr)
    if len(uniq_ids) != 1:
        return None
    pts = re.findall(r"[（(]?\s*(-?\d+(?:\.\d+)?)\s*[,，]\s*(-?\d+(?:\.\d+)?)\s*[）)]?", user_text)
    waypoints = [(float(x), float(y)) for x, y in pts]
    if len(waypoints) < 2:
        return None
    return uniq_ids[0], waypoints


def is_complex_constraint_task(user_text: str, args: argparse.Namespace) -> bool:
    """
    判定请求是否属于“复杂约束任务”（应走模板闭环执行）。

    复杂判定规则：
    - 任何编队/相对约束（线形、三角形、队列、两车间距）
    - 复合目标（多点位 + 编队/间距约束）

    @param user_text: 用户输入
    @param args: 客户端参数
    @returns: True=复杂任务；False=简单任务
    """

    has_line = parse_line_goal_request(user_text) is not None or infer_line_formation_from_nl(user_text, args) is not None
    has_triangle = parse_triangle_goal_request(user_text) is not None or parse_triangle_intent_side(user_text) is not None
    has_right_triangle = parse_right_triangle_goal_request(user_text) is not None
    has_convoy = parse_convoy_goal_request(user_text) is not None
    has_distance_goal = parse_distance_goal_request(user_text) is not None and (
        ("相距" in user_text) or ("排成" in user_text) or ("distance" in user_text.lower())
    )
    has_multi_point = len(parse_multi_point_goal_request(user_text)) >= 2
    has_line_kw = any(k in user_text for k in ["一排", "排成一排", "成排", "排成一行", "排成一列"])
    has_arrange_with_spacing = (
        ("排成" in user_text or "相距" in user_text)
        and bool(re.search(r"(\d+(?:\.\d+)?)\s*(m|米)", user_text, flags=re.IGNORECASE))
    )
    has_other_two_hint = "另外两个" in user_text or "其余两个" in user_text or "另外俩个" in user_text
    # 复合目标：单点 + 任意相对约束也属于复杂任务
    has_single_point = parse_point_goal_request(user_text) is not None
    has_composite = has_single_point and (
        has_line or has_triangle or has_right_triangle or has_convoy or has_distance_goal or has_arrange_with_spacing
    )
    return (
        has_line
        or has_triangle
        or has_right_triangle
        or has_convoy
        or has_distance_goal
        or has_multi_point
        or has_line_kw
        or has_arrange_with_spacing
        or has_other_two_hint
        or has_composite
    )


def build_complex_intent_system_prompt() -> str:
    """
    构造“复杂任务结构化意图解析”专用提示词。

    @returns: 仅输出结构化意图的系统提示词
    """

    return (
        "You are an intent parser for a robot control client.\n"
        "Task: parse ONLY structured intent for complex constrained tasks.\n"
        "Do NOT output tool steps. Do NOT output markdown.\n"
        "Output JSON object only with schema:\n"
        "{"
        "\"intent_type\":\"line_formation|triangle_formation|right_triangle_formation|pair_distance|convoy|composite\","
        "\"robots\":[\"GV1\",...],"
        "\"params\":{...},"
        "\"subgoals\":[{\"intent_type\":\"point_goal|line_formation|pair_distance|triangle_formation|right_triangle_formation|convoy\","
        "\"robots\":[...],\"params\":{...}}]"
        "}\n"
        "Rules:\n"
        "- Prefer explicit robot IDs from user text.\n"
        "- For line formation, include params.spacing_m.\n"
        "- If user specifies line baseline like y=1 or x=2, include params.baseline_y or params.baseline_x.\n"
        "- For triangle, include params.side_length_m.\n"
        "- For right triangle, include params.leg_a_m and params.leg_b_m.\n"
        "- For pair distance, include params.target_distance_m.\n"
        "- For convoy, include params.speed_mps and params.duration_ms when available.\n"
        "- If request includes mixed goals, use intent_type='composite' and fill subgoals.\n"
        "- For point_goal, params.target_x and params.target_y are REQUIRED.\n"
    )


def build_fallback_complex_intent(user_text: str, args: argparse.Namespace) -> dict[str, Any]:
    """
    使用规则解析构造复杂任务结构化意图（LLM 失败时回退）。

    @param user_text: 用户输入
    @param args: 客户端参数
    @returns: 结构化复杂意图
    """

    line_goal = parse_line_goal_request(user_text)
    if line_goal is None:
        line_goal = infer_line_formation_from_nl(user_text, args)
    multi_points = parse_multi_point_goal_request(user_text)
    point_goal = parse_point_goal_request(user_text)
    if line_goal and (len(multi_points) >= 1 or point_goal is not None):
        subgoals: list[dict[str, Any]] = []
        if len(multi_points) >= 2:
            for rid, tx, ty in multi_points:
                subgoals.append({"intent_type": "point_goal", "robots": [rid], "params": {"target_x": tx, "target_y": ty}})
        elif point_goal is not None:
            rid, tx, ty = point_goal
            subgoals.append({"intent_type": "point_goal", "robots": [rid], "params": {"target_x": tx, "target_y": ty}})
        robots_line, spacing_line = line_goal
        subgoals.append(
            {"intent_type": "line_formation", "robots": robots_line, "params": {"spacing_m": spacing_line}}
        )
        robots_union: list[str] = []
        for sg in subgoals:
            for rid in sg.get("robots") or []:
                rr = str(rid)
                if rr and rr not in robots_union:
                    robots_union.append(rr)
        return {"intent_type": "composite", "robots": robots_union, "params": {}, "subgoals": subgoals}

    right_goal = parse_right_triangle_goal_request(user_text)
    if right_goal:
        robots, la, lb = right_goal
        return {"intent_type": "right_triangle_formation", "robots": robots, "params": {"leg_a_m": la, "leg_b_m": lb}}

    tri_goal = parse_triangle_goal_request(user_text)
    tri_side_only = parse_triangle_intent_side(user_text)
    if tri_goal or tri_side_only is not None:
        if tri_goal:
            robots, side_m = tri_goal
        else:
            side_m = float(tri_side_only)
            robots = _pick_first_n_unit_ids_from_fleet(args, 3)
        return {"intent_type": "triangle_formation", "robots": robots, "params": {"side_length_m": side_m}}

    if line_goal:
        robots, spacing = line_goal
        by, bx = parse_line_baseline_from_text(user_text)
        params_line: dict[str, Any] = {"spacing_m": spacing}
        if isinstance(by, float):
            params_line["baseline_y"] = by
        if isinstance(bx, float):
            params_line["baseline_x"] = bx
        return {"intent_type": "line_formation", "robots": robots, "params": params_line}

    convoy_goal = parse_convoy_goal_request(user_text)
    if convoy_goal:
        robots, speed_opt, dur_opt = convoy_goal
        if not robots:
            robots = _pick_first_n_unit_ids_from_fleet(args, 10)
        params: dict[str, Any] = {}
        if speed_opt is not None:
            params["speed_mps"] = float(speed_opt)
        if dur_opt is not None:
            params["duration_ms"] = int(dur_opt)
        return {"intent_type": "convoy", "robots": robots, "params": params}

    dist_goal = parse_distance_goal_request(user_text)
    if dist_goal and (("相距" in user_text) or ("排成" in user_text) or ("distance" in user_text.lower())):
        ra, rb, d = dist_goal
        return {"intent_type": "pair_distance", "robots": [ra, rb], "params": {"target_distance_m": d}}

    if len(multi_points) >= 2:
        subgoals: list[dict[str, Any]] = []
        for rid, tx, ty in multi_points:
            subgoals.append({"intent_type": "point_goal", "robots": [rid], "params": {"target_x": tx, "target_y": ty}})
        return {"intent_type": "composite", "robots": [rid for rid, _, _ in multi_points], "params": {}, "subgoals": subgoals}

    return {"intent_type": "unknown", "robots": [], "params": {}}


def infer_complex_intent_with_llm(
    *,
    api_key: str,
    model: str,
    user_text: str,
    args: argparse.Namespace,
) -> dict[str, Any]:
    """
    调用 LLM 解析复杂任务结构化意图；失败时回退到规则解析。

    @param api_key: LLM API Key
    @param model: 模型名
    @param user_text: 用户输入
    @param args: 客户端参数
    @returns: 含 intent_id 的结构化意图
    """

    def _validate_intent_payload(intent_obj: dict[str, Any]) -> list[str]:
        """@param intent_obj: 结构化意图 @returns: 校验错误列表（空表示通过）"""

        errs: list[str] = []
        itype = str(intent_obj.get("intent_type", "")).strip()
        robots = intent_obj.get("robots")
        params = intent_obj.get("params")
        subgoals = intent_obj.get("subgoals")
        if not isinstance(robots, list):
            errs.append("robots must be a list")
        if not isinstance(params, dict):
            errs.append("params must be an object")
            params = {}
        if itype == "point_goal":
            if not isinstance(robots, list) or len(robots) < 1:
                errs.append("point_goal requires at least one robot")
            if not isinstance(params.get("target_x"), (int, float)) or not isinstance(params.get("target_y"), (int, float)):
                errs.append("point_goal requires numeric params.target_x and params.target_y")
        if itype == "line_formation":
            if not isinstance(robots, list) or len(robots) < 2:
                errs.append("line_formation requires at least two robots")
            if not isinstance(params.get("spacing_m"), (int, float)):
                errs.append("line_formation requires numeric params.spacing_m")
        if itype == "pair_distance":
            if not isinstance(robots, list) or len(robots) < 2:
                errs.append("pair_distance requires two robots")
            if not isinstance(params.get("target_distance_m"), (int, float)):
                errs.append("pair_distance requires numeric params.target_distance_m")
        if itype == "composite":
            if not isinstance(subgoals, list) or not subgoals:
                errs.append("composite requires non-empty subgoals")
            else:
                for idx, sg in enumerate(subgoals):
                    if not isinstance(sg, dict):
                        errs.append(f"subgoal[{idx}] must be object")
                        continue
                    errs.extend([f"subgoal[{idx}]: {e}" for e in _validate_intent_payload(sg)])
        return errs

    def _repair_intent_with_llm(
        *,
        bad_intent: dict[str, Any],
        errors: list[str],
    ) -> dict[str, Any]:
        """@param bad_intent: 待修复意图 @param errors: 错误列表 @returns: 修复后的意图"""

        repair_system = (
            "You are an intent JSON repairer.\n"
            "Task: repair the provided intent JSON to satisfy schema and keep user semantics.\n"
            "Output JSON object only.\n"
            "Rules:\n"
            "- Keep intent_type and robot choices unless clearly invalid.\n"
            "- For point_goal, params.target_x and params.target_y are REQUIRED and must be numeric.\n"
            "- If user explicitly says origin/原点, set target_x=0,target_y=0.\n"
            "- For composite, preserve subgoal order and repair each invalid subgoal.\n"
        )
        repair_user = (
            f"User request:\n{user_text}\n\n"
            f"Validation errors:\n{json.dumps(errors, ensure_ascii=False)}\n\n"
            f"Bad intent JSON:\n{json.dumps(bad_intent, ensure_ascii=False)}\n\n"
            "Return repaired JSON only."
        )
        return call_deepseek_json(
            api_key=api_key,
            model=model,
            system_prompt=repair_system,
            user_text=repair_user,
            connect_timeout_s=float(args.llm_connect_timeout_s),
            read_timeout_s=float(args.llm_read_timeout_s),
        )

    prompt = user_text
    if args.prime_list:
        try:
            inv = run_mcp_call(server_spec=args.server_spec, tool="list_robots", args={})
            snap = extract_tool_json_string(inv)
            if snap:
                prompt = f"Live robot list snapshot:\n{snap}\n\nUser request:\n{user_text}"
        except Exception as e:
            logger.warning("complex intent prime_list failed: %s", e)
    try:
        parsed = call_deepseek_json(
            api_key=api_key,
            model=model,
            system_prompt=build_complex_intent_system_prompt(),
            user_text=prompt,
            connect_timeout_s=float(args.llm_connect_timeout_s),
            read_timeout_s=float(args.llm_read_timeout_s),
        )
        if not isinstance(parsed.get("intent_type"), str):
            raise RuntimeError(f"complex intent missing intent_type: {parsed}")
    except Exception as e:
        logger.warning("complex intent llm parse failed, fallback to rules: %s", e)
        parsed = build_fallback_complex_intent(user_text, args)

    if not isinstance(parsed.get("robots"), list):
        parsed["robots"] = []
    if not isinstance(parsed.get("params"), dict):
        parsed["params"] = {}
    if not isinstance(parsed.get("subgoals"), list):
        parsed["subgoals"] = []
    validation_errors = _validate_intent_payload(parsed)
    if validation_errors:
        logger.warning("complex intent validation failed, auto-repair: %s", validation_errors)
        try:
            repaired = _repair_intent_with_llm(bad_intent=parsed, errors=validation_errors)
            if isinstance(repaired, dict):
                parsed = repaired
        except Exception as e:
            logger.warning("complex intent auto-repair failed: %s", e)
    # 修复后再校验；仍不通过则用规则回退并阻止默认点位兜底。
    validation_errors = _validate_intent_payload(parsed)
    if validation_errors:
        logger.warning("complex intent still invalid after repair, fallback to rules: %s", validation_errors)
        parsed = build_fallback_complex_intent(user_text, args)
        validation_errors = _validate_intent_payload(parsed)
        if validation_errors:
            raise RuntimeError(f"Invalid complex intent after repair/fallback: {validation_errors}")
    fallback_intent = build_fallback_complex_intent(user_text, args)
    if (
        isinstance(fallback_intent, dict)
        and str(fallback_intent.get("intent_type", "")) == "composite"
        and str(parsed.get("intent_type", "")) != "composite"
    ):
        logger.info("complex intent post-fix: upgrade to composite fallback intent")
        parsed = fallback_intent
    parsed["intent_id"] = parsed.get("intent_id") or f"intent_{int(time.time() * 1000)}"
    return parsed


@dataclass(frozen=True)
class CompletionGoal:
    """
    执行结束后用于校验的自然语言可度量目标（与模板路径无关）。

    @param kind: line_spacing / pair_distance / point_goal / multi_point
    @param robot_ids: 参与校验的机器人 id列表（GV* / robot_*）
    @param target_m: 通用标量目标（距离类用米；点位类可置 0）
    @param target_points: 点位目标映射（仅 point_goal / multi_point 使用）
    """

    kind: str
    robot_ids: list[str]
    target_m: float
    target_points: dict[str, tuple[float, float]] | None = None
    subgoals: list["CompletionGoal"] | None = None


@dataclass
class RobotRoutePlan:
    """
    单机器人多目标点路线计划（顺序门禁执行）。

    @param robot_id: 被控制机器人
    @param waypoints: 顺序目标点 [(x,y), ...]
    @param tolerance_m: 每个目标点的收敛容差
    @param current_index: 当前执行到的 waypoint 下标
    """

    robot_id: str
    waypoints: list[tuple[float, float]]
    tolerance_m: float
    current_index: int = 0


def _sort_unit_ids(ids: list[str]) -> list[str]:
    """
    @param ids: unit_id 或 robot 别名列表
    @returns: 稳定排序（类型前缀 + 数字），便于「一排」隐式选车顺序一致
    """

    def _key(u: str) -> tuple[str, int]:
        m = re.match(r"^([A-Za-z_]+)(\d+)$", u.strip())
        if m:
            return (m.group(1).upper(), int(m.group(2)))
        return (u.upper(), 0)

    return sorted(ids, key=_key)


def infer_line_formation_from_nl(user_text: str, args: argparse.Namespace) -> tuple[list[str], float] | None:
    """
    识别「排成一行 / 直线 + 间距」；无显式车号时从舰队取车。

    - 台数：显式「三个/两个…」、或「中间/中间车」默认三车、或仅写「排成一行」时用绑定表内全部车（≥2）。
    - 车号顺序：`_sort_unit_ids` 稳定排序后取前 N 台。

    @param user_text: 用户输入
    @param args: 含 server_spec
    @returns: (robot_ids, spacing_m)；无法识别返回 None
    """

    t = user_text
    if (
        ("一行" not in t)
        and ("一排" not in t)
        and ("直线" not in t)
        and ("一列" not in t)
        and ("纵队" not in t)
        and ("队列排开" not in t)
        and ("成排" not in t)
        and ("line" not in t.lower())
    ):
        return None
    nums = re.findall(r"(\d+(?:\.\d+)?)\s*m", user_text, flags=re.IGNORECASE)
    if not nums:
        nums = re.findall(r"(\d+(?:\.\d+)?)\s*米", user_text)
    spacing = float(nums[0]) if nums else 1.0

    explicit = parse_line_goal_request(user_text)
    if explicit:
        return explicit[0], explicit[1]

    n: int | None = None
    if re.search(r"(三个|3\s*个|三台|三辆|三车)", t):
        n = 3
    elif re.search(r"(两个|2\s*个|两台|二台|二辆)", t):
        n = 2
    elif re.search(r"(四个|4\s*个|四台)", t):
        n = 4
    # 「中间车」语义默认三车一列，中间与两侧各距 1m
    if n is None and re.search(r"中间", t):
        n = 3
    ids_all = _pick_first_n_unit_ids_from_fleet(args, 16)
    # 「排成一行」但未写台数：用当前绑定表全部参与车（≥2）做等距校验，便于「小车/多车」说法
    if n is None and ids_all and len(ids_all) >= 2:
        if re.search(r"(排成|排列|站成).{0,8}(一行|直线|一列|纵队|队列)", t) or (
            "排" in t
            and (
                ("一行" in t)
                or ("一排" in t)
                or ("成排" in t)
                or ("直线" in t)
                or ("一列" in t)
                or ("纵队" in t)
                or ("队列" in t)
            )
        ):
            n = len(ids_all)
    if n is None:
        return None
    ids = ids_all if len(ids_all) >= n else _pick_first_n_unit_ids_from_fleet(args, max(n, 12))
    if len(ids) < n:
        return None
    return _sort_unit_ids(ids)[:n], spacing


def _pose_triple_for_robot(
    poses: dict[str, tuple[float, float, float]],
    robot_ref: str,
    config_path: str,
) -> tuple[float, float, float] | None:
    """
    在 fleet 位姿表中解析某一 robot_id / unit_id 的 (x,y,yaw)。

    @param poses: fleet_poses_from_mcp_result 输出
    @param robot_ref: GV1 或 robot_1 等
    @param config_path: robots.json 路径
    @returns: 位姿三元组；找不到返回 None
    """

    r = robot_ref.strip()
    if r in poses:
        return poses[r]
    for cfg in load_robot_configs(config_path):
        if cfg.robot_id.upper() == r.upper() or cfg.unit_id.upper() == r.upper():
            for k in (cfg.robot_id, cfg.unit_id):
                if k in poses:
                    return poses[k]
    return None


def _euclid_xy(a: tuple[float, float, float], b: tuple[float, float, float]) -> float:
    """@returns: 平面欧氏距离（米）"""

    return float(math.hypot(a[0] - b[0], a[1] - b[1]))


def infer_completion_goal(user_text: str, args: argparse.Namespace) -> CompletionGoal | None:
    """
    从自然语言推断可自动校验的度量目标（仅覆盖常见编队句式）。

    @param user_text: 用户原始输入
    @param args: 客户端参数（舰队探测）
    @returns: CompletionGoal；无法度量则 None（不进入续跑）
    """

    line_g = infer_line_formation_from_nl(user_text, args)
    multi_points = parse_multi_point_goal_request(user_text)
    point_goal = parse_point_goal_request(user_text)
    has_point = bool(multi_points) or bool(point_goal)
    has_line = line_g is not None
    if has_point and has_line:
        subgoals: list[CompletionGoal] = []
        if len(multi_points) >= 2:
            target_points = {rid: (float(tx), float(ty)) for rid, tx, ty in multi_points}
            subgoals.append(
                CompletionGoal(
                    kind="multi_point",
                    robot_ids=[rid for rid, _, _ in multi_points],
                    target_m=0.0,
                    target_points=target_points,
                )
            )
        elif point_goal:
            rid, tx, ty = point_goal
            subgoals.append(
                CompletionGoal(
                    kind="point_goal",
                    robot_ids=[rid],
                    target_m=0.0,
                    target_points={rid: (float(tx), float(ty))},
                )
            )
        ids, sp = line_g
        subgoals.append(CompletionGoal(kind="line_spacing", robot_ids=list(ids), target_m=float(sp)))
        all_ids: list[str] = []
        for sg in subgoals:
            for rid in sg.robot_ids:
                if rid not in all_ids:
                    all_ids.append(rid)
        return CompletionGoal(kind="composite", robot_ids=all_ids, target_m=0.0, subgoals=subgoals)

    if len(multi_points) >= 2:
        target_points = {rid: (float(tx), float(ty)) for rid, tx, ty in multi_points}
        return CompletionGoal(
            kind="multi_point",
            robot_ids=[rid for rid, _, _ in multi_points],
            target_m=0.0,
            target_points=target_points,
        )
    if point_goal:
        rid, tx, ty = point_goal
        return CompletionGoal(
            kind="point_goal",
            robot_ids=[rid],
            target_m=0.0,
            target_points={rid: (float(tx), float(ty))},
        )
    if line_g:
        ids, sp = line_g
        return CompletionGoal(kind="line_spacing", robot_ids=list(ids), target_m=float(sp))
    dg = parse_distance_goal_request(user_text)
    if dg:
        ra, rb, d = dg
        return CompletionGoal(kind="pair_distance", robot_ids=[ra, rb], target_m=float(d))
    return None


def verify_completion_goal(
    goal: CompletionGoal,
    poses: dict[str, tuple[float, float, float]],
    *,
    tol_m: float,
    config_path: str,
) -> tuple[bool, str, dict[str, Any]]:
    """
    根据当前位姿快照判断是否满足 CompletionGoal。

    @param goal: 推断出的目标
    @param poses: get_fleet_status 解析的位姿表
    @param tol_m: 允许误差（米）
    @param config_path: robots.json
    @returns: (是否达标, 说明, 指标 dict)
    """

    metrics: dict[str, Any] = {"goal_kind": goal.kind, "target_m": goal.target_m, "robots": goal.robot_ids}
    if goal.kind == "composite":
        sub = goal.subgoals or []
        if not sub:
            return False, "复合目标缺少子目标", metrics
        metrics["subgoals"] = []
        failures: list[str] = []
        for sg in sub:
            ok_sg, reason_sg, metrics_sg = verify_completion_goal(
                sg,
                poses,
                tol_m=tol_m,
                config_path=config_path,
            )
            metrics["subgoals"].append(
                {"kind": sg.kind, "ok": ok_sg, "reason": reason_sg, "metrics": metrics_sg}
            )
            if not ok_sg:
                failures.append(f"{sg.kind}: {reason_sg}")
        if failures:
            return False, "；".join(failures), metrics
        return True, "复合目标全部子目标达标", metrics
    if goal.kind in {"point_goal", "multi_point"}:
        target_points = goal.target_points or {}
        if not target_points:
            return False, "缺少点位目标映射", metrics
        per_robot: list[dict[str, Any]] = []
        missing: list[str] = []
        for rid, (tx, ty) in target_points.items():
            p = _pose_triple_for_robot(poses, rid, config_path)
            if p is None:
                missing.append(rid)
                continue
            dist = float(math.hypot(float(p[0]) - float(tx), float(p[1]) - float(ty)))
            per_robot.append(
                {
                    "robot_id": rid,
                    "target_x": float(tx),
                    "target_y": float(ty),
                    "distance_to_target_m": dist,
                }
            )
        metrics["target_points"] = {k: {"x": v[0], "y": v[1]} for k, v in target_points.items()}
        metrics["point_errors"] = per_robot
        if missing:
            return False, f"缺少位姿: {missing}", metrics
        if not per_robot:
            return False, "未找到可校验的点位", metrics
        worst = max(per_robot, key=lambda x: float(x["distance_to_target_m"]))
        if all(float(x["distance_to_target_m"]) <= tol_m for x in per_robot):
            return True, f"点位均在 ±{tol_m}m 内", metrics
        return (
            False,
            f"点位未达标: {worst['robot_id']} 距目标 {float(worst['distance_to_target_m']):.3f}m",
            metrics,
        )
    if goal.kind == "line_spacing":
        triples: list[tuple[str, tuple[float, float, float]]] = []
        missing: list[str] = []
        for rid in goal.robot_ids:
            p = _pose_triple_for_robot(poses, rid, config_path)
            if p is None:
                missing.append(rid)
            else:
                triples.append((rid, p))
        if missing:
            return False, f"缺少位姿: {missing}", metrics
        edges: list[dict[str, Any]] = []
        for i in range(len(triples) - 1):
            ra, pa = triples[i]
            rb, pb = triples[i + 1]
            d = _euclid_xy(pa, pb)
            err = d - goal.target_m
            edges.append({"pair": f"{ra}-{rb}", "distance_m": d, "error_m": err})
        metrics["adjacent_edges"] = edges
        if all(abs(float(e["error_m"])) <= tol_m for e in edges):
            return True, f"相邻间距均在 ±{tol_m}m 内", metrics
        worst = max(edges, key=lambda e: abs(float(e["error_m"])))
        return (
            False,
            f"间距未达标: {worst['pair']} 实际 {float(worst['distance_m']):.3f}m 目标 {goal.target_m}m",
            metrics,
        )
    if goal.kind == "pair_distance" and len(goal.robot_ids) >= 2:
        ra, rb = goal.robot_ids[0], goal.robot_ids[1]
        pa = _pose_triple_for_robot(poses, ra, config_path)
        pb = _pose_triple_for_robot(poses, rb, config_path)
        if pa is None or pb is None:
            return False, f"缺少位姿: {ra} 或 {rb}", metrics
        d = _euclid_xy(pa, pb)
        err = d - goal.target_m
        metrics["pair"] = f"{ra}-{rb}"
        metrics["distance_m"] = d
        metrics["error_m"] = err
        if abs(err) <= tol_m:
            return True, f"两车间距在 ±{tol_m}m 内", metrics
        return False, f"间距未达标: 实际 {d:.3f}m 目标 {goal.target_m}m", metrics
    return True, "未实现的 goal.kind，跳过校验", metrics


def build_completion_followup_prompt(
    user_text: str,
    *,
    round_idx: int,
    max_rounds: int,
    metrics: dict[str, Any],
    reason: str,
    goal: CompletionGoal,
) -> str:
    """
    构造「未达标 → 续调度」的 LLM user 文本。

    @param user_text: 原始自然语言
    @param round_idx: 当前续跑轮次（从 1 起）
    @param max_rounds: 配置的上限轮次
    @param metrics: verify_completion_goal 的指标
    @param reason: 未达标说明
    @param goal: 结构化目标摘要
    @returns: 发给 call_deepseek 的全文
    """

    if goal.kind in {"point_goal", "multi_point"}:
        gtxt = (
            f"{goal.kind} robots={goal.robot_ids} "
            f"target_points={json.dumps(goal.target_points or {}, ensure_ascii=False)}"
        )
    else:
        gtxt = f"{goal.kind} robots={goal.robot_ids} target={goal.target_m}m"
    lines: list[str] = [
        f"COMPLETION CHECK failed (follow-up round {round_idx}/{max_rounds}).",
        f"Structured goal: {gtxt}",
        f"Reason: {reason}",
        f"Measured metrics: {json.dumps(metrics, ensure_ascii=False)}",
        "",
        f"Original user request:\n{user_text}",
        "",
        "Produce JSON only: {\"phases\":[{\"name\":\"...\",\"steps\":[...]}]} that:",
        "- Calls get_fleet_status (or per-robot get_robot_status) FIRST for CURRENT poses.",
        "- Even for single-robot movement, keep get_fleet_status in observation stage.",
        "- Uses compute_remaining_distance where useful.",
        "- Applies send_move to reduce spacing errors; never identical (v,ω,duration) to colocated robots.",
        "- Optionally iterate observe→move in multiple phases until metrics would improve.",
    ]
    return "\n".join(lines)


def extract_tool_payload(fastmcp_result: dict[str, Any]) -> dict[str, Any]:
    """
    提取 fastmcp 返回中的工具 JSON 内容，便于闭环模板读取 data 字段。

    @param fastmcp_result: run_mcp_call 返回对象
    @returns: 工具 payload dict；失败时返回空 dict
    """

    raw = extract_tool_json_string(fastmcp_result)
    if not raw:
        return {}
    try:
        data = json.loads(raw)
        return data if isinstance(data, dict) else {}
    except json.JSONDecodeError:
        return {}


def _phase_names_arrow(phases: list[dict[str, Any]]) -> str:
    """
    @param phases: normalize_plan_phases 输出
    @returns: 阶段名箭头串联，便于终端一行预览
    """

    return " → ".join(str(p.get("name", "?")) for p in phases)


def _format_step_inline(tool: str, tool_args: dict[str, Any]) -> str:
    """
    @param tool: 工具名
    @param tool_args: 参数
    @returns: 单行缩略参数（用于精简终端）
    """

    if not tool_args:
        return f"{tool}()"
    parts = [f"{k}={v}" for k, v in tool_args.items()]
    return f"{tool}({','.join(parts)})"


def _emit_plan_preamble(
    plan: dict[str, Any],
    phases: list[dict[str, Any]],
    *,
    verbose: bool,
    log_event: str = "LLM plan",
    terminal_header: str = "Plan",
) -> None:
    """
    打印 LLM 规划预览：verbose 时完整 JSON；否则仅阶段名链与步数。

    @param plan: 原始 LLM 输出
    @param phases: 规范化阶段列表
    @param verbose: 是否展开完整终端输出
    @param log_event: 写入 client.log 的事件名前缀
    @param terminal_header: 终端首行前缀（如 Plan / Plan(audit-fix) / Plan2）
    """

    logger.info("%s: %s", log_event, json.dumps(plan, ensure_ascii=False))
    if verbose:
        print(f"{terminal_header}> {json.dumps(plan, ensure_ascii=False)}")
        print(f"Phases> {json.dumps(phases, ensure_ascii=False)}")
        for i, phase in enumerate(phases, start=1):
            print(f"Phase {i} Name> {phase['name']}")
            print(f"Phase {i} Seq> {compact_step_sequence(phase['steps'])}")
    else:
        print(f"{terminal_header}> {len(phases)} phases: {_phase_names_arrow(phases)}")


def _execute_phases_collect_results(
    phases: list[dict[str, Any]],
    *,
    action_wait_mode: str,
    action_settle_extra_ms: int,
    action_sync_timeout_ms: int,
    action_sync_poll_ms: int,
    action_stable_pos_delta_m: float,
    action_stable_yaw_delta_rad: float,
    action_stable_linear_speed_mps: float,
    action_stable_angular_speed_radps: float,
    action_stable_required_polls: int,
    arrival_tolerance_m: float,
    control_yaw_tolerance_rad: float,
    server_spec: str,
    verbose: bool,
    exec_label: str = "Phase",
) -> list[tuple[str, dict[str, Any], dict[str, Any]]]:
    """
    按阶段执行工具并收集结果；终端在非 verbose 下仅输出阶段头与单行步骤摘要。

    @param phases: 规范化阶段列表
    @param action_wait_mode: 动作后等待策略（none/auto）
    @param action_settle_extra_ms: 动作额外等待（毫秒）
    @param action_sync_timeout_ms: 动作后状态同步轮询超时（毫秒）
    @param action_sync_poll_ms: 动作后状态同步轮询间隔（毫秒）
    @param action_stable_pos_delta_m: 位姿位移阈值（米）
    @param action_stable_yaw_delta_rad: 航向变化阈值（弧度）
    @param action_stable_linear_speed_mps: 线速度阈值（米/秒）
    @param action_stable_angular_speed_radps: 角速度阈值（弧度/秒）
    @param action_stable_required_polls: 连续稳定采样次数
    @param arrival_tolerance_m: 点位到达容差（米），用于运行时防漂移护栏
    @param control_yaw_tolerance_rad: 控制层航向容差（弧度），用于“先旋转再直行”优先级判定
    @param server_spec: MCP 入口
    @param verbose: 是否打印 Args/Cmd/长 MCP
    @param exec_label: 执行块标签（Phase / Phase2）
    @returns: [(phase_name, step, result), ...]
    """

    def _wait_and_sync_after_action(tool: str, tool_args: dict[str, Any]) -> None:
        """
        动作工具执行后等待主控台刷新位姿（执行层策略，不依赖 LLM 自行猜测）。

        @param tool: 工具名
        @param tool_args: 工具参数
        """

        def _pick_state_by_ref(states: dict[str, dict[str, float]], robot_ref: str) -> dict[str, float] | None:
            """
            依据 robot_ref（GV1/robot_1）从状态表中做不区分大小写匹配。

            @param states: fleet_states_from_mcp_result 输出
            @param robot_ref: 机器人引用
            @returns: 匹配状态；无匹配返回 None
            """

            rr = robot_ref.upper().strip()
            for k, v in states.items():
                if str(k).upper() == rr:
                    return v
            return None

        if action_wait_mode != "auto":
            return
        if tool not in ACTION_TOOLS:
            return
        watch_ids: list[str] = []
        if tool in {"send_move", "stop_robot"}:
            rid = str(tool_args.get("robot_id", "")).strip()
            if rid:
                watch_ids = [rid]
        settle_s = max(0.0, float(action_settle_extra_ms) / 1000.0)
        wait_s = settle_s
        if tool == "send_move":
            wait_s = max(0.0, float(int(tool_args.get("duration_ms", 1000))) / 1000.0) + settle_s
        if wait_s > 0:
            if verbose:
                print(f"[WAIT] {tool} 后等待 {wait_s:.2f}s（执行层同步）")
            time.sleep(wait_s)

        deadline = time.monotonic() + max(0.0, float(action_sync_timeout_ms) / 1000.0)
        poll_s = max(0.05, float(action_sync_poll_ms) / 1000.0)
        stable_hits = 0
        required_hits = max(1, int(action_stable_required_polls))
        prev_states: dict[str, dict[str, float]] | None = None
        while True:
            fres = run_mcp_call(server_spec=server_spec, tool="get_fleet_status", args={"robot_ids_csv": ""})
            states = fleet_states_from_mcp_result(fres)
            if states:
                curr_states: dict[str, dict[str, float]] = {}
                if watch_ids:
                    missing = False
                    for rid in watch_ids:
                        st = _pick_state_by_ref(states, rid)
                        if st is None:
                            missing = True
                            break
                        curr_states[rid] = dict(st)
                    if missing:
                        curr_states = {}
                else:
                    curr_states = {k: dict(v) for k, v in states.items()}
                if curr_states:
                    if prev_states is not None:
                        all_stable = True
                        for rid, curr in curr_states.items():
                            prev = prev_states.get(rid)
                            if prev is None:
                                all_stable = False
                                break
                            if not is_robot_state_stable(
                                prev,
                                curr,
                                pos_delta_tol_m=float(action_stable_pos_delta_m),
                                yaw_delta_tol_rad=float(action_stable_yaw_delta_rad),
                                linear_speed_tol_mps=float(action_stable_linear_speed_mps),
                                angular_speed_tol_radps=float(action_stable_angular_speed_radps),
                            ):
                                all_stable = False
                                break
                        stable_hits = stable_hits + 1 if all_stable else 0
                    prev_states = curr_states
                    if stable_hits >= required_hits:
                        break
            if time.monotonic() >= deadline:
                if tool == "send_move" and watch_ids:
                    # mock/主控偶发速度回传滞后：先 stop 再做一次位姿放宽判稳，避免每步都超时卡住。
                    for rid in watch_ids:
                        stop_res = run_mcp_call(server_spec=server_spec, tool="stop_robot", args={"robot_id": rid})
                        if verbose:
                            print(f"[WAIT] sync-timeout fallback stop {rid}> {_compact_mcp_result(stop_res)}")
                    fallback_deadline = time.monotonic() + max(0.3, min(2.0, float(action_sync_timeout_ms) / 1000.0))
                    fallback_prev: dict[str, dict[str, float]] | None = None
                    fallback_hits = 0
                    while time.monotonic() < fallback_deadline:
                        fres2 = run_mcp_call(server_spec=server_spec, tool="get_fleet_status", args={"robot_ids_csv": ""})
                        states2 = fleet_states_from_mcp_result(fres2)
                        curr2: dict[str, dict[str, float]] = {}
                        for rid in watch_ids:
                            st2 = _pick_state_by_ref(states2, rid)
                            if st2 is not None:
                                curr2[rid] = dict(st2)
                        if curr2:
                            if fallback_prev is not None:
                                ok_pose = True
                                for rid, st_curr in curr2.items():
                                    st_prev = fallback_prev.get(rid)
                                    if st_prev is None or not is_robot_pose_quasi_stable(
                                        st_prev,
                                        st_curr,
                                        pos_delta_tol_m=float(action_stable_pos_delta_m),
                                        yaw_delta_tol_rad=float(action_stable_yaw_delta_rad),
                                    ):
                                        ok_pose = False
                                        break
                                fallback_hits = fallback_hits + 1 if ok_pose else 0
                            fallback_prev = curr2
                            if fallback_hits >= 1:
                                return
                        time.sleep(poll_s)
                print("[WARN] 动作后状态同步超时，继续后续步骤。")
                logger.warning("post_action_sync timeout tool=%s args=%s", tool, tool_args)
                break
            time.sleep(poll_s)

    out: list[tuple[str, dict[str, Any], dict[str, Any]]] = []
    yaw_recent_robots: set[str] = set()
    pair_last_distance: dict[tuple[str, str], float] = {}
    pair_worse_streak_after_yaw: dict[tuple[str, str], int] = {}
    nav_hint_latest_by_robot: dict[str, dict[str, Any]] = {}
    nav_hint_target_by_robot: dict[str, dict[str, float]] = {}
    target_lock_by_robot: dict[str, tuple[float, float]] = {}
    latest_pose_by_robot: dict[str, tuple[float, float, float]] = {}
    latest_pair_goal_by_mover: dict[str, tuple[str, float]] = {}
    worsen_tol_m = 0.01
    near_tol = max(0.01, float(arrival_tolerance_m))
    yaw_priority_tol = max(0.02, float(control_yaw_tolerance_rad))

    def _as_float_or_none(v: Any) -> float | None:
        """@param v: 任意输入 @returns: 可解析浮点或 None"""

        if v is None:
            return None
        try:
            return float(v)
        except (TypeError, ValueError):
            return None

    def _set_tool_payload(result_obj: dict[str, Any], payload_obj: dict[str, Any]) -> dict[str, Any]:
        """
        将工具 payload 回写到 fastmcp 风格结果中。

        @param result_obj: run_mcp_call 返回对象
        @param payload_obj: 需写回的 payload
        @returns: 新结果对象
        """

        txt = json.dumps(payload_obj, ensure_ascii=False)
        new_result = dict(result_obj)
        content = result_obj.get("content")
        if isinstance(content, list):
            new_blocks: list[dict[str, Any]] = []
            replaced = False
            for b in content:
                if isinstance(b, dict) and b.get("type") == "text" and not replaced:
                    nb = dict(b)
                    nb["text"] = txt
                    new_blocks.append(nb)
                    replaced = True
                else:
                    new_blocks.append(b if isinstance(b, dict) else {"type": "text", "text": str(b)})
            if not replaced:
                new_blocks.append({"type": "text", "text": txt})
            new_result["content"] = new_blocks
        else:
            new_result["content"] = [{"type": "text", "text": txt}]
        sc = result_obj.get("structured_content")
        if isinstance(sc, dict):
            nsc = dict(sc)
            nsc["result"] = txt
            new_result["structured_content"] = nsc
        else:
            new_result["structured_content"] = {"result": txt}
        return new_result

    def _known_pair_rules_compact() -> list[dict[str, Any]]:
        """@returns: 当前缓存的间距规则摘要"""

        rules: list[dict[str, Any]] = []
        for mover, (ref, dist) in latest_pair_goal_by_mover.items():
            rules.append(
                {
                    "mover_robot_a": mover,
                    "reference_robot_b": ref,
                    "target_distance_m": float(dist),
                }
            )
        return rules

    def _infer_target_point_for_mover(mover_upper: str) -> tuple[float, float] | None:
        """
        用“当前两车位姿 + 目标间距”推导绝对目标点。

        @param mover_upper: 移动车（大写）
        @returns: (target_x, target_y) 或 None
        """

        pair = latest_pair_goal_by_mover.get(mover_upper)
        ref_upper = ""
        target_d = 0.0
        if pair:
            ref_upper, target_d = pair
        else:
            # 兜底：若只记录了反向关系（A->B）且当前 mover=B，则按对称距离关系推断参考方=A。
            for mv, (rf, d) in latest_pair_goal_by_mover.items():
                if rf == mover_upper:
                    ref_upper = mv
                    target_d = float(d)
                    logger.warning(
                        "pair rule direction mismatch: using inverse rule mover=%s from recorded %s->%s",
                        mover_upper,
                        mv,
                        rf,
                    )
                    break
            if not ref_upper:
                return None
        pm = latest_pose_by_robot.get(mover_upper)
        pr = latest_pose_by_robot.get(ref_upper)
        if pm is None or pr is None:
            return None
        mx, my, _ = pm
        rx, ry, ryaw = pr
        vx = rx - mx
        vy = ry - my
        norm = math.hypot(vx, vy)
        if norm < 1e-6:
            # 两车重合时回退到参考车朝向方向。
            ux, uy = math.cos(ryaw), math.sin(ryaw)
        else:
            ux, uy = vx / norm, vy / norm
        tx = rx - ux * float(target_d)
        ty = ry - uy * float(target_d)
        return (float(tx), float(ty))
    for p_idx, phase in enumerate(phases, start=1):
        steps = phase["steps"]
        print(f"---- Execute {exec_label} {p_idx}/{len(phases)}: {phase['name']} ----")
        for s_idx, step in enumerate(steps, start=1):
            tool = step["tool"]
            tool_args = step["args"]
            cmd = ["fastmcp", "call", server_spec, tool, "--json"] + [
                f"{k}={v}" for k, v in tool_args.items()
            ]
            cmd_str = format_fastmcp_cmd(cmd)
            logger.info("%s exec p=%s s=%s tool=%s cmd=%s", exec_label, p_idx, s_idx, tool, cmd_str)
            if verbose:
                print(f"{exec_label} {p_idx} Step {s_idx}/{len(steps)} Tool> {tool}")
                print(
                    f"{exec_label} {p_idx} Step {s_idx}/{len(steps)} Args> "
                    f"{json.dumps(tool_args, ensure_ascii=False, indent=2)}"
                )
                print(f"{exec_label} {p_idx} Step {s_idx}/{len(steps)} Cmd> {cmd_str}")
            executed_action = True
            result: dict[str, Any]
            if tool == "compute_navigation_hint":
                rid_raw = str(tool_args.get("robot_id", "")).strip()
                rid = rid_raw.upper()
                ml_in = _as_float_or_none(tool_args.get("max_linear_m_s"))
                ma_in = _as_float_or_none(tool_args.get("max_angular_rad_s"))
                tune_linear = max(0.35, float(ml_in) if ml_in is not None else 0.35)
                tune_angular = max(0.8, float(ma_in) if ma_in is not None else 0.8)
                if (
                    ml_in is None
                    or ma_in is None
                    or abs(tune_linear - float(ml_in)) > 1e-9
                    or abs(tune_angular - float(ma_in)) > 1e-9
                ):
                    tool_args = dict(tool_args)
                    tool_args["max_linear_m_s"] = float(tune_linear)
                    tool_args["max_angular_rad_s"] = float(tune_angular)
                    print(
                        f"[RUNTIME_TUNE] compute_navigation_hint limits upgraded robot={rid_raw} "
                        f"max_linear={float(tune_linear):.3f} max_angular={float(tune_angular):.3f}"
                    )
                tx = _as_float_or_none(tool_args.get("target_x"))
                ty = _as_float_or_none(tool_args.get("target_y"))
                if rid and (tx is None or ty is None):
                    inferred = _infer_target_point_for_mover(rid)
                    if inferred is not None:
                        tool_args = dict(tool_args)
                        tool_args["target_x"] = float(inferred[0])
                        tool_args["target_y"] = float(inferred[1])
                        tx = float(inferred[0])
                        ty = float(inferred[1])
                        print(
                            f"[TARGET_INFER] robot={rid_raw} "
                            f"target=({inferred[0]:.3f},{inferred[1]:.3f}) "
                            "from relative-pose + target-distance"
                        )
                        logger.info(
                            "target_infer robot=%s target=(%.6f,%.6f) source=pair_goal",
                            rid_raw,
                            inferred[0],
                            inferred[1],
                        )
                    else:
                        inverse_hint: dict[str, Any] | None = None
                        for mv, (rf, d) in latest_pair_goal_by_mover.items():
                            if rf == rid:
                                inverse_hint = {
                                    "recorded_mover_robot_a": mv,
                                    "recorded_reference_robot_b": rf,
                                    "target_distance_m": float(d),
                                }
                                break
                        known_rules = _known_pair_rules_compact()
                        err_payload = {
                            "success": False,
                            "message": "compute_navigation_hint missing target_x/target_y and cannot infer target point",
                            "data": {
                                "robot_id": rid_raw,
                                "tool_args": tool_args,
                                "known_pair_rules": known_rules,
                                "diagnosis": (
                                    "missing mover-bound pair rule for this robot; "
                                    "ensure compute_remaining_distance uses robot_a as mover"
                                ),
                                "suggestion": (
                                    "if user wants to move this robot, call "
                                    "compute_remaining_distance(robot_a=<mover>, robot_b=<reference>, target_distance_m=...)"
                                ),
                                "possible_swapped_order": inverse_hint,
                            },
                        }
                        err_text = json.dumps(err_payload, ensure_ascii=False)
                        result = {
                            "content": [{"type": "text", "text": err_text}],
                            "is_error": False,
                            "structured_content": {"result": err_text},
                        }
                        compact = _compact_mcp_result(result, max_len=(400 if verbose else 160))
                        if verbose:
                            print(f"{exec_label} {p_idx} Step {s_idx}/{len(steps)} MCP> {compact}")
                        else:
                            print(f"  [{s_idx}/{len(steps)}] {_format_step_inline(tool, tool_args)} → {compact}")
                        logger.warning("compute_navigation_hint missing target and infer failed args=%s", tool_args)
                        out.append((phase["name"], step, result))
                        continue
                if rid:
                    locked = target_lock_by_robot.get(rid)
                    if tx is not None and ty is not None:
                        if locked is None:
                            target_lock_by_robot[rid] = (float(tx), float(ty))
                        else:
                            shift = math.hypot(float(tx) - float(locked[0]), float(ty) - float(locked[1]))
                            # 小幅目标抖动视为漂移，保持锁定目标不变；大幅变更才允许切换。
                            if shift <= max(0.20, near_tol * 3.0):
                                if shift > 1e-6:
                                    tool_args = dict(tool_args)
                                    tool_args["target_x"] = float(locked[0])
                                    tool_args["target_y"] = float(locked[1])
                                    print(
                                        f"[TARGET_LOCK] robot={rid_raw} keep_locked_target="
                                        f"({locked[0]:.3f},{locked[1]:.3f}) "
                                        f"instead_of=({float(tx):.3f},{float(ty):.3f})"
                                    )
                                    logger.info(
                                        "target_lock keep robot=%s locked=(%.6f,%.6f) incoming=(%.6f,%.6f)",
                                        rid_raw,
                                        locked[0],
                                        locked[1],
                                        float(tx),
                                        float(ty),
                                    )
                            else:
                                target_lock_by_robot[rid] = (float(tx), float(ty))
                                logger.info(
                                    "target_lock switch robot=%s new=(%.6f,%.6f) old=(%.6f,%.6f)",
                                    rid_raw,
                                    float(tx),
                                    float(ty),
                                    locked[0],
                                    locked[1],
                                )
                result = run_mcp_call(server_spec=server_spec, tool=tool, args=tool_args)
            elif tool == "send_move":
                rid_raw = str(tool_args.get("robot_id", "")).strip()
                rid = rid_raw.upper()
                hint = nav_hint_latest_by_robot.get(rid)
                lv = abs(float(tool_args.get("linear_velocity", 0.0)))
                av = abs(float(tool_args.get("angular_velocity", 0.0)))
                hint_dist = None
                if isinstance(hint, dict):
                    try:
                        hint_dist = float(hint.get("distance_m"))
                    except (TypeError, ValueError):
                        hint_dist = None
                if rid and hint_dist is not None and hint_dist <= near_tol and (lv > 1e-6 or av > 1e-6):
                    executed_action = False
                    guard_payload = {
                        "success": True,
                        "message": "skipped_by_runtime_guard_already_near_target",
                        "data": {
                            "robot_id": rid_raw,
                            "distance_m": hint_dist,
                            "arrival_tolerance_m": near_tol,
                            "skipped_send_move_args": tool_args,
                        },
                    }
                    guard_text = json.dumps(guard_payload, ensure_ascii=False)
                    result = {
                        "content": [{"type": "text", "text": guard_text}],
                        "is_error": False,
                        "structured_content": {"result": guard_text},
                    }
                    msg = (
                        "runtime-guard: skipped send_move because compute_navigation_hint says robot already near target "
                        f"(robot={rid_raw}, distance={hint_dist:.4f}m <= tol={near_tol:.4f}m)"
                    )
                    logger.warning(msg)
                    print(f"[RUNTIME_GUARD] {msg}")
                else:
                    # 强约束：若已出现过 compute_navigation_hint，则 send_move 参数由执行层按 suggested 覆盖。
                    tgt = nav_hint_target_by_robot.get(rid)
                    if rid and isinstance(tgt, dict):
                        mode_rotate = av > 1e-6 and lv <= 1e-6
                        mode_move = lv > 1e-6 and av <= 1e-6
                        hint_now_res = run_mcp_call(
                            server_spec=server_spec,
                            tool="compute_navigation_hint",
                            args={
                                "robot_id": rid_raw,
                                "target_x": float(tgt.get("target_x", 0.0)),
                                "target_y": float(tgt.get("target_y", 0.0)),
                                "max_linear_m_s": float(tgt.get("max_linear_m_s", 0.2)),
                                "max_angular_rad_s": float(tgt.get("max_angular_rad_s", 0.6)),
                            },
                        )
                        hint_now_payload = extract_tool_payload(hint_now_res)
                        hint_now_data = hint_now_payload.get("data") if isinstance(hint_now_payload, dict) else None
                        if hint_now_payload.get("success") and isinstance(hint_now_data, dict):
                            nav_hint_latest_by_robot[rid] = hint_now_data
                            dist_now = float(hint_now_data.get("distance_m", 0.0))
                            if dist_now <= near_tol and (lv > 1e-6 or av > 1e-6):
                                executed_action = False
                                guard_payload = {
                                    "success": True,
                                    "message": "skipped_by_runtime_guard_already_near_target",
                                    "data": {
                                        "robot_id": rid_raw,
                                        "distance_m": dist_now,
                                        "arrival_tolerance_m": near_tol,
                                        "skipped_send_move_args": tool_args,
                                    },
                                }
                                guard_text = json.dumps(guard_payload, ensure_ascii=False)
                                result = {
                                    "content": [{"type": "text", "text": guard_text}],
                                    "is_error": False,
                                    "structured_content": {"result": guard_text},
                                }
                                msg = (
                                    "runtime-guard: skipped send_move because recomputed navigation_hint says robot near target "
                                    f"(robot={rid_raw}, distance={dist_now:.4f}m <= tol={near_tol:.4f}m)"
                                )
                                logger.warning(msg)
                                print(f"[RUNTIME_GUARD] {msg}")
                            else:
                                suggested = hint_now_data.get("suggested") if isinstance(hint_now_data.get("suggested"), dict) else {}
                                rot = suggested.get("rotate") if isinstance(suggested.get("rotate"), dict) else {}
                                mv = suggested.get("move") if isinstance(suggested.get("move"), dict) else {}
                                new_args = dict(tool_args)
                                # 覆盖优先级：
                                # 1) 先判断是否需要旋转 2) 再判断是否可直行 3) 最后微调
                                # 4) 绝对禁止：把“直线移动步骤”强制改成旋转
                                yaw_err_now = abs(float(hint_now_data.get("yaw_error_rad", 0.0)))
                                need_rotate = yaw_err_now > yaw_priority_tol
                                can_move = dist_now > near_tol and not need_rotate
                                need_micro_adjust = dist_now > near_tol and dist_now <= max(0.12, near_tol * 1.2) and not need_rotate
                                if mode_rotate:
                                    if need_rotate:
                                        new_args["linear_velocity"] = 0.0
                                        new_args["angular_velocity"] = float(rot.get("angular_velocity", 0.0))
                                        new_args["duration_ms"] = int(rot.get("duration_ms", 0) or 120)
                                    elif can_move:
                                        # rotate 步骤在无需旋转时直接跳过，让后续 move 步骤负责前进。
                                        executed_action = False
                                        skip_text = json.dumps(
                                            {
                                                "success": True,
                                                "message": "skipped_rotate_not_needed",
                                                "data": {"robot_id": rid_raw, "distance_m": dist_now, "yaw_error_abs": yaw_err_now},
                                            },
                                            ensure_ascii=False,
                                        )
                                        result = {
                                            "content": [{"type": "text", "text": skip_text}],
                                            "is_error": False,
                                            "structured_content": {"result": skip_text},
                                        }
                                    else:
                                        # 微调优先用小时长零速动作占位，避免多余旋转。
                                        new_args["linear_velocity"] = 0.0
                                        new_args["angular_velocity"] = 0.0
                                        new_args["duration_ms"] = 120
                                elif mode_move:
                                    if can_move:
                                        if float(mv.get("linear_velocity", 0.0)) > 1e-6 and int(mv.get("duration_ms", 0) or 0) > 0:
                                            new_args["linear_velocity"] = float(mv.get("linear_velocity", 0.0))
                                            new_args["angular_velocity"] = 0.0
                                            new_args["duration_ms"] = int(mv.get("duration_ms", 180))
                                        else:
                                            step_lin = max(0.05, min(float(tgt.get("max_linear_m_s", 0.2)), dist_now))
                                            new_args["linear_velocity"] = step_lin
                                            new_args["angular_velocity"] = 0.0
                                            new_args["duration_ms"] = int(max(180, min(2500, dist_now / max(0.05, step_lin) * 1000.0)))
                                    elif need_micro_adjust:
                                        # 微调阶段保持直线属性，低速短时移动。
                                        step_lin = max(0.05, min(0.12, dist_now))
                                        new_args["linear_velocity"] = step_lin
                                        new_args["angular_velocity"] = 0.0
                                        new_args["duration_ms"] = int(max(120, min(800, dist_now / max(0.05, step_lin) * 1000.0)))
                                    else:
                                        # 直线步骤遇到“必须先旋转”时，自动插入一次旋转动作（同目标），避免空过。
                                        inj_args = {
                                            "robot_id": rid_raw,
                                            "linear_velocity": 0.0,
                                            "angular_velocity": float(rot.get("angular_velocity", 0.0)),
                                            "duration_ms": int(rot.get("duration_ms", 120) or 120),
                                        }
                                        tool_args = dict(inj_args)
                                        inj_res = run_mcp_call(server_spec=server_spec, tool="send_move", args=tool_args)
                                        inj_payload = {
                                            "success": True,
                                            "message": "auto_injected_rotate_before_move",
                                            "data": {
                                                "robot_id": rid_raw,
                                                "distance_m": dist_now,
                                                "yaw_error_abs": yaw_err_now,
                                                "original_move_args": new_args,
                                                "injected_rotate_args": tool_args,
                                            },
                                        }
                                        result = {
                                            "content": [{"type": "text", "text": json.dumps(inj_payload, ensure_ascii=False)}],
                                            "is_error": False,
                                            "structured_content": {"result": json.dumps(inj_payload, ensure_ascii=False)},
                                        }
                                        print(
                                            f"[RUNTIME_GUARD] injected rotate before move robot={rid_raw} "
                                            f"rotate={json.dumps(tool_args, ensure_ascii=False)}"
                                        )
                                        logger.info(
                                            "runtime-guard injected rotate before move robot=%s move_old=%s rotate=%s result=%s",
                                            rid_raw,
                                            new_args,
                                            tool_args,
                                            json.dumps(inj_res, ensure_ascii=False),
                                        )
                                else:
                                    if need_rotate:
                                        new_args["linear_velocity"] = 0.0
                                        new_args["angular_velocity"] = float(rot.get("angular_velocity", 0.0))
                                        new_args["duration_ms"] = int(rot.get("duration_ms", 120) or 120)
                                    elif can_move or need_micro_adjust:
                                        step_lin = float(mv.get("linear_velocity", 0.0))
                                        if step_lin <= 1e-6:
                                            step_lin = max(0.05, min(float(tgt.get("max_linear_m_s", 0.2)), dist_now))
                                        new_args["linear_velocity"] = step_lin
                                        new_args["angular_velocity"] = 0.0
                                        new_args["duration_ms"] = int(mv.get("duration_ms", 180) or max(180, dist_now / max(0.05, step_lin) * 1000.0))
                                    else:
                                        new_args["linear_velocity"] = 0.0
                                        new_args["angular_velocity"] = 0.0
                                        new_args["duration_ms"] = 120
                                if executed_action:
                                    logger.info(
                                        "runtime-guard override send_move by navigation_hint robot=%s old=%s new=%s",
                                        rid_raw,
                                        tool_args,
                                        new_args,
                                    )
                                    print(
                                        f"[RUNTIME_GUARD] override send_move by hinted strategy robot={rid_raw} "
                                        f"old={json.dumps(tool_args, ensure_ascii=False)} new={json.dumps(new_args, ensure_ascii=False)}"
                                    )
                                    tool_args = new_args
                                    result = run_mcp_call(server_spec=server_spec, tool=tool, args=tool_args)
                        else:
                            result = run_mcp_call(server_spec=server_spec, tool=tool, args=tool_args)
                    else:
                        result = run_mcp_call(server_spec=server_spec, tool=tool, args=tool_args)
            else:
                result = run_mcp_call(server_spec=server_spec, tool=tool, args=tool_args)
            logger.info(
                "%s result p=%s s=%s: %s", exec_label, p_idx, s_idx, json.dumps(result, ensure_ascii=False)
            )
            mlen = 400 if verbose else 160
            compact = _compact_mcp_result(result, max_len=mlen)
            if verbose:
                print(f"{exec_label} {p_idx} Step {s_idx}/{len(steps)} MCP> {compact}")
            else:
                print(f"  [{s_idx}/{len(steps)}] {_format_step_inline(tool, tool_args)} → {compact}")
            if tool == "send_move":
                rid = str(tool_args.get("robot_id", "")).strip()
                av = abs(float(tool_args.get("angular_velocity", 0.0)))
                if executed_action and rid and av > 1e-6:
                    yaw_recent_robots.add(rid.upper())
            if tool == "get_robot_status":
                payload = extract_tool_payload(result)
                data = payload.get("data") if isinstance(payload, dict) else None
                pose = data.get("pose") if isinstance(data, dict) and isinstance(data.get("pose"), dict) else None
                if isinstance(pose, dict):
                    rid_status = str(tool_args.get("robot_id", "")).strip().upper()
                    if rid_status:
                        latest_pose_by_robot[rid_status] = (
                            float(pose.get("x", 0.0)),
                            float(pose.get("y", 0.0)),
                            float(pose.get("yaw", 0.0)),
                        )
            if tool == "get_fleet_status":
                poses_fleet = fleet_poses_from_mcp_result(result)
                for k, v in poses_fleet.items():
                    latest_pose_by_robot[str(k).strip().upper()] = (float(v[0]), float(v[1]), float(v[2]))
            if tool == "compute_navigation_hint":
                payload = extract_tool_payload(result)
                data = payload.get("data") if isinstance(payload, dict) else None
                if isinstance(data, dict):
                    rid_hint = str(data.get("robot_id", "")).strip().upper()
                    if rid_hint:
                        nav_hint_latest_by_robot[rid_hint] = data
                        nav_hint_target_by_robot[rid_hint] = {
                            "target_x": float(tool_args.get("target_x", 0.0)),
                            "target_y": float(tool_args.get("target_y", 0.0)),
                            "max_linear_m_s": float(tool_args.get("max_linear_m_s", 0.2)),
                            "max_angular_rad_s": float(tool_args.get("max_angular_rad_s", 0.6)),
                        }
            if tool == "compute_remaining_distance":
                ra = str(tool_args.get("robot_a", "")).strip().upper()
                rb = str(tool_args.get("robot_b", "")).strip().upper()
                td = _as_float_or_none(tool_args.get("target_distance_m"))
                if ra and rb and td is not None:
                    latest_pair_goal_by_mover[ra] = (rb, float(td))
                pair_key = tuple(sorted([ra, rb]))
                payload = extract_tool_payload(result)
                data = payload.get("data") if isinstance(payload, dict) else None
                if isinstance(payload, dict) and ra and rb and td is not None:
                    payload["rule_binding"] = {
                        "mover_robot_a": ra,
                        "reference_robot_b": rb,
                        "target_distance_m": float(td),
                        "semantic_note": "robot_a is treated as mover in runtime target inference",
                    }
                    payload["known_pair_rules"] = _known_pair_rules_compact()
                    result = _set_tool_payload(result, payload)
                if isinstance(data, dict):
                    cur_d = float(data.get("current_distance_m", 0.0))
                    prev_d = pair_last_distance.get(pair_key)
                    pair_last_distance[pair_key] = cur_d
                    has_recent_yaw = ra in yaw_recent_robots or rb in yaw_recent_robots
                    if has_recent_yaw and prev_d is not None:
                        if cur_d > prev_d + worsen_tol_m:
                            pair_worse_streak_after_yaw[pair_key] = pair_worse_streak_after_yaw.get(pair_key, 0) + 1
                        else:
                            pair_worse_streak_after_yaw[pair_key] = 0
                        if pair_worse_streak_after_yaw.get(pair_key, 0) >= 2:
                            msg = (
                                "runtime-control-loop: distance worsened in two consecutive checks after yaw adjustment "
                                f"for pair={pair_key}, prev={prev_d:.3f}, cur={cur_d:.3f}"
                            )
                            print(f"[RUNTIME_AUDIT] {msg}")
                            logger.warning(msg)
                            raise PlanRuntimeRejected(msg, out)
            if executed_action:
                _wait_and_sync_after_action(tool, tool_args)
            out.append((phase["name"], step, result))
    return out


def _execute_phases_with_runtime_replan(
    *,
    phases: list[dict[str, Any]],
    user_text: str,
    args: argparse.Namespace,
    api_key: str,
    model: str,
    exec_label: str,
    terminal_header: str,
) -> list[tuple[str, dict[str, Any], dict[str, Any]]]:
    """
    执行阶段并在运行时审计拒绝时触发一次 LLM 重规划后重执行。

    @param phases: 初始阶段
    @param user_text: 用户输入
    @param args: 客户端参数
    @param api_key: LLM key
    @param model: LLM model
    @param exec_label: 执行标签
    @param terminal_header: 重规划打印头
    @returns: 最终执行结果
    """

    try:
        return _execute_phases_collect_results(
            phases,
            action_wait_mode=args.action_wait_mode,
            action_settle_extra_ms=int(args.action_settle_extra_ms),
            action_sync_timeout_ms=int(args.action_sync_timeout_ms),
            action_sync_poll_ms=int(args.action_sync_poll_ms),
            action_stable_pos_delta_m=float(args.action_stable_pos_delta_m),
            action_stable_yaw_delta_rad=float(args.action_stable_yaw_delta_rad),
            action_stable_linear_speed_mps=float(args.action_stable_linear_speed_mps),
            action_stable_angular_speed_radps=float(args.action_stable_angular_speed_radps),
            action_stable_required_polls=int(args.action_stable_required_polls),
            arrival_tolerance_m=float(args.closed_loop_tolerance_m),
            control_yaw_tolerance_rad=float(args.closed_loop_yaw_tol_rad),
            server_spec=args.server_spec,
            verbose=args.verbose,
            exec_label=exec_label,
        )
    except PlanRuntimeRejected as e:
        print(f"[RUNTIME_AUDIT] 拒绝原计划并重规划: {e}")
        replan_input = build_action_replan_input(
            user_text=user_text,
            executed_phases=phases,
            observed_results=e.observed_results,
        )
        replan = call_deepseek(
            api_key=api_key,
            model=model,
            user_text=replan_input,
            connect_timeout_s=float(args.llm_connect_timeout_s),
            read_timeout_s=float(args.llm_read_timeout_s),
        )
        rp = normalize_plan_phases(replan)
        _emit_plan_preamble(
            replan,
            rp,
            verbose=args.verbose,
            log_event=f"LLM runtime replan {exec_label}",
            terminal_header=terminal_header,
        )
        rp, _ = _audit_phases_degenerate_or_replan(user_text, replan, rp, args=args, api_key=api_key, model=model)
        if rp is None:
            print("[RUNTIME_AUDIT] 重规划未通过审计，终止本轮执行。")
            return e.observed_results
        return _execute_phases_collect_results(
            rp,
            action_wait_mode=args.action_wait_mode,
            action_settle_extra_ms=int(args.action_settle_extra_ms),
            action_sync_timeout_ms=int(args.action_sync_timeout_ms),
            action_sync_poll_ms=int(args.action_sync_poll_ms),
            action_stable_pos_delta_m=float(args.action_stable_pos_delta_m),
            action_stable_yaw_delta_rad=float(args.action_stable_yaw_delta_rad),
            action_stable_linear_speed_mps=float(args.action_stable_linear_speed_mps),
            action_stable_angular_speed_radps=float(args.action_stable_angular_speed_radps),
            action_stable_required_polls=int(args.action_stable_required_polls),
            arrival_tolerance_m=float(args.closed_loop_tolerance_m),
            control_yaw_tolerance_rad=float(args.closed_loop_yaw_tol_rad),
            server_spec=args.server_spec,
            verbose=args.verbose,
            exec_label=exec_label,
        )


def _audit_phases_degenerate_or_replan(
    user_text: str,
    plan: dict[str, Any],
    phases: list[dict[str, Any]],
    *,
    args: argparse.Namespace,
    api_key: str,
    model: str,
) -> tuple[list[dict[str, Any]] | None, dict[str, Any]]:
    """
    执行前退化运动审计；不通过时最多一次 LLM replan。若仍失败则返回 phases=None。

    @param user_text: 用户原始输入（审计 replan 提示用）
    @param plan: 当前 LLM 计划 JSON
    @param phases: 已 normalize 的阶段列表
    @param args: 客户端参数
    @param api_key: LLM API Key
    @param model: 模型名
    @returns: (可执行 phases 或 None, 最新的 plan dict)
    """

    if args.dry_run or args.no_plan_audit:
        return phases, plan

    def _run_tool(tool: str, tool_args: dict[str, Any]) -> dict[str, Any]:
        return run_mcp_call(server_spec=args.server_spec, tool=tool, args=tool_args)

    audit_issues: list[str] = []
    current_plan = plan
    current_phases = phases
    for attempt in range(2):
        geo_issues = audit_phases_identical_send_move_when_colocated(current_phases, _run_tool)
        ctl_issues = audit_phases_control_loop_structure(current_phases)
        audit_issues = geo_issues + ctl_issues
        if not audit_issues:
            break
        for iss in audit_issues:
            logger.warning("plan_audit: %s", iss)
            print(f"[PLAN_AUDIT] {iss}")
        if attempt == 1:
            print(
                "[ERROR] 规划未通过退化校验（同构 send_move + 同一位姿）；"
                "已中止本次执行。可使用 --no-plan-audit 跳过（不推荐）。"
            )
            break
        replan_input = build_plan_audit_replan_prompt(user_text, current_phases, audit_issues)
        current_plan = call_deepseek(
            api_key=api_key,
            model=model,
            user_text=replan_input,
            connect_timeout_s=float(args.llm_connect_timeout_s),
            read_timeout_s=float(args.llm_read_timeout_s),
        )
        current_phases = normalize_plan_phases(current_plan)
        _emit_plan_preamble(
            current_plan,
            current_phases,
            verbose=args.verbose,
            log_event="LLM plan after audit replan",
            terminal_header="Plan(audit-fix)",
        )
    if audit_issues:
        return None, current_plan
    return current_phases, current_plan


def _compact_mcp_result(result: dict[str, Any], max_len: int = 380) -> str:
    """
    将 MCP 返回压缩为可读摘要，避免大 JSON 在终端重复刷屏。

    @param result: run_mcp_call 的返回
    @param max_len: 最大展示长度
    @returns: 摘要文本
    """

    raw = extract_tool_json_string(result)
    txt = raw if raw else json.dumps(result, ensure_ascii=False)
    if len(txt) > max_len:
        return txt[:max_len] + "...(truncated)"
    return txt


def _pick_first_n_unit_ids_from_fleet(args: argparse.Namespace, n: int) -> list[str]:
    """
    从 get_fleet_status 结果中取前 N 个 unit_id。

    @param args: 客户端参数
    @param n: 需要的数量
    @returns: unit_id 列表
    """

    res = run_mcp_call(server_spec=args.server_spec, tool="get_fleet_status", args={"robot_ids_csv": ""})
    payload = extract_tool_payload(res)
    data = payload.get("data") if isinstance(payload, dict) else None
    items = data.get("items") if isinstance(data, dict) else None
    out: list[str] = []
    if isinstance(items, list):
        for it in items:
            if not isinstance(it, dict):
                continue
            d = it.get("data")
            if isinstance(d, dict):
                uid = d.get("unit_id")
                if isinstance(uid, str) and uid.strip():
                    out.append(uid.strip())
    return out[: max(0, n)]


def _fetch_pose(args: argparse.Namespace, robot_id: str) -> dict[str, float] | None:
    """
    获取机器人 pose（x/y/yaw）；失败返回 None。

    @param args: 客户端参数
    @param robot_id: 机器人 ID
    @returns: {"x","y","yaw"} 或 None
    """

    res = run_mcp_call(server_spec=args.server_spec, tool="get_robot_status", args={"robot_id": robot_id})
    payload = extract_tool_payload(res)
    data = payload.get("data") if isinstance(payload, dict) else None
    if not payload.get("success") or not isinstance(data, dict):
        return None
    pose = data.get("pose") if isinstance(data.get("pose"), dict) else None
    if not isinstance(pose, dict):
        return None
    if not isinstance(pose.get("x"), (int, float)) or not isinstance(pose.get("y"), (int, float)):
        return None
    return {"x": float(pose["x"]), "y": float(pose["y"]), "yaw": float(pose.get("yaw", 0.0))}


def _triangle_area2(pa: dict[str, float], pb: dict[str, float], pc: dict[str, float]) -> float:
    """@returns: 三角形面积的 2 倍绝对值（cross magnitude）"""

    return abs((pb["x"] - pa["x"]) * (pc["y"] - pa["y"]) - (pb["y"] - pa["y"]) * (pc["x"] - pa["x"]))


def _normalize_angle(rad: float) -> float:
    """@returns: 归一化到 [-pi, pi] 的角度"""

    while rad > math.pi:
        rad -= 2.0 * math.pi
    while rad < -math.pi:
        rad += 2.0 * math.pi
    return rad


def _yaw_error_to_target(p_move: dict[str, float], p_ref: dict[str, float], move_toward: bool) -> float:
    """
    计算 move 车需要朝向的目标航向误差。

    @param p_move: move 车 pose
    @param p_ref: ref 车 pose
    @param move_toward: True=朝向 ref，False=背离 ref
    @returns: yaw_error = desired - current（已归一化）
    """

    dx = p_ref["x"] - p_move["x"]
    dy = p_ref["y"] - p_move["y"]
    desired = math.atan2(dy, dx)
    if not move_toward:
        desired = _normalize_angle(desired + math.pi)
    return _normalize_angle(desired - p_move["yaw"])


def _is_two_edge_oscillation(history: list[str]) -> bool:
    """
    检测最近 4 轮是否出现 A-B-A-B 型边振荡。

    @param history: 误差最大边历史（如 "GV1-GV3"）
    @returns: 是否出现双边来回切换
    """

    if len(history) < 4:
        return False
    a, b, c, d = history[-4], history[-3], history[-2], history[-1]
    return a == c and b == d and a != b


def _template_wait_after_move(args: argparse.Namespace, *, duration_ms: int) -> None:
    """
    模板闭环中的动作后等待（执行层时序控制，不依赖 LLM 猜测等待时间）。

    @param args: 客户端参数
    @param duration_ms: 当前动作持续时间
    """

    if str(getattr(args, "action_wait_mode", "auto")) != "auto":
        return
    settle_ms = int(getattr(args, "action_settle_extra_ms", 300))
    wait_s = max(0.0, float(duration_ms + max(0, settle_ms)) / 1000.0)
    if wait_s > 0:
        time.sleep(wait_s)


def run_closed_loop_point_template(
    *,
    args: argparse.Namespace,
    robot_id: str,
    target_x: float,
    target_y: float,
    max_iters_override: int | None = None,
) -> None:
    """
    点位闭环模板：基于目标点导航提示自动推导速度，小步迭代到目标点。

    该模板用于“到具体点位”场景，强调执行层确定性控制：
    get_robot_status -> compute_navigation_hint -> send_move(rotate|move) -> 重复。

    @param args: 客户端参数
    @param robot_id: 被控制机器人
    @param target_x: 目标 x
    @param target_y: 目标 y
    @param max_iters_override: 可选迭代上限覆盖（None 使用全局参数）
    """

    tol_pos = max(0.02, float(args.closed_loop_tolerance_m))
    yaw_tol = max(0.02, float(args.closed_loop_yaw_tol_rad))
    speed = max(0.05, abs(float(args.closed_loop_speed_mps)))
    turn_speed = max(0.2, abs(float(args.closed_loop_turn_radps)))
    max_iters_cfg = max(1, int(max_iters_override if max_iters_override is not None else args.closed_loop_max_iters))
    init_hint_res = run_mcp_call(
        server_spec=args.server_spec,
        tool="compute_navigation_hint",
        args={
            "robot_id": robot_id,
            "target_x": float(target_x),
            "target_y": float(target_y),
            "max_linear_m_s": float(speed),
            "max_angular_rad_s": float(turn_speed),
        },
    )
    init_hint_payload = extract_tool_payload(init_hint_res)
    init_data = init_hint_payload.get("data") if isinstance(init_hint_payload, dict) else None
    init_dist = float(init_data.get("distance_m", 0.0)) if isinstance(init_data, dict) else 0.0
    init_yaw = abs(float(init_data.get("yaw_error_rad", 0.0))) if isinstance(init_data, dict) else 0.0
    rotate_iters_est = int(math.ceil(max(0.0, init_yaw - yaw_tol) / 0.7))
    move_iters_est = int(math.ceil(max(0.0, init_dist - tol_pos) / 0.35))
    adaptive_min_iters = max(2, rotate_iters_est + move_iters_est + 2)
    max_iters = min(60, max(max_iters_cfg, adaptive_min_iters))
    print(
        "Template> closed_loop_point "
        f"robot={robot_id} target=({target_x:.3f},{target_y:.3f}) "
        f"pos_tol={tol_pos} yaw_tol={yaw_tol} max_iters={max_iters} "
        f"(cfg={max_iters_cfg}, adaptive_min={adaptive_min_iters})"
    )
    for it in range(1, max_iters + 1):
        hint_res = run_mcp_call(
            server_spec=args.server_spec,
            tool="compute_navigation_hint",
            args={
                "robot_id": robot_id,
                "target_x": float(target_x),
                "target_y": float(target_y),
                "max_linear_m_s": float(speed),
                "max_angular_rad_s": float(turn_speed),
            },
        )
        hint_payload = extract_tool_payload(hint_res)
        data = hint_payload.get("data") if isinstance(hint_payload, dict) else None
        if not hint_payload.get("success") or not isinstance(data, dict):
            print(f"[WARN] point template failed to get navigation hint for {robot_id}, stop.")
            return
        pose = data.get("current_pose") if isinstance(data.get("current_pose"), dict) else {}
        px = float(pose.get("x", 0.0))
        py = float(pose.get("y", 0.0))
        pyaw = float(pose.get("yaw", 0.0))
        dist = float(data.get("distance_m", 0.0))
        yaw_err = float(data.get("yaw_error_rad", 0.0))
        if dist <= tol_pos:
            print(f"Converged> {robot_id} reached target within {tol_pos}m.")
            return
        print(
            f"Point Iter {it}/{max_iters}> pose=({px:.3f},{py:.3f},{pyaw:.3f}) "
            f"target=({target_x:.3f},{target_y:.3f}) dist={dist:.3f} yaw_err={yaw_err:.3f}"
        )
        suggested = data.get("suggested") if isinstance(data.get("suggested"), dict) else {}
        rot = suggested.get("rotate") if isinstance(suggested.get("rotate"), dict) else {}
        mv = suggested.get("move") if isinstance(suggested.get("move"), dict) else {}
        if abs(yaw_err) > yaw_tol:
            rotate_ms = max(120, int(float(rot.get("duration_ms", 0)) or 120))
            angular_velocity = float(rot.get("angular_velocity", 0.0))
            rot_args = {
                "robot_id": robot_id,
                "linear_velocity": 0.0,
                "angular_velocity": angular_velocity if abs(angular_velocity) > 1e-6 else (turn_speed if yaw_err > 0 else -turn_speed),
                "duration_ms": rotate_ms,
            }
            res_rot = run_mcp_call(server_spec=args.server_spec, tool="send_move", args=rot_args)
            print(f"  rotate> {_compact_mcp_result(res_rot)}")
            _template_wait_after_move(args, duration_ms=rotate_ms)
            continue

        move_ms = max(180, int(float(mv.get("duration_ms", 0)) or 180))
        linear_velocity = float(mv.get("linear_velocity", 0.0))
        mv_args = {
            "robot_id": robot_id,
            "linear_velocity": linear_velocity if linear_velocity > 1e-6 else min(speed, max(0.05, dist)),
            "angular_velocity": 0.0,
            "duration_ms": move_ms,
        }
        res_mv = run_mcp_call(server_spec=args.server_spec, tool="send_move", args=mv_args)
        print(f"  move> {_compact_mcp_result(res_mv)}")
        _template_wait_after_move(args, duration_ms=move_ms)
    print("[WARN] closed-loop point reached max iterations without convergence.")


def run_single_mover_distance_template(
    *,
    args: argparse.Namespace,
    mover_robot_id: str,
    reference_robot_id: str,
    target_distance_m: float,
) -> bool:
    """
    单移动方距离闭环模板（确定性微循环，不依赖 LLM 反复重规划）。

    微循环：
    get_fleet_status -> compute_remaining_distance -> compute_navigation_hint -> send_move -> verify

    @param args: 客户端参数
    @param mover_robot_id: 移动车（仅此车执行动作）
    @param reference_robot_id: 参照车（本微循环默认不动）
    @param target_distance_m: 目标间距（米）
    @returns: True=达标；False=未达标或中途失败
    """

    tol_d = max(0.05, float(args.completion_tolerance_m))
    yaw_tol = max(0.02, float(args.closed_loop_yaw_tol_rad))
    speed = max(0.05, abs(float(args.closed_loop_speed_mps)))
    turn_speed = max(0.2, abs(float(args.closed_loop_turn_radps)))
    max_iters = max(4, min(80, int(args.closed_loop_max_iters) * 3))
    print(
        "Template> single_mover_distance "
        f"mover={mover_robot_id} ref={reference_robot_id} target_distance={target_distance_m:.3f}m "
        f"tol={tol_d:.3f} max_iters={max_iters}"
    )
    for it in range(1, max_iters + 1):
        fleet_res = run_mcp_call(server_spec=args.server_spec, tool="get_fleet_status", args={"robot_ids_csv": ""})
        _ = fleet_res  # 明确保留全局观测步骤（供日志/后续扩展）
        rem_res = run_mcp_call(
            server_spec=args.server_spec,
            tool="compute_remaining_distance",
            args={
                "robot_a": mover_robot_id,
                "robot_b": reference_robot_id,
                "target_distance_m": float(target_distance_m),
            },
        )
        rem_payload = extract_tool_payload(rem_res)
        rem_data = rem_payload.get("data") if isinstance(rem_payload, dict) else None
        if not rem_payload.get("success") or not isinstance(rem_data, dict):
            print("[WARN] single_mover_distance failed to compute remaining distance, stop.")
            return False
        cur_d = float(rem_data.get("current_distance_m", 0.0))
        rem_d = float(rem_data.get("remaining_distance_m", 0.0))
        print(
            f"Distance Iter {it}/{max_iters}> mover={mover_robot_id} ref={reference_robot_id} "
            f"current={cur_d:.3f}m remaining={rem_d:.3f}m"
        )
        if abs(rem_d) <= tol_d:
            run_mcp_call(server_spec=args.server_spec, tool="stop_robot", args={"robot_id": mover_robot_id})
            print(f"Converged> pair distance within ±{tol_d:.3f}m.")
            return True
        p_move = _fetch_pose(args, mover_robot_id)
        p_ref = _fetch_pose(args, reference_robot_id)
        if p_move is None or p_ref is None:
            print("[WARN] single_mover_distance missing pose, stop.")
            return False
        dx = float(p_ref["x"]) - float(p_move["x"])
        dy = float(p_ref["y"]) - float(p_move["y"])
        norm = math.hypot(dx, dy)
        if norm < 1e-6:
            ux, uy = math.cos(float(p_ref.get("yaw", 0.0))), math.sin(float(p_ref.get("yaw", 0.0)))
        else:
            ux, uy = dx / norm, dy / norm
        target_x = float(p_ref["x"]) - ux * float(target_distance_m)
        target_y = float(p_ref["y"]) - uy * float(target_distance_m)
        hint_res = run_mcp_call(
            server_spec=args.server_spec,
            tool="compute_navigation_hint",
            args={
                "robot_id": mover_robot_id,
                "target_x": target_x,
                "target_y": target_y,
                "max_linear_m_s": float(speed),
                "max_angular_rad_s": float(turn_speed),
            },
        )
        hint_payload = extract_tool_payload(hint_res)
        hint_data = hint_payload.get("data") if isinstance(hint_payload, dict) else None
        if not hint_payload.get("success") or not isinstance(hint_data, dict):
            print("[WARN] single_mover_distance failed to get navigation hint, stop.")
            return False
        yaw_err = float(hint_data.get("yaw_error_rad", 0.0))
        suggested = hint_data.get("suggested") if isinstance(hint_data.get("suggested"), dict) else {}
        rot = suggested.get("rotate") if isinstance(suggested.get("rotate"), dict) else {}
        mv = suggested.get("move") if isinstance(suggested.get("move"), dict) else {}
        if abs(yaw_err) > yaw_tol:
            rotate_ms = max(120, int(float(rot.get("duration_ms", 0)) or 120))
            rotate_av = float(rot.get("angular_velocity", 0.0))
            rot_args = {
                "robot_id": mover_robot_id,
                "linear_velocity": 0.0,
                "angular_velocity": rotate_av if abs(rotate_av) > 1e-6 else (turn_speed if yaw_err > 0 else -turn_speed),
                "duration_ms": rotate_ms,
            }
            res_rot = run_mcp_call(server_spec=args.server_spec, tool="send_move", args=rot_args)
            print(f"  rotate> {_compact_mcp_result(res_rot)}")
            _template_wait_after_move(args, duration_ms=rotate_ms)
            continue
        move_ms = max(180, int(float(mv.get("duration_ms", 0)) or 180))
        move_lv = float(mv.get("linear_velocity", 0.0))
        mv_args = {
            "robot_id": mover_robot_id,
            "linear_velocity": move_lv if move_lv > 1e-6 else min(speed, max(0.05, abs(rem_d))),
            "angular_velocity": 0.0,
            "duration_ms": move_ms,
        }
        res_mv = run_mcp_call(server_spec=args.server_spec, tool="send_move", args=mv_args)
        print(f"  move> {_compact_mcp_result(res_mv)}")
        _template_wait_after_move(args, duration_ms=move_ms)
    run_mcp_call(server_spec=args.server_spec, tool="stop_robot", args={"robot_id": mover_robot_id})
    print("[WARN] single_mover_distance reached max iterations without convergence.")
    return False


def run_single_robot_route_template(
    *,
    args: argparse.Namespace,
    route: RobotRoutePlan,
) -> bool:
    """
    执行单机器人多目标点路线（严格顺序门禁）。

    规则：
    - 前一目标点未达标，不进入下一目标点；
    - 每个 waypoint 执行后用 compute_navigation_hint 做硬验收。

    @param args: 客户端参数
    @param route: 路线计划
    @returns: True=全部 waypoint 达标；False=中途失败或未达标
    """

    if not route.waypoints:
        return True
    print(
        f"Template> single_robot_route robot={route.robot_id} "
        f"waypoints={route.waypoints} tol={route.tolerance_m}"
    )
    for idx in range(route.current_index, len(route.waypoints)):
        tx, ty = route.waypoints[idx]
        print(f"Route Waypoint {idx + 1}/{len(route.waypoints)}> target=({tx:.3f},{ty:.3f})")
        run_closed_loop_point_template(args=args, robot_id=route.robot_id, target_x=tx, target_y=ty)
        chk = run_mcp_call(
            server_spec=args.server_spec,
            tool="compute_navigation_hint",
            args={
                "robot_id": route.robot_id,
                "target_x": float(tx),
                "target_y": float(ty),
                "max_linear_m_s": float(args.closed_loop_speed_mps),
                "max_angular_rad_s": float(args.closed_loop_turn_radps),
            },
        )
        payload = extract_tool_payload(chk)
        data = payload.get("data") if isinstance(payload, dict) else None
        if not payload.get("success") or not isinstance(data, dict):
            print(f"[ERROR] route waypoint {idx + 1} verification failed.")
            return False
        dist = float(data.get("distance_m", 1e9))
        if dist > float(route.tolerance_m):
            print(
                f"[ERROR] route gate blocked: waypoint {idx + 1} not reached "
                f"(distance={dist:.3f}m > tol={route.tolerance_m:.3f}m)."
            )
            return False
        route.current_index = idx + 1
        run_mcp_call(server_spec=args.server_spec, tool="stop_robot", args={"robot_id": route.robot_id})
    print("Converged> single_robot_route all waypoints reached.")
    return True


def assign_targets_min_total_cost(
    robot_poses: dict[str, dict[str, float]],
    targets: list[tuple[float, float]],
) -> dict[str, tuple[float, float]]:
    """
    对机器人与目标点做最小总位移分配（小规模精确，超小规模足够）。

    @param robot_poses: {robot_id: {"x","y","yaw"}}
    @param targets: 目标点列表
    @returns: {robot_id: (target_x, target_y)}
    """

    ids = list(robot_poses.keys())
    if not ids or not targets or len(ids) != len(targets):
        return {}
    best_map: dict[str, tuple[float, float]] = {}
    best_cost = float("inf")
    for perm in itertools.permutations(targets, len(ids)):
        cost = 0.0
        cur: dict[str, tuple[float, float]] = {}
        for rid, tgt in zip(ids, perm):
            px, py = float(robot_poses[rid]["x"]), float(robot_poses[rid]["y"])
            cost += math.hypot(tgt[0] - px, tgt[1] - py)
            cur[rid] = tgt
        if cost < best_cost:
            best_cost = cost
            best_map = cur
    return best_map


def plan_line_targets_with_assignment(
    robot_poses: dict[str, dict[str, float]],
    *,
    spacing_m: float,
) -> dict[str, tuple[float, float]]:
    """
    生成“固定线轴 + 前后位点”目标并进行最小位移分配。

    线轴定义：取锚点（第一个机器人）当前 yaw。
    位点定义：以锚点为中心，按 spacing 等间距分布 N 个槽位。

    @param robot_poses: {robot_id: {"x","y","yaw"}}
    @param spacing_m: 目标间距
    @returns: {robot_id: (target_x, target_y)}
    """

    ids = list(robot_poses.keys())
    if len(ids) < 2:
        return {}
    anchor = ids[0]
    pa = robot_poses[anchor]
    ax, ay = float(pa["x"]), float(pa["y"])
    yaw = float(pa.get("yaw", 0.0))
    ux, uy = math.cos(yaw), math.sin(yaw)
    n = len(ids)
    half = (n - 1) / 2.0
    targets: list[tuple[float, float]] = []
    for i in range(n):
        off = (i - half) * float(spacing_m)
        targets.append((ax + off * ux, ay + off * uy))
    return assign_targets_min_total_cost(robot_poses, targets)


def plan_line_targets_with_constraints(
    robot_poses: dict[str, dict[str, float]],
    *,
    spacing_m: float,
    baseline_y: float | None = None,
    baseline_x: float | None = None,
) -> dict[str, tuple[float, float]]:
    """
    按显式基准线约束生成直线目标点（优先 baseline_y / baseline_x）。

    @param robot_poses: {robot_id: {"x","y","yaw"}}
    @param spacing_m: 目标间距
    @param baseline_y: 若给定，生成 y=baseline_y 的水平直线目标
    @param baseline_x: 若给定，生成 x=baseline_x 的竖直直线目标
    @returns: {robot_id: (target_x, target_y)}
    """

    ids = list(robot_poses.keys())
    if len(ids) < 2:
        return {}
    n = len(ids)
    half = (n - 1) / 2.0
    targets: list[tuple[float, float]] = []
    if isinstance(baseline_y, (int, float)):
        cx = sum(float(robot_poses[r]["x"]) for r in ids) / float(n)
        for i in range(n):
            off = (i - half) * float(spacing_m)
            targets.append((cx + off, float(baseline_y)))
        return assign_targets_min_total_cost(robot_poses, targets)
    if isinstance(baseline_x, (int, float)):
        cy = sum(float(robot_poses[r]["y"]) for r in ids) / float(n)
        for i in range(n):
            off = (i - half) * float(spacing_m)
            targets.append((float(baseline_x), cy + off))
        return assign_targets_min_total_cost(robot_poses, targets)
    return plan_line_targets_with_assignment(robot_poses, spacing_m=spacing_m)


def run_line_vertex_assignment_closed_loop_template(
    *,
    args: argparse.Namespace,
    robots: list[str],
    spacing_m: float,
    fixed_targets_override: dict[str, tuple[float, float]] | None = None,
) -> None:
    """
    直线编队闭环（线轴+位点分配）：固定参考系后，每轮调度误差最大的前 K 台机器人。

    @param args: 客户端参数
    @param robots: 机器人列表（至少 2）
    @param spacing_m: 相邻间距
    @param fixed_targets_override: 可选外部固定目标点（若给定则不再内部生成）
    """

    ids = list(robots)
    if len(ids) < 2:
        print("[WARN] line vertex template requires at least 2 robots.")
        return
    tol = max(0.0, float(args.closed_loop_tolerance_m))
    print(
        "Template> line_vertex_assignment "
        f"robots={ids} spacing={spacing_m}m tol={tol} max_iters={args.closed_loop_max_iters}"
    )
    initial_poses: dict[str, dict[str, float]] = {}
    for rid in ids:
        p0 = _fetch_pose(args, rid)
        if p0 is None:
            print(f"[WARN] line vertex template failed to fetch initial pose for {rid}.")
            return
        initial_poses[rid] = p0
    # 冻结一次目标点：避免每轮重建目标导致参考系漂移。
    targets_fixed = fixed_targets_override if fixed_targets_override else plan_line_targets_with_assignment(
        initial_poses, spacing_m=spacing_m
    )
    if not targets_fixed:
        print("[WARN] line target assignment failed at init.")
        return
    print(
        "Line Targets Frozen> "
        + ", ".join([f"{rid}=({targets_fixed[rid][0]:.3f},{targets_fixed[rid][1]:.3f})" for rid in ids if rid in targets_fixed])
    )
    max_batch = max(1, int(getattr(args, "max_concurrent_robots", 1)))
    for it in range(1, max(1, int(args.closed_loop_max_iters)) + 1):
        poses: dict[str, dict[str, float]] = {}
        for rid in ids:
            p = _fetch_pose(args, rid)
            if p is None:
                print(f"[WARN] line vertex template failed to fetch pose for {rid}.")
                return
            poses[rid] = p
        errs = {
            rid: math.hypot(targets_fixed[rid][0] - poses[rid]["x"], targets_fixed[rid][1] - poses[rid]["y"])
            for rid in ids
            if rid in targets_fixed
        }
        if len(errs) != len(ids):
            print("[WARN] line target assignment missing robot targets, stop.")
            return
        max_err = max(errs.values())
        print(f"Line Iter {it}> point_err={{{', '.join([f'{k}:{v:.3f}' for k, v in errs.items()])}}} max={max_err:.4f}")
        if max_err <= tol:
            print("Converged> all robots near assigned line targets.")
            return
        active_ids = [rid for rid in ids if errs[rid] > tol]
        if not active_ids:
            print("Converged> all robots near assigned line targets.")
            return
        move_ids = sorted(active_ids, key=lambda r: errs[r], reverse=True)[:max_batch]
        print(
            f"Line Iter {it} Batch> selected={move_ids} "
            f"(active={len(active_ids)} max_batch={max_batch})"
        )
        for rid_move in move_ids:
            tx, ty = targets_fixed[rid_move]
            px, py, pyaw = poses[rid_move]["x"], poses[rid_move]["y"], poses[rid_move]["yaw"]
            desired = math.atan2(ty - py, tx - px)
            yaw_err = _normalize_angle(desired - pyaw)
            print(
                f"Line Iter {it} Decision> move={rid_move} target=({tx:.3f},{ty:.3f}) "
                f"dist={errs[rid_move]:.3f} yaw_err={yaw_err:.3f}"
            )
            # 批次调度下每轮仅做短闭环，避免某一台车长时间独占执行窗口。
            run_closed_loop_point_template(
                args=args,
                robot_id=rid_move,
                target_x=tx,
                target_y=ty,
                max_iters_override=2,
            )
            run_mcp_call(server_spec=args.server_spec, tool="stop_robot", args={"robot_id": rid_move})
    print("[WARN] line vertex-assignment template reached max iterations without convergence.")


def plan_triangle_targets_with_assignment(
    robot_poses: dict[str, dict[str, float]],
    *,
    side_length_m: float,
) -> dict[str, tuple[float, float]]:
    """
    根据当前三车位姿生成等边三角形目标顶点，并做最小位移分配。

    几何策略：
    - 锚点固定为第一个机器人当前位姿；
    - 朝向取锚点到最近邻机器人方向（退化时回退锚点 yaw）；
    - 生成 ±60° 两组候选顶点；
    - 对 3! 分配求最小总位移。

    @param robot_poses: {robot_id: {"x","y","yaw"}}
    @param side_length_m: 目标边长
    @returns: {robot_id: (target_x, target_y)}
    """

    ids = list(robot_poses.keys())[:3]
    if len(ids) < 3:
        return {}
    anchor = ids[0]
    pa = robot_poses[anchor]
    ax, ay = float(pa["x"]), float(pa["y"])
    others = ids[1:]
    nearest = min(
        others,
        key=lambda r: math.hypot(float(robot_poses[r]["x"]) - ax, float(robot_poses[r]["y"]) - ay),
    )
    dx = float(robot_poses[nearest]["x"]) - ax
    dy = float(robot_poses[nearest]["y"]) - ay
    heading = math.atan2(dy, dx) if math.hypot(dx, dy) > 1e-6 else float(pa.get("yaw", 0.0))

    def _targets(sign: float) -> list[tuple[float, float]]:
        b = (ax + side_length_m * math.cos(heading), ay + side_length_m * math.sin(heading))
        h2 = heading + sign * (math.pi / 3.0)
        c = (ax + side_length_m * math.cos(h2), ay + side_length_m * math.sin(h2))
        return [(ax, ay), b, c]

    best_map: dict[str, tuple[float, float]] = {}
    best_cost = float("inf")
    for sign in (1.0, -1.0):
        tgts = _targets(sign)
        cur_map = assign_targets_min_total_cost({rid: robot_poses[rid] for rid in ids}, tgts)
        if not cur_map:
            continue
        cost = 0.0
        for rid, tgt in cur_map.items():
            px, py = float(robot_poses[rid]["x"]), float(robot_poses[rid]["y"])
            cost += math.hypot(tgt[0] - px, tgt[1] - py)
        if cost < best_cost:
            best_cost = cost
            best_map = cur_map
    return best_map


def run_triangle_vertex_assignment_closed_loop_template(
    *,
    args: argparse.Namespace,
    robots: list[str],
    side_length_m: float,
) -> None:
    """
    三角形闭环（顶点分配版）：每轮只移动一台误差最大机器人，先转向再直行。

    @param args: 客户端参数
    @param robots: 机器人 ID 列表（至少 3）
    @param side_length_m: 目标边长
    """

    ids = robots[:3]
    if len(ids) < 3:
        print("[WARN] triangle vertex template requires 3 robots.")
        return
    tol = max(0.0, float(args.closed_loop_tolerance_m))
    print(
        "Template> triangle_vertex_assignment "
        f"robots={ids} side={side_length_m}m tol={tol} max_iters={args.closed_loop_max_iters}"
    )
    for it in range(1, max(1, int(args.closed_loop_max_iters)) + 1):
        poses: dict[str, dict[str, float]] = {}
        for rid in ids:
            p = _fetch_pose(args, rid)
            if p is None:
                print(f"[WARN] triangle vertex template failed to fetch pose for {rid}.")
                return
            poses[rid] = p

        pairs = [(ids[0], ids[1]), (ids[1], ids[2]), (ids[0], ids[2])]
        errs: list[float] = []
        for a, b in pairs:
            d = math.hypot(float(poses[a]["x"]) - float(poses[b]["x"]), float(poses[a]["y"]) - float(poses[b]["y"]))
            errs.append(abs(d - side_length_m))
        max_err = max(errs)
        print(f"Triangle Iter {it}> edge_abs_err={errs} max={max_err:.4f}")
        if max_err <= tol:
            print("Converged> triangle edges within tolerance.")
            return

        targets = plan_triangle_targets_with_assignment(poses, side_length_m=side_length_m)
        if not targets:
            print("[WARN] triangle target assignment failed.")
            return
        rid_move = max(
            ids,
            key=lambda r: math.hypot(targets[r][0] - float(poses[r]["x"]), targets[r][1] - float(poses[r]["y"])),
        )
        tx, ty = targets[rid_move]
        px, py, pyaw = float(poses[rid_move]["x"]), float(poses[rid_move]["y"]), float(poses[rid_move]["yaw"])
        desired = math.atan2(ty - py, tx - px)
        yaw_err = _normalize_angle(desired - pyaw)
        dist = math.hypot(tx - px, ty - py)
        print(
            f"Triangle Iter {it} Decision> move={rid_move} target=({tx:.3f},{ty:.3f}) "
            f"dist={dist:.3f} yaw_err={yaw_err:.3f}"
        )
        run_closed_loop_point_template(
            args=args,
            robot_id=rid_move,
            target_x=tx,
            target_y=ty,
            max_iters_override=max(2, int(args.closed_loop_max_iters)),
        )
        run_mcp_call(server_spec=args.server_spec, tool="stop_robot", args={"robot_id": rid_move})
    print("[WARN] triangle vertex-assignment template reached max iterations without convergence.")


def run_multi_point_closed_loop_template(
    *,
    args: argparse.Namespace,
    goals: list[tuple[str, float, float]],
) -> None:
    """
    多点位模板：按批次调度多机器人执行“先转向再直行”闭环。

    @param args: 客户端参数
    @param goals: [(robot_id, target_x, target_y), ...]
    """

    if not goals:
        return
    print(f"Template> multi_point goals={goals}")
    max_batch = max(1, int(getattr(args, "max_concurrent_robots", 1)))
    total = len(goals)
    for start in range(0, total, max_batch):
        batch = goals[start : start + max_batch]
        print(
            f"---- MultiPoint Batch {start // max_batch + 1}/{(total + max_batch - 1) // max_batch} "
            f"size={len(batch)} ----"
        )
        for idx, (rid, tx, ty) in enumerate(batch, start=start + 1):
            print(f"---- MultiPoint {idx}/{total} robot={rid} target=({tx},{ty}) ----")
            run_closed_loop_point_template(args=args, robot_id=rid, target_x=tx, target_y=ty)
            # 单车子任务结束后显式 stop，降低 mock 速度回传滞后对后续判稳的影响。
            res_stop = run_mcp_call(server_spec=args.server_spec, tool="stop_robot", args={"robot_id": rid})
            print(f"  stop_after_subgoal> {_compact_mcp_result(res_stop)}")


def run_closed_loop_distance_template(
    *,
    args: argparse.Namespace,
    robot_a: str,
    robot_b: str,
    target_distance_m: float,
) -> None:
    """
    执行固定闭环模板：
    阶段1 获取两车状态 -> 阶段2 计算剩余距离 -> 阶段3 send_move -> 阶段4 再测距，
    直到误差收敛或达到最大迭代次数。

    @param args: 客户端参数
    @param robot_a: 参考机器人
    @param robot_b: 被调节机器人
    @param target_distance_m: 目标距离
    """

    print(
        f"Template> closed_loop_distance robot_a={robot_a} robot_b={robot_b} "
        f"target={target_distance_m}m tol={args.closed_loop_tolerance_m}m max_iters={args.closed_loop_max_iters}"
    )
    best_abs_rem = float("inf")
    stagnation_count = 0

    for it in range(1, max(1, args.closed_loop_max_iters) + 1):
        print(f"==== ClosedLoop Iteration {it}/{args.closed_loop_max_iters} ====")

        # 阶段1：两车状态
        phase1_steps = [
            ("get_robot_status", {"robot_id": robot_a}),
            ("get_robot_status", {"robot_id": robot_b}),
        ]
        print("Phase 1 Name> observe_status")
        print("Phase 1 Seq> " + " -> ".join([f"{t}(robot_id={a['robot_id']})" for t, a in phase1_steps]))
        status_payloads: list[dict[str, Any]] = []
        for idx, (tool, tool_args) in enumerate(phase1_steps, start=1):
            cmd = ["fastmcp", "call", args.server_spec, tool, "--json"] + [f"{k}={v}" for k, v in tool_args.items()]
            print(f"Phase 1 Step {idx}/2 Tool> {tool}")
            print(f"Phase 1 Step {idx}/2 Args> {json.dumps(tool_args, ensure_ascii=False)}")
            print(f"Phase 1 Step {idx}/2 Cmd> {format_fastmcp_cmd(cmd)}")
            res = run_mcp_call(server_spec=args.server_spec, tool=tool, args=tool_args)
            print(f"Phase 1 Step {idx}/2 MCP> {_compact_mcp_result(res)}")
            status_payloads.append(extract_tool_payload(res))

        # 阶段2：计算剩余距离
        phase2_args = {"robot_a": robot_a, "robot_b": robot_b, "target_distance_m": target_distance_m}
        print("Phase 2 Name> compute_remaining")
        print(
            "Phase 2 Seq> "
            f"compute_remaining_distance(robot_a={robot_a},robot_b={robot_b},target_distance_m={target_distance_m})"
        )
        res_compute = run_mcp_call(server_spec=args.server_spec, tool="compute_remaining_distance", args=phase2_args)
        print(f"Phase 2 Step 1/1 MCP> {_compact_mcp_result(res_compute)}")
        payload = extract_tool_payload(res_compute)
        data = payload.get("data") if isinstance(payload, dict) else None
        if not payload.get("success") or not isinstance(data, dict):
            print("[WARN] compute_remaining_distance failed, stop closed-loop.")
            return
        remaining = float(data.get("remaining_distance_m", 0.0))
        current = float(data.get("current_distance_m", 0.0))
        print(f"Metric> current={current:.4f}m remaining={remaining:.4f}m")
        abs_rem = abs(remaining)
        improve = best_abs_rem - abs_rem
        if improve > max(0.0, args.closed_loop_min_improve_m):
            best_abs_rem = abs_rem
            stagnation_count = 0
        else:
            stagnation_count += 1
        if stagnation_count >= max(1, args.closed_loop_stagnation_iters):
            print(
                "[WARN] distance template stagnated; stop early to avoid dead loop. "
                f"abs_remaining={abs_rem:.4f} improve={improve:.4f} stagnation_count={stagnation_count}"
            )
            logger.warning(
                "distance_template stagnation stop iter=%s abs_remaining=%.4f improve=%.4f count=%s",
                it,
                abs_rem,
                improve,
                stagnation_count,
            )
            return
        if abs(remaining) <= max(0.0, args.closed_loop_tolerance_m):
            print("Converged> remaining distance within tolerance.")
            return

        # 根据姿态先转向再推进（支持角度调整，提升非共线场景收敛）
        pa = (((status_payloads[0] or {}).get("data") or {}).get("pose") or {}) if status_payloads else {}
        pb = (((status_payloads[1] or {}).get("data") or {}).get("pose") or {}) if len(status_payloads) > 1 else {}
        pose_ref = {"x": float(pa.get("x", 0.0)), "y": float(pa.get("y", 0.0)), "yaw": float(pa.get("yaw", 0.0))}
        pose_move = {"x": float(pb.get("x", 0.0)), "y": float(pb.get("y", 0.0)), "yaw": float(pb.get("yaw", 0.0))}
        move_toward = remaining > 0  # 当前距离大于目标 -> 需要靠近
        speed = max(0.05, abs(float(args.closed_loop_speed_mps)))
        yaw_err = _yaw_error_to_target(pose_move, pose_ref, move_toward)
        turn_speed = max(0.2, abs(float(args.closed_loop_turn_radps)))
        yaw_tol = max(0.01, abs(float(args.closed_loop_yaw_tol_rad)))
        linear = speed
        step_dist = min(abs(remaining), 0.4)
        duration_ms = max(200, int((step_dist / speed) * 1000))

        # 阶段3：先旋转（若需要）再直线移动
        print("Phase 3 Name> apply_move")
        if abs(yaw_err) > yaw_tol:
            rotate_ms = max(150, int((abs(yaw_err) / turn_speed) * 1000))
            rotate_args = {
                "robot_id": robot_b,
                "linear_velocity": 0.0,
                "angular_velocity": turn_speed if yaw_err > 0 else -turn_speed,
                "duration_ms": rotate_ms,
            }
            print(
                "Phase 3 Step 1/2 Decision> "
                f"rotate yaw_err={yaw_err:.4f} tol={yaw_tol:.4f} av={rotate_args['angular_velocity']:.3f} "
                f"duration_ms={rotate_ms}"
            )
            res_rot = run_mcp_call(server_spec=args.server_spec, tool="send_move", args=rotate_args)
            print(f"Phase 3 Step 1/2 MCP> {_compact_mcp_result(res_rot)}")
        else:
            print(f"Phase 3 Step 1/2 Decision> skip rotate (yaw_err={yaw_err:.4f} <= tol={yaw_tol:.4f})")
        phase3_args = {
            "robot_id": robot_b,
            "linear_velocity": linear,
            "angular_velocity": 0.0,
            "duration_ms": duration_ms,
        }
        print(
            "Phase 3 Step 2/2 Decision> "
            f"move linear={linear:.3f} duration_ms={duration_ms} step_dist={step_dist:.3f}"
        )
        res_move = run_mcp_call(server_spec=args.server_spec, tool="send_move", args=phase3_args)
        print(f"Phase 3 Step 2/2 MCP> {_compact_mcp_result(res_move)}")

        # 阶段4：再次测距
        print("Phase 4 Name> re_measure")
        res_post = run_mcp_call(server_spec=args.server_spec, tool="compute_remaining_distance", args=phase2_args)
        print(f"Phase 4 Step 1/1 MCP> {_compact_mcp_result(res_post)}")
        post_payload = extract_tool_payload(res_post)
        post_data = post_payload.get("data") if isinstance(post_payload, dict) else None
        if not post_payload.get("success") or not isinstance(post_data, dict):
            print("[WARN] post measure failed, stop closed-loop.")
            return
        post_remaining = float(post_data.get("remaining_distance_m", 0.0))
        print(f"MetricAfter> remaining={post_remaining:.4f}m")
        if abs(post_remaining) <= max(0.0, args.closed_loop_tolerance_m):
            print("Converged> remaining distance within tolerance.")
            return

    print("[WARN] closed-loop reached max iterations without convergence.")


def run_triangle_closed_loop_template(
    *,
    args: argparse.Namespace,
    robots: list[str],
    side_length_m: float,
) -> None:
    """
    三车三角形（等边）闭环模板：按最差边误差逐轮修正，直到收敛或达到最大迭代。

    阶段1 获取三车状态；
    阶段2 计算三条边误差（AB/BC/AC）；
    阶段3 对误差最大的边执行 send_move（移动该边第二台车）；
    阶段4 复测该边误差。

    @param args: 客户端参数
    @param robots: 三台机器人 ID，长度应 >=3（仅取前三台）
    @param side_length_m: 目标边长（米）
    """

    a, b, c = robots[0], robots[1], robots[2]
    pairs = [(a, b), (b, c), (a, c)]
    tol = max(0.0, args.closed_loop_tolerance_m)
    print(
        f"Template> closed_loop_triangle robots=[{a},{b},{c}] side={side_length_m}m "
        f"tol={tol}m max_iters={args.closed_loop_max_iters}"
    )
    logger.info(
        "triangle_template start robots=%s side=%.4f tol=%.4f max_iters=%s",
        [a, b, c],
        side_length_m,
        tol,
        args.closed_loop_max_iters,
    )
    best_max_abs = float("inf")
    stagnation_count = 0
    worst_edge_history: list[str] = []

    for it in range(1, max(1, args.closed_loop_max_iters) + 1):
        print(f"==== Triangle Iteration {it}/{args.closed_loop_max_iters} ====")
        logger.info("triangle_template iter=%s", it)

        # 阶段1：观测
        print("Phase 1 Name> observe_status_3robots")
        poses: dict[str, dict[str, float] | None] = {}
        for idx, rid in enumerate([a, b, c], start=1):
            pose = _fetch_pose(args, rid)
            poses[rid] = pose
            print(f"Phase 1 Step {idx}/3 Pose> {rid} => {json.dumps(pose, ensure_ascii=False)}")
        if any(v is None for v in poses.values()):
            print("[WARN] observe_status failed for one or more robots; stop triangle template.")
            logger.warning("triangle_template observe failed poses=%s", poses)
            return

        # 退化态处理：三车重合/共线时先做一次破对称初始化，再进入常规闭环
        pa = poses[a]
        pb = poses[b]
        pc = poses[c]
        assert pa is not None and pb is not None and pc is not None
        area2 = _triangle_area2(pa, pb, pc)
        yaw_span = max(pa["yaw"], pb["yaw"], pc["yaw"]) - min(pa["yaw"], pb["yaw"], pc["yaw"])
        d_ab = math.hypot(pb["x"] - pa["x"], pb["y"] - pa["y"])
        d_bc = math.hypot(pc["x"] - pb["x"], pc["y"] - pb["y"])
        d_ac = math.hypot(pc["x"] - pa["x"], pc["y"] - pa["y"])
        degenerate = area2 < 1e-4 and max(d_ab, d_bc, d_ac) < 1e-3
        if degenerate:
            print(
                "[WARN] triangle degenerate start detected; running bootstrap spread "
                f"(area2={area2:.6f}, yaw_span={yaw_span:.6f})"
            )
            logger.warning(
                "triangle_template degenerate bootstrap area2=%.6f yaw_span=%.6f poses=%s",
                area2,
                yaw_span,
                poses,
            )
            # 通过“先转向再短距前进”打破重合对称性：b 朝 +60°，c 朝 -60°
            turn_speed = max(0.2, abs(float(args.closed_loop_turn_radps)))
            bootstrap_len = min(0.4, max(0.2, side_length_m * 0.45))
            rot_target = math.pi / 3.0  # 60deg
            rot_ms = max(150, int((rot_target / turn_speed) * 1000))
            move_speed = max(0.05, abs(float(args.closed_loop_speed_mps)))
            move_ms = max(200, int((bootstrap_len / move_speed) * 1000))

            for rid, sign in ((b, 1.0), (c, -1.0)):
                rot_res = run_mcp_call(
                    server_spec=args.server_spec,
                    tool="send_move",
                    args={
                        "robot_id": rid,
                        "linear_velocity": 0.0,
                        "angular_velocity": sign * turn_speed,
                        "duration_ms": rot_ms,
                    },
                )
                print(
                    f"Bootstrap Rotate> robot={rid} av={sign * turn_speed:.3f} duration_ms={rot_ms} "
                    f"MCP={_compact_mcp_result(rot_res)}"
                )
                mv_res = run_mcp_call(
                    server_spec=args.server_spec,
                    tool="send_move",
                    args={
                        "robot_id": rid,
                        "linear_velocity": move_speed,
                        "angular_velocity": 0.0,
                        "duration_ms": move_ms,
                    },
                )
                print(
                    f"Bootstrap Move> robot={rid} lv={move_speed:.3f} duration_ms={move_ms} "
                    f"MCP={_compact_mcp_result(mv_res)}"
                )
            # bootstrap 后进入下一轮重新评估
            continue

        # 阶段2：计算三边误差
        print("Phase 2 Name> evaluate_edges")
        edge_metrics: list[tuple[tuple[str, str], float, float]] = []
        for p_idx, (r1, r2) in enumerate(pairs, start=1):
            m = run_mcp_call(
                server_spec=args.server_spec,
                tool="compute_remaining_distance",
                args={"robot_a": r1, "robot_b": r2, "target_distance_m": side_length_m},
            )
            payload = extract_tool_payload(m)
            data = payload.get("data") if isinstance(payload, dict) else None
            if not payload.get("success") or not isinstance(data, dict):
                print(f"[WARN] compute edge {r1}-{r2} failed; stop triangle template.")
                logger.warning("triangle_template compute failed pair=%s-%s payload=%s", r1, r2, payload)
                return
            cur = float(data.get("current_distance_m", 0.0))
            rem = float(data.get("remaining_distance_m", 0.0))
            edge_metrics.append(((r1, r2), cur, rem))
            print(f"Phase 2 Step {p_idx}/3 Metric> edge={r1}-{r2} current={cur:.4f}m remaining={rem:.4f}m")

        max_abs = max(abs(rem) for _, _, rem in edge_metrics)
        logger.info(
            "triangle_template iter=%s edge_metrics=%s max_abs=%.4f",
            it,
            [{"edge": f"{e[0]}-{e[1]}", "current": c0, "remaining": r0} for e, c0, r0 in edge_metrics],
            max_abs,
        )
        if max_abs <= tol:
            print("Converged> all edges within tolerance.")
            logger.info("triangle_template converged iter=%s", it)
            return

        # 死循环检测：误差不下降 + 最差边来回震荡
        improve = best_max_abs - max_abs
        if improve > max(0.0, args.closed_loop_min_improve_m):
            best_max_abs = max_abs
            stagnation_count = 0
        else:
            stagnation_count += 1
        worst_edge_name = f"{edge_metrics[max(range(len(edge_metrics)), key=lambda i: abs(edge_metrics[i][2]))][0][0]}-" \
                          f"{edge_metrics[max(range(len(edge_metrics)), key=lambda i: abs(edge_metrics[i][2]))][0][1]}"
        worst_edge_history.append(worst_edge_name)
        if _is_two_edge_oscillation(worst_edge_history):
            print(
                "[WARN] detected two-edge oscillation pattern in triangle template; "
                "stop early to avoid invalid repeated operations."
            )
            logger.warning("triangle_template oscillation detected history=%s", worst_edge_history[-6:])
            return
        if stagnation_count >= max(1, args.closed_loop_stagnation_iters):
            print(
                "[WARN] triangle error stagnated; stop early to avoid dead loop. "
                f"max_abs={max_abs:.4f} improve={improve:.4f} stagnation_count={stagnation_count}"
            )
            logger.warning(
                "triangle_template stagnation stop iter=%s max_abs=%.4f improve=%.4f count=%s",
                it,
                max_abs,
                improve,
                stagnation_count,
            )
            return

        # 阶段3：修正误差最大边，移动该边第二台车
        worst = max(edge_metrics, key=lambda x: abs(x[2]))
        (r_ref, r_move), _, rem = worst
        pose_ref = poses[r_ref]
        pose_move = poses[r_move]
        assert pose_ref is not None and pose_move is not None
        move_toward = rem > 0
        speed = max(0.05, abs(float(args.closed_loop_speed_mps)))
        yaw_err = _yaw_error_to_target(pose_move, pose_ref, move_toward)
        turn_speed = max(0.2, abs(float(args.closed_loop_turn_radps)))
        yaw_tol = max(0.01, abs(float(args.closed_loop_yaw_tol_rad)))
        linear = speed
        step_dist = min(abs(rem), 0.35)
        duration_ms = max(200, int((step_dist / speed) * 1000))
        print("Phase 3 Name> apply_move_worst_edge")
        print(
            "Phase 3 Decision> "
            f"edge={r_ref}-{r_move} remaining={rem:.4f} move_toward={move_toward} "
            f"yaw_err={yaw_err:.4f}"
        )
        logger.info(
            "triangle_template iter=%s move edge=%s-%s rem=%.4f yaw_err=%.4f linear=%.3f duration_ms=%s",
            it,
            r_ref,
            r_move,
            rem,
            yaw_err,
            linear,
            duration_ms,
        )
        if abs(yaw_err) > yaw_tol:
            rotate_ms = max(150, int((abs(yaw_err) / turn_speed) * 1000))
            rot_res = run_mcp_call(
                server_spec=args.server_spec,
                tool="send_move",
                args={
                    "robot_id": r_move,
                    "linear_velocity": 0.0,
                    "angular_velocity": turn_speed if yaw_err > 0 else -turn_speed,
                    "duration_ms": rotate_ms,
                },
            )
            print(
                f"Phase 3 Step 1/2 Rotate> av={(turn_speed if yaw_err > 0 else -turn_speed):.3f} "
                f"duration_ms={rotate_ms} MCP={json.dumps(rot_res, ensure_ascii=False)}"
            )
        else:
            print(f"Phase 3 Step 1/2 Rotate> skip (yaw_err={yaw_err:.4f} <= tol={yaw_tol:.4f})")
        move_res = run_mcp_call(
            server_spec=args.server_spec,
            tool="send_move",
            args={
                "robot_id": r_move,
                "linear_velocity": linear,
                "angular_velocity": 0.0,
                "duration_ms": duration_ms,
            },
        )
        print(f"Phase 3 Step 2/2 Move MCP> {_compact_mcp_result(move_res)}")

        # 阶段4：复测最差边
        print("Phase 4 Name> re_measure_worst_edge")
        post = run_mcp_call(
            server_spec=args.server_spec,
            tool="compute_remaining_distance",
            args={"robot_a": r_ref, "robot_b": r_move, "target_distance_m": side_length_m},
        )
        post_payload = extract_tool_payload(post)
        post_data = post_payload.get("data") if isinstance(post_payload, dict) else None
        if not post_payload.get("success") or not isinstance(post_data, dict):
            print("[WARN] post measure failed; stop triangle template.")
            logger.warning("triangle_template post measure failed payload=%s", post_payload)
            return
        post_rem = float(post_data.get("remaining_distance_m", 0.0))
        print(f"Phase 4 Step 1/1 MetricAfter> edge={r_ref}-{r_move} remaining={post_rem:.4f}m")
        logger.info("triangle_template iter=%s post_remaining edge=%s-%s rem=%.4f", it, r_ref, r_move, post_rem)

    print("[WARN] triangle closed-loop reached max iterations without convergence.")
    logger.warning("triangle_template max iterations reached without convergence")


def run_right_triangle_closed_loop_template(
    *,
    args: argparse.Namespace,
    robots: list[str],
    leg_a_m: float,
    leg_b_m: float,
) -> None:
    """
    直角三角形闭环模板（A-B=leg_a，A-C=leg_b，B-C=hypotenuse）。

    @param args: 客户端参数
    @param robots: 三台机器人，按 [A,B,C]
    @param leg_a_m: AB 目标长度
    @param leg_b_m: AC 目标长度
    """

    a, b, c = robots[0], robots[1], robots[2]
    hyp = math.sqrt(max(0.0, leg_a_m * leg_a_m + leg_b_m * leg_b_m))
    edge_targets = {(a, b): float(leg_a_m), (a, c): float(leg_b_m), (b, c): float(hyp)}
    tol = max(0.0, args.closed_loop_tolerance_m)
    print(
        f"Template> right_triangle robots=[{a},{b},{c}] "
        f"AB={leg_a_m} AC={leg_b_m} BC={hyp:.4f} tol={tol} max_iters={args.closed_loop_max_iters}"
    )
    logger.info(
        "right_triangle_template start robots=%s AB=%.4f AC=%.4f BC=%.4f tol=%.4f max_iters=%s",
        [a, b, c],
        leg_a_m,
        leg_b_m,
        hyp,
        tol,
        args.closed_loop_max_iters,
    )
    best_max_abs = float("inf")
    stagnation_count = 0
    worst_edge_history: list[str] = []
    pairs = [(a, b), (a, c), (b, c)]

    for it in range(1, max(1, args.closed_loop_max_iters) + 1):
        print(f"==== RightTriangle Iteration {it}/{args.closed_loop_max_iters} ====")
        poses = {rid: _fetch_pose(args, rid) for rid in [a, b, c]}
        if any(v is None for v in poses.values()):
            print("[WARN] right triangle observe failed; stop.")
            return

        print("Phase 2 Name> evaluate_edges")
        edge_metrics: list[tuple[tuple[str, str], float, float]] = []
        for idx, (r1, r2) in enumerate(pairs, start=1):
            target = edge_targets[(r1, r2)]
            m = run_mcp_call(
                server_spec=args.server_spec,
                tool="compute_remaining_distance",
                args={"robot_a": r1, "robot_b": r2, "target_distance_m": target},
            )
            payload = extract_tool_payload(m)
            data = payload.get("data") if isinstance(payload, dict) else None
            if not payload.get("success") or not isinstance(data, dict):
                print(f"[WARN] compute edge {r1}-{r2} failed; stop.")
                return
            cur = float(data.get("current_distance_m", 0.0))
            rem = float(data.get("remaining_distance_m", 0.0))
            edge_metrics.append(((r1, r2), cur, rem))
            print(
                f"Phase 2 Step {idx}/3 Metric> edge={r1}-{r2} target={target:.4f} "
                f"current={cur:.4f} remaining={rem:.4f}"
            )

        max_abs = max(abs(rem) for _, _, rem in edge_metrics)
        if max_abs <= tol:
            print("Converged> right triangle edges within tolerance.")
            return
        improve = best_max_abs - max_abs
        if improve > max(0.0, args.closed_loop_min_improve_m):
            best_max_abs = max_abs
            stagnation_count = 0
        else:
            stagnation_count += 1
        worst_i = max(range(len(edge_metrics)), key=lambda i: abs(edge_metrics[i][2]))
        worst_edge_name = f"{edge_metrics[worst_i][0][0]}-{edge_metrics[worst_i][0][1]}"
        worst_edge_history.append(worst_edge_name)
        if _is_two_edge_oscillation(worst_edge_history) or stagnation_count >= max(1, args.closed_loop_stagnation_iters):
            print("[WARN] right triangle oscillation/stagnation detected; stop.")
            return

        (r_ref, r_move), _, rem = edge_metrics[worst_i]
        p_ref = poses[r_ref]
        p_move = poses[r_move]
        assert p_ref is not None and p_move is not None
        move_toward = rem > 0
        yaw_err = _yaw_error_to_target(p_move, p_ref, move_toward)
        turn_speed = max(0.2, abs(float(args.closed_loop_turn_radps)))
        yaw_tol = max(0.01, abs(float(args.closed_loop_yaw_tol_rad)))
        speed = max(0.05, abs(float(args.closed_loop_speed_mps)))
        step_dist = min(abs(rem), 0.35)
        move_ms = max(200, int((step_dist / speed) * 1000))
        print(
            f"Phase 3 Decision> edge={r_ref}-{r_move} rem={rem:.4f} yaw_err={yaw_err:.4f} "
            f"move_toward={move_toward}"
        )
        if abs(yaw_err) > yaw_tol:
            rot_ms = max(150, int((abs(yaw_err) / turn_speed) * 1000))
            rot = run_mcp_call(
                server_spec=args.server_spec,
                tool="send_move",
                args={
                    "robot_id": r_move,
                    "linear_velocity": 0.0,
                    "angular_velocity": turn_speed if yaw_err > 0 else -turn_speed,
                    "duration_ms": rot_ms,
                },
            )
            print(f"Phase 3 Rotate> {_compact_mcp_result(rot)}")
        mv = run_mcp_call(
            server_spec=args.server_spec,
            tool="send_move",
            args={"robot_id": r_move, "linear_velocity": speed, "angular_velocity": 0.0, "duration_ms": move_ms},
        )
        print(f"Phase 3 Move> {_compact_mcp_result(mv)}")


def run_convoy_template(
    *,
    args: argparse.Namespace,
    robots: list[str],
    speed_mps: float,
    duration_ms: int,
) -> None:
    """
    队列共同前进模板：统一朝向后，批量同速前进。

    @param args: 客户端参数
    @param robots: 队列顺序
    @param speed_mps: 前进速度
    @param duration_ms: 前进时长
    """

    if len(robots) < 2:
        print("[WARN] convoy requires at least 2 robots")
        return
    print(
        f"Template> convoy robots={robots} speed={speed_mps}m/s duration_ms={duration_ms} "
        f"yaw_tol={args.closed_loop_yaw_tol_rad}"
    )
    print("Phase 1 Name> align_heading")
    poses = {rid: _fetch_pose(args, rid) for rid in robots}
    if any(v is None for v in poses.values()):
        print("[WARN] convoy observe failed")
        return
    leader = robots[0]
    leader_pose = poses[leader]
    assert leader_pose is not None
    leader_yaw = leader_pose["yaw"]
    turn_speed = max(0.2, abs(float(args.closed_loop_turn_radps)))
    yaw_tol = max(0.01, abs(float(args.closed_loop_yaw_tol_rad)))
    for rid in robots[1:]:
        p = poses[rid]
        assert p is not None
        yaw_err = _normalize_angle(leader_yaw - p["yaw"])
        if abs(yaw_err) <= yaw_tol:
            print(f"Phase 1 Align> {rid} already aligned yaw_err={yaw_err:.4f}")
            continue
        rot_ms = max(150, int((abs(yaw_err) / turn_speed) * 1000))
        rot = run_mcp_call(
            server_spec=args.server_spec,
            tool="send_move",
            args={
                "robot_id": rid,
                "linear_velocity": 0.0,
                "angular_velocity": turn_speed if yaw_err > 0 else -turn_speed,
                "duration_ms": rot_ms,
            },
        )
        print(f"Phase 1 Align> {rid} yaw_err={yaw_err:.4f} {_compact_mcp_result(rot)}")

    print("Phase 2 Name> move_together")
    safe_speed = max(0.05, abs(speed_mps))
    safe_ms = max(200, int(duration_ms))
    for rid in robots:
        mv = run_mcp_call(
            server_spec=args.server_spec,
            tool="send_move",
            args={"robot_id": rid, "linear_velocity": safe_speed, "angular_velocity": 0.0, "duration_ms": safe_ms},
        )
        print(f"Phase 2 Move> {rid} {_compact_mcp_result(mv)}")


def run_line_closed_loop_template(
    *,
    args: argparse.Namespace,
    robots: list[str],
    spacing_m: float,
) -> None:
    """
    N 机器人直线等间距闭环模板：按相邻 pair 的最大误差逐轮修正。

    阶段1 获取整队状态（get_fleet_status）；
    阶段2 评估相邻 pair 间距误差；
    阶段3 修正误差最大 pair（移动后车）；
    阶段4 复测该 pair。

    @param args: 客户端参数
    @param robots: 编队顺序列表
    @param spacing_m: 相邻目标间距
    """

    if len(robots) < 2:
        print("[WARN] line template requires at least 2 robots")
        return
    pair_list = [(robots[i], robots[i + 1]) for i in range(len(robots) - 1)]
    tol = max(0.0, args.closed_loop_tolerance_m)
    print(
        f"Template> closed_loop_line robots={robots} spacing={spacing_m}m "
        f"tol={tol}m max_iters={args.closed_loop_max_iters}"
    )
    logger.info(
        "line_template start robots=%s spacing=%.4f tol=%.4f max_iters=%s",
        robots,
        spacing_m,
        tol,
        args.closed_loop_max_iters,
    )
    best_max_abs = float("inf")
    stagnation_count = 0
    worst_pair_history: list[str] = []

    for it in range(1, max(1, args.closed_loop_max_iters) + 1):
        print(f"==== Line Iteration {it}/{args.closed_loop_max_iters} ====")
        logger.info("line_template iter=%s", it)

        # 阶段1：批量状态
        print("Phase 1 Name> observe_fleet")
        csv_ids = ",".join(robots)
        fleet = run_mcp_call(server_spec=args.server_spec, tool="get_fleet_status", args={"robot_ids_csv": csv_ids})
        print(f"Phase 1 Step 1/1 MCP> {_compact_mcp_result(fleet)}")
        fleet_payload = extract_tool_payload(fleet)
        fleet_data = fleet_payload.get("data") if isinstance(fleet_payload, dict) else None
        items = (fleet_data.get("items") if isinstance(fleet_data, dict) else None) if isinstance(fleet_data, dict) else None
        if not fleet_payload.get("success") and not isinstance(items, list):
            print("[WARN] get_fleet_status failed; stop line template.")
            logger.warning("line_template fleet status failed payload=%s", fleet_payload)
            return

        # 阶段2：评估相邻误差
        print("Phase 2 Name> evaluate_adjacent_pairs")
        pair_metrics: list[tuple[tuple[str, str], float, float]] = []
        for idx, (ra, rb) in enumerate(pair_list, start=1):
            m = run_mcp_call(
                server_spec=args.server_spec,
                tool="compute_remaining_distance",
                args={"robot_a": ra, "robot_b": rb, "target_distance_m": spacing_m},
            )
            payload = extract_tool_payload(m)
            data = payload.get("data") if isinstance(payload, dict) else None
            if not payload.get("success") or not isinstance(data, dict):
                print(f"[WARN] compute pair {ra}-{rb} failed; stop line template.")
                logger.warning("line_template compute failed pair=%s-%s payload=%s", ra, rb, payload)
                return
            cur = float(data.get("current_distance_m", 0.0))
            rem = float(data.get("remaining_distance_m", 0.0))
            pair_metrics.append(((ra, rb), cur, rem))
            print(f"Phase 2 Step {idx}/{len(pair_list)} Metric> pair={ra}-{rb} current={cur:.4f}m remaining={rem:.4f}m")

        max_abs = max(abs(rem) for _, _, rem in pair_metrics)
        logger.info(
            "line_template iter=%s pair_metrics=%s max_abs=%.4f",
            it,
            [{"pair": f"{p[0]}-{p[1]}", "current": c0, "remaining": r0} for p, c0, r0 in pair_metrics],
            max_abs,
        )
        if max_abs <= tol:
            print("Converged> all adjacent pairs within tolerance.")
            logger.info("line_template converged iter=%s", it)
            return

        improve = best_max_abs - max_abs
        if improve > max(0.0, args.closed_loop_min_improve_m):
            best_max_abs = max_abs
            stagnation_count = 0
        else:
            stagnation_count += 1
        worst_pair_name = f"{pair_metrics[max(range(len(pair_metrics)), key=lambda i: abs(pair_metrics[i][2]))][0][0]}-" \
                          f"{pair_metrics[max(range(len(pair_metrics)), key=lambda i: abs(pair_metrics[i][2]))][0][1]}"
        worst_pair_history.append(worst_pair_name)
        if _is_two_edge_oscillation(worst_pair_history):
            print("[WARN] detected pair oscillation in line template; stop early to avoid dead loop.")
            logger.warning("line_template oscillation detected history=%s", worst_pair_history[-6:])
            return
        if stagnation_count >= max(1, args.closed_loop_stagnation_iters):
            print(
                "[WARN] line error stagnated; stop early to avoid dead loop. "
                f"max_abs={max_abs:.4f} improve={improve:.4f} stagnation_count={stagnation_count}"
            )
            logger.warning(
                "line_template stagnation stop iter=%s max_abs=%.4f improve=%.4f count=%s",
                it,
                max_abs,
                improve,
                stagnation_count,
            )
            return

        # 阶段3：修正最差相邻 pair，移动后车
        worst = max(pair_metrics, key=lambda x: abs(x[2]))
        (r_ref, r_move), _, rem = worst
        p_ref = _fetch_pose(args, r_ref)
        p_move = _fetch_pose(args, r_move)
        if p_ref is None or p_move is None:
            print("[WARN] failed to fetch pose for move decision; stop line template.")
            logger.warning("line_template move decision pose missing ref=%s move=%s", p_ref, p_move)
            return
        move_toward = rem > 0
        speed = max(0.05, abs(float(args.closed_loop_speed_mps)))
        yaw_err = _yaw_error_to_target(p_move, p_ref, move_toward)
        turn_speed = max(0.2, abs(float(args.closed_loop_turn_radps)))
        yaw_tol = max(0.01, abs(float(args.closed_loop_yaw_tol_rad)))
        linear = speed
        step_dist = min(abs(rem), 0.35)
        duration_ms = max(200, int((step_dist / speed) * 1000))
        print("Phase 3 Name> apply_move_worst_pair")
        print(
            "Phase 3 Step 1/1 Decision> "
            f"pair={r_ref}-{r_move} remaining={rem:.4f} move_toward={move_toward} "
            f"yaw_err={yaw_err:.4f} linear={linear:.3f} duration_ms={duration_ms}"
        )
        logger.info(
            "line_template iter=%s move pair=%s-%s rem=%.4f yaw_err=%.4f linear=%.3f duration_ms=%s",
            it,
            r_ref,
            r_move,
            rem,
            yaw_err,
            linear,
            duration_ms,
        )
        if abs(yaw_err) > yaw_tol:
            rotate_ms = max(150, int((abs(yaw_err) / turn_speed) * 1000))
            rot = run_mcp_call(
                server_spec=args.server_spec,
                tool="send_move",
                args={
                    "robot_id": r_move,
                    "linear_velocity": 0.0,
                    "angular_velocity": turn_speed if yaw_err > 0 else -turn_speed,
                    "duration_ms": rotate_ms,
                },
            )
            print(
                f"Phase 3 Step 1/2 Rotate> av={(turn_speed if yaw_err > 0 else -turn_speed):.3f} "
                f"duration_ms={rotate_ms} MCP={json.dumps(rot, ensure_ascii=False)}"
            )
        else:
            print(f"Phase 3 Step 1/2 Rotate> skip (yaw_err={yaw_err:.4f} <= tol={yaw_tol:.4f})")
        mv = run_mcp_call(
            server_spec=args.server_spec,
            tool="send_move",
            args={"robot_id": r_move, "linear_velocity": linear, "angular_velocity": 0.0, "duration_ms": duration_ms},
        )
        print(f"Phase 3 Step 2/2 Move MCP> {_compact_mcp_result(mv)}")

        # 阶段4：复测
        print("Phase 4 Name> re_measure_worst_pair")
        post = run_mcp_call(
            server_spec=args.server_spec,
            tool="compute_remaining_distance",
            args={"robot_a": r_ref, "robot_b": r_move, "target_distance_m": spacing_m},
        )
        pp = extract_tool_payload(post)
        pd = pp.get("data") if isinstance(pp, dict) else None
        if not pp.get("success") or not isinstance(pd, dict):
            print("[WARN] post pair measure failed; stop line template.")
            logger.warning("line_template post measure failed payload=%s", pp)
            return
        post_rem = float(pd.get("remaining_distance_m", 0.0))
        print(f"Phase 4 Step 1/1 MetricAfter> pair={r_ref}-{r_move} remaining={post_rem:.4f}m")
        logger.info("line_template iter=%s post_remaining pair=%s-%s rem=%.4f", it, r_ref, r_move, post_rem)

    print("[WARN] line closed-loop reached max iterations without convergence.")
    logger.warning("line_template max iterations reached without convergence")


def build_action_replan_input(
    *,
    user_text: str,
    executed_phases: list[dict[str, Any]],
    observed_results: list[tuple[str, dict[str, Any], dict[str, Any]]],
) -> str:
    """
    构造二阶段动作重规划输入：把观测结果回灌给 LLM，要求输出可执行动作序列。

    @param user_text: 原始用户请求
    @param executed_phases: 第一阶段已执行阶段
    @param observed_results: [(phase_name, step, fastmcp_result_json), ...]
    @returns: 供 call_deepseek 的 user_text
    """

    lines: list[str] = []
    lines.append("Phase-2 planning request: produce executable ACTION steps.")
    lines.append("You MUST output steps containing at least one action tool (send_move/stop_robot/emergency_stop_all).")
    lines.append("Do not return only list/get steps.")
    lines.append("Prefer format: {\"phases\":[{\"name\":\"...\",\"steps\":[...]}]}.")
    lines.append(
        "For distance tasks, bind mover strictly: compute_remaining_distance(robot_a, robot_b, target_distance_m) "
        "uses robot_a as mover and robot_b as reference."
    )
    lines.append(f"Original user request: {user_text}")
    for p in executed_phases:
        lines.append(f"Executed phase: {p.get('name', 'phase')} -> {compact_step_sequence(p.get('steps') or [])}")
    lines.append("Phase-1 observed outputs:")
    for idx, (phase_name, step, result) in enumerate(observed_results, start=1):
        lines.append(f"- {phase_name} step{idx}: {json.dumps(step, ensure_ascii=False)}")
        lines.append(f"  result{idx}: {json.dumps(result, ensure_ascii=False)}")
    return "\n".join(lines)


def execute_complex_intent_template(
    *,
    intent: dict[str, Any],
    user_text: str,
    args: argparse.Namespace,
) -> bool:
    """
    将复杂结构化意图映射到确定性模板执行。

    @param intent: 结构化意图（含 intent_id / intent_type / robots / params / subgoals）
    @param user_text: 原始用户输入
    @param args: 客户端参数
    @returns: True=已匹配并执行；False=未匹配
    """

    intent_id = str(intent.get("intent_id", "intent_unknown"))
    intent_type = str(intent.get("intent_type", "")).strip()
    robots = intent.get("robots") if isinstance(intent.get("robots"), list) else []
    params = intent.get("params") if isinstance(intent.get("params"), dict) else {}
    subgoals = intent.get("subgoals") if isinstance(intent.get("subgoals"), list) else []
    print(f"[INTENT] id={intent_id} type={intent_type} structured={json.dumps(intent, ensure_ascii=False)}")
    logger.info("intent parsed id=%s type=%s payload=%s", intent_id, intent_type, json.dumps(intent, ensure_ascii=False))

    if intent_type == "line_formation":
        spacing = float(params.get("spacing_m", 1.0))
        ids = [str(x) for x in robots if str(x).strip()]
        if not ids:
            infer_goal = infer_line_formation_from_nl(user_text, args)
            if infer_goal:
                ids, spacing = infer_goal
        if len(ids) < 2:
            print(f"[WARN] INTENT {intent_id}: line_formation robots < 2, skip.")
            return False
        baseline_y = params.get("baseline_y")
        baseline_x = params.get("baseline_x")
        if not isinstance(baseline_y, (int, float)) and not isinstance(baseline_x, (int, float)):
            by_txt, bx_txt = parse_line_baseline_from_text(user_text)
            if isinstance(by_txt, float):
                baseline_y = by_txt
            if isinstance(bx_txt, float):
                baseline_x = bx_txt
            if isinstance(by_txt, float) or isinstance(bx_txt, float):
                print(
                    f"[INTENT_PARAM_PATCH] id={intent_id} patched baseline "
                    + json.dumps(
                        {
                            "baseline_y": float(by_txt) if isinstance(by_txt, float) else None,
                            "baseline_x": float(bx_txt) if isinstance(bx_txt, float) else None,
                        },
                        ensure_ascii=False,
                    )
                )
                logger.info(
                    "intent baseline patched id=%s baseline_y=%s baseline_x=%s",
                    intent_id,
                    by_txt,
                    bx_txt,
                )
        poses_now: dict[str, dict[str, float]] = {}
        for rid in ids:
            p = _fetch_pose(args, rid)
            if p is None:
                print(f"[WARN] INTENT {intent_id}: failed to fetch pose for line target {rid}.")
                return False
            poses_now[rid] = p
        # 无论是否有 baseline，先算出并冻结每台车的最终目标点，再进入移动阶段。
        fixed_targets = plan_line_targets_with_constraints(
            poses_now,
            spacing_m=spacing,
            baseline_y=float(baseline_y) if isinstance(baseline_y, (int, float)) else None,
            baseline_x=float(baseline_x) if isinstance(baseline_x, (int, float)) else None,
        )
        if not fixed_targets:
            print(f"[WARN] INTENT {intent_id}: line target assignment failed.")
            return False
        print(
            f"[INTENT_TARGETS] id={intent_id} line_formation targets="
            + json.dumps({k: {"x": v[0], "y": v[1]} for k, v in fixed_targets.items()}, ensure_ascii=False)
        )
        print(
            f"[INTENT_MAP] id={intent_id} line_formation -> "
            "compute fixed targets -> send_move/stop_robot"
        )
        run_line_vertex_assignment_closed_loop_template(
            args=args,
            robots=ids,
            spacing_m=spacing,
            fixed_targets_override=fixed_targets,
        )
        return True

    if intent_type == "triangle_formation":
        side = float(params.get("side_length_m", 1.0))
        ids = [str(x) for x in robots if str(x).strip()]
        if len(ids) < 3:
            ids = _pick_first_n_unit_ids_from_fleet(args, 3)
        if len(ids) < 3:
            print(f"[WARN] INTENT {intent_id}: triangle robots < 3, skip.")
            return False
        print(
            f"[INTENT_MAP] id={intent_id} triangle_formation -> "
            "get_fleet_status + vertex_assignment + send_move/stop_robot"
        )
        run_triangle_vertex_assignment_closed_loop_template(args=args, robots=ids, side_length_m=side)
        return True

    if intent_type == "right_triangle_formation":
        la = float(params.get("leg_a_m", 1.0))
        lb = float(params.get("leg_b_m", la))
        ids = [str(x) for x in robots if str(x).strip()]
        if len(ids) < 3:
            ids = _pick_first_n_unit_ids_from_fleet(args, 3)
        if len(ids) < 3:
            print(f"[WARN] INTENT {intent_id}: right_triangle robots < 3, skip.")
            return False
        print(
            f"[INTENT_MAP] id={intent_id} right_triangle_formation -> "
            "compute_remaining_distance + send_move/stop_robot"
        )
        run_right_triangle_closed_loop_template(args=args, robots=ids, leg_a_m=la, leg_b_m=lb)
        return True

    if intent_type == "pair_distance":
        ids = [str(x) for x in robots if str(x).strip()]
        if len(ids) < 2:
            goal = parse_distance_goal_request(user_text)
            if goal:
                ids = [goal[0], goal[1]]
        if len(ids) < 2:
            print(f"[WARN] INTENT {intent_id}: pair_distance robots < 2, skip.")
            return False
        target = float(params.get("target_distance_m", 1.0))
        print(
            f"[INTENT_MAP] id={intent_id} pair_distance -> "
            "get_robot_status + compute_remaining_distance + send_move"
        )
        run_closed_loop_distance_template(args=args, robot_a=ids[0], robot_b=ids[1], target_distance_m=target)
        return True

    if intent_type == "convoy":
        ids = [str(x) for x in robots if str(x).strip()]
        if len(ids) < 2:
            ids = _pick_first_n_unit_ids_from_fleet(args, 10)
        if len(ids) < 2:
            print(f"[WARN] INTENT {intent_id}: convoy robots < 2, skip.")
            return False
        speed = float(params.get("speed_mps", args.convoy_speed_mps))
        duration_ms = int(params.get("duration_ms", args.convoy_duration_ms))
        print(f"[INTENT_MAP] id={intent_id} convoy -> send_move(batch) + get_fleet_status")
        run_convoy_template(args=args, robots=ids, speed_mps=speed, duration_ms=duration_ms)
        return True

    if intent_type == "composite":
        if not subgoals:
            print(f"[WARN] INTENT {intent_id}: composite has empty subgoals.")
            return False
        print(f"[INTENT_MAP] id={intent_id} composite -> subgoal templates sequential execution")
        cfg_path = str(MCP_PROJECT_ROOT / "robots.json")

        def _verify_subgoal(
            *,
            sg_type: str,
            sg_robots: list[Any],
            sg_params: dict[str, Any],
        ) -> tuple[bool, str]:
            """@returns: (是否达标, 原因)"""

            fres = run_mcp_call(server_spec=args.server_spec, tool="get_fleet_status", args={"robot_ids_csv": ""})
            poses = fleet_poses_from_mcp_result(fres)
            goal: CompletionGoal | None = None
            tol_use = float(args.completion_tolerance_m)
            if sg_type == "point_goal":
                if not sg_robots:
                    return False, "point_goal 缺少机器人"
                rid = str(sg_robots[0]).strip()
                tx = sg_params.get("target_x")
                ty = sg_params.get("target_y")
                if not isinstance(tx, (int, float)) or not isinstance(ty, (int, float)):
                    return False, "point_goal 缺少 target_x/target_y"
                goal = CompletionGoal(
                    kind="point_goal",
                    robot_ids=[rid],
                    target_m=0.0,
                    target_points={rid: (float(tx), float(ty))},
                )
                tol_use = float(args.closed_loop_tolerance_m)
            elif sg_type == "line_formation":
                ids = [str(x).strip() for x in sg_robots if str(x).strip()]
                sp = sg_params.get("spacing_m")
                if len(ids) < 2 or not isinstance(sp, (int, float)):
                    return False, "line_formation 参数不足"
                goal = CompletionGoal(kind="line_spacing", robot_ids=ids, target_m=float(sp))
                tol_use = float(args.completion_tolerance_m)
            elif sg_type == "pair_distance":
                ids = [str(x).strip() for x in sg_robots if str(x).strip()]
                td = sg_params.get("target_distance_m")
                if len(ids) < 2 or not isinstance(td, (int, float)):
                    return False, "pair_distance 参数不足"
                goal = CompletionGoal(kind="pair_distance", robot_ids=ids[:2], target_m=float(td))
                tol_use = float(args.completion_tolerance_m)
            if goal is None:
                return True, "skip verification"
            ok, reason, _ = verify_completion_goal(goal, poses, tol_m=tol_use, config_path=cfg_path)
            return bool(ok), str(reason)

        for i, sg in enumerate(subgoals, start=1):
            if not isinstance(sg, dict):
                continue
            sg_type = str(sg.get("intent_type", "")).strip()
            sg_robots = sg.get("robots") if isinstance(sg.get("robots"), list) else []
            sg_params = sg.get("params") if isinstance(sg.get("params"), dict) else {}
            print(f"[INTENT_SUBGOAL] id={intent_id} idx={i} type={sg_type} payload={json.dumps(sg, ensure_ascii=False)}")
            if sg_type == "point_goal":
                if not sg_robots:
                    continue
                rid = str(sg_robots[0])
                tx = sg_params.get("target_x")
                ty = sg_params.get("target_y")
                if not isinstance(tx, (int, float)) or not isinstance(ty, (int, float)):
                    print(f"[ERROR] INTENT {intent_id} point_goal 缺少 target_x/target_y，停止复合模板执行。")
                    logger.error("composite subgoal missing point params intent_id=%s idx=%s payload=%s", intent_id, i, sg)
                    return False
                print(
                    f"[INTENT_TARGETS] id={intent_id} subgoal={i} point_goal target="
                    + json.dumps({rid: {"x": float(tx), "y": float(ty)}}, ensure_ascii=False)
                )
                run_closed_loop_point_template(args=args, robot_id=rid, target_x=tx, target_y=ty)
                run_mcp_call(server_spec=args.server_spec, tool="stop_robot", args={"robot_id": rid})
            else:
                ok_sub_exec = execute_complex_intent_template(
                intent={
                    "intent_id": f"{intent_id}_sub_{i}",
                    "intent_type": sg_type,
                    "robots": sg_robots,
                    "params": sg_params,
                },
                user_text=user_text,
                args=args,
            )
                if not ok_sub_exec:
                    print(f"[ERROR] INTENT {intent_id} 子目标 idx={i} 执行失败，停止后续子目标。")
                    return False
            ok_sub, reason_sub = _verify_subgoal(sg_type=sg_type, sg_robots=sg_robots, sg_params=sg_params)
            if not ok_sub:
                print(f"[ERROR] INTENT {intent_id} 子目标 idx={i} 未达标: {reason_sub}，停止后续子目标。")
                logger.warning("composite subgoal not converged intent_id=%s idx=%s reason=%s", intent_id, i, reason_sub)
                return False
        return True

    return False


def should_use_precise_template_mode(user_text: str) -> bool:
    """
    判断是否启用高性能模板模式（默认 LLM 自由规划优先）。

    触发条件（任一满足）：
    1) 用户显式提到「模板/template/精准」；
    2) 同时具备：明确队形关键词 + 显式 robot 标识 + 显式数值约束。

    @param user_text: 用户输入
    @returns: True 表示自动切换模板路径
    """

    t = user_text.lower()
    if any(k in t for k in ["模板", "template", "精准", "高性能"]):
        return True

    ids = re.findall(r"(?:GV|AV)\d+|robot_[A-Za-z0-9_]+", user_text, flags=re.IGNORECASE)
    uniq_ids: list[str] = []
    for rid in ids:
        if rid.upper() not in [u.upper() for u in uniq_ids]:
            uniq_ids.append(rid)
    has_explicit_ids = len(uniq_ids) >= 2
    has_metric = bool(re.search(r"(\d+(?:\.\d+)?)\s*(m/s|m|米|ms|s\b)", user_text, flags=re.IGNORECASE))
    shape_kw = [
        "一行",
        "直线",
        "三角",
        "直角三角形",
        "队列",
        "相距",
        "distance",
        "line",
        "triangle",
        "convoy",
    ]
    has_shape = any(k in t or k in user_text for k in shape_kw)
    return has_explicit_ids and has_metric and has_shape


def parse_llm_done_signal(plan: dict[str, Any]) -> tuple[bool, str]:
    """
    解析 LLM 自主闭环回包中的完成信号。

    @param plan: LLM 返回 JSON
    @returns: (done, reason)
    """

    done_raw = plan.get("done")
    done = done_raw is True or (isinstance(done_raw, str) and done_raw.strip().lower() == "true")
    reason = str(plan.get("reason", "")).strip()
    return done, reason


def violates_autoloop_goal_scope(phases: list[dict[str, Any]], goal: CompletionGoal | None) -> bool:
    """
    检查续跑计划是否引入与目标无关的工具目标。

    @param phases: 续跑阶段
    @param goal: 当前可度量目标
    @returns: True 表示违反目标范围
    """

    if goal is None:
        return False
    if goal.kind not in {"point_goal", "multi_point"}:
        return False
    for phase in phases:
        for step in phase.get("steps") or []:
            if str(step.get("tool", "")) == "compute_remaining_distance":
                return True
    return False


def build_autonomous_followup_prompt(
    user_text: str,
    *,
    round_idx: int,
    max_rounds: int,
    fleet_snapshot_json: str,
    history_lines: list[str],
    metric_hint: str,
    goal: CompletionGoal | None,
) -> str:
    """
    构造「LLM 自主闭环」续调度提示：由模型判断是否达标并决定下一轮动作。

    @param user_text: 用户原始自然语言
    @param round_idx: 当前闭环轮次（从 1 起）
    @param max_rounds: 最大轮数
    @param fleet_snapshot_json: 最新 get_fleet_status 原始 JSON 文本
    @param history_lines: 已执行摘要（每轮简述）
    @param metric_hint: 可选结构化度量提示（仅提示，不作硬判）
    @param goal: 当前可度量目标；用于限制无关工具
    @returns: 发给 call_deepseek 的 user_text
    """

    hist = "\n".join([f"- {x}" for x in history_lines[-10:]]) if history_lines else "- (none)"
    lines: list[str] = [
        f"AUTONOMOUS CLOSED-LOOP round {round_idx}/{max_rounds}.",
        "You are the sole decision-maker for task completion.",
        "Decide whether the user goal is fully achieved from current observations.",
        "",
        f"Original user request:\n{user_text}",
        "",
        f"Recent execution history:\n{hist}",
        "",
        "Latest get_fleet_status snapshot JSON:",
        fleet_snapshot_json,
    ]
    if metric_hint:
        lines.extend(["", f"Optional metric hint (advisory only): {metric_hint}"])
    lines.extend(
        [
            "",
            "Output JSON only with one of the following forms:",
            "1) Goal achieved: {\"done\": true, \"reason\": \"...\"}",
            (
                "2) Goal not achieved: "
                "{\"done\": false, \"reason\": \"...\", "
                "\"phases\":[{\"name\":\"...\",\"steps\":[{\"tool\":\"...\",\"args\":{...}}]}]}"
            ),
            "When done=false, phases MUST include at least one action tool (send_move/stop_robot/emergency_stop_all).",
            (
                "If the user asked for a specific speed and robot, include send_move with those exact parameters "
                "(after list_robots if needed) so MCP can return speed_out_of_bounds or unit_not_bound; "
                "do not emit clarification-only phases in that situation."
            ),
            "Use get_fleet_status/get_robot_status/compute_remaining_distance as needed before action steps.",
            (
                "For distance tasks, robot_a in compute_remaining_distance is the mover and robot_b is reference; "
                "do not swap them."
            ),
        ]
    )
    if goal is not None and goal.kind in {"point_goal", "multi_point"}:
        lines.extend(
            [
                "STRICT SCOPE: This is a point-goal task.",
                "Do NOT introduce pair-distance or line-spacing objectives.",
                "Do NOT call compute_remaining_distance unless original user request explicitly asked pair distance.",
                "Focus only on each robot reaching its own target point.",
            ]
        )
    return "\n".join(lines)


def extract_tool_json_string(fastmcp_out: dict[str, Any]) -> str:
    """
    从 fastmcp CLI 返回的 JSON 中取出 MCP 工具结果字符串（内层 JSON 文本）。

    @param fastmcp_out: json.loads 后的 fastmcp 标准输出对象
    @returns: 工具返回的文本（常为 JSON 字符串）；无法解析时为空串
    """

    sc = fastmcp_out.get("structured_content")
    if isinstance(sc, dict):
        r = sc.get("result")
        if isinstance(r, str) and r.strip():
            return r.strip()
    for block in fastmcp_out.get("content") or []:
        if isinstance(block, dict) and block.get("type") == "text":
            t = block.get("text")
            if isinstance(t, str) and t.strip():
                return t.strip()
    return ""


class LocalToolRunner:
    """
    常驻进程内工具直调执行器：避免每步 `fastmcp call` 产生子进程开销。
    """

    def __init__(self) -> None:
        self._adapter = RobotAdapter(tool_timeout_s=DEFAULT_TOOL_TIMEOUT_S)

    def call(self, tool: str, args: dict[str, Any]) -> dict[str, Any]:
        """
        以同步接口执行异步 adapter 工具，返回与 fastmcp 兼容的结构。
        """

        def _safe_float(v: Any, default: float) -> float:
            """@param v: 输入值 @param default: 默认值 @returns: 可用浮点"""

            try:
                if v is None:
                    return float(default)
                return float(v)
            except (TypeError, ValueError):
                return float(default)

        async def _invoke() -> str:
            if tool == "send_move":
                return await self._adapter.send_move(
                    robot_id=str(args.get("robot_id", "")),
                    linear_velocity=_safe_float(args.get("linear_velocity", 0.0), 0.0),
                    angular_velocity=_safe_float(args.get("angular_velocity", 0.0), 0.0),
                    duration_ms=int(args.get("duration_ms", 1000)),
                )
            if tool == "stop_robot":
                return await self._adapter.stop_robot(robot_id=str(args.get("robot_id", "")))
            if tool == "emergency_stop_all":
                return await self._adapter.emergency_stop_all()
            if tool == "get_robot_status":
                return await self._adapter.get_robot_status(robot_id=str(args.get("robot_id", "")))
            if tool == "list_robots":
                return await self._adapter.list_robots()
            if tool == "compute_remaining_distance":
                return await self._adapter.compute_remaining_distance(
                    robot_a=str(args.get("robot_a", "")),
                    robot_b=str(args.get("robot_b", "")),
                    target_distance_m=_safe_float(args.get("target_distance_m", 1.0), 1.0),
                )
            if tool == "get_fleet_status":
                return await self._adapter.get_fleet_status(robot_ids_csv=str(args.get("robot_ids_csv", "")))
            if tool == "compute_relative_pose":
                return await self._adapter.compute_relative_pose(
                    robot_from=str(args.get("robot_from", "")),
                    robot_to=str(args.get("robot_to", "")),
                )
            if tool == "compute_navigation_hint":
                return await self._adapter.compute_navigation_hint(
                    robot_id=str(args.get("robot_id", "")),
                    target_x=_safe_float(args.get("target_x", 0.0), 0.0),
                    target_y=_safe_float(args.get("target_y", 0.0), 0.0),
                    max_linear_m_s=_safe_float(args.get("max_linear_m_s", 0.2), 0.2),
                    max_angular_rad_s=_safe_float(args.get("max_angular_rad_s", 0.6), 0.6),
                )
            if tool == "plan_line_targets":
                return await self._adapter.plan_line_targets(
                    robot_ids_csv=str(args.get("robot_ids_csv", "")),
                    spacing_m=_safe_float(args.get("spacing_m", 1.0), 1.0),
                )
            raise RuntimeError(f"Unsupported tool for direct mode: {tool}")

        result_text = asyncio.run(_invoke())
        return {
            "content": [{"type": "text", "text": result_text}],
            "is_error": False,
            "structured_content": {"result": result_text},
        }


def _configure_tool_call_mode(mode: str) -> None:
    """配置工具调用模式（direct/fastmcp）。"""

    global _TOOL_CALL_MODE, _LOCAL_TOOL_RUNNER
    _TOOL_CALL_MODE = mode
    if mode == "direct":
        _LOCAL_TOOL_RUNNER = LocalToolRunner()
    else:
        _LOCAL_TOOL_RUNNER = None


def run_mcp_call(*, server_spec: str, tool: str, args: dict[str, Any]) -> dict[str, Any]:
    """
    通过 fastmcp CLI 执行工具调用。

    @param server_spec: 服务器入口（如 main.py）
    @param tool: 工具名
    @param args: 参数 dict（将转换为 key=value）
    @returns: fastmcp CLI 输出的 JSON dict
    @throws RuntimeError: 调用失败或输出不可解析
    """

    if _TOOL_CALL_MODE == "direct":
        if _LOCAL_TOOL_RUNNER is None:
            raise RuntimeError("Direct mode not initialized")
        return _LOCAL_TOOL_RUNNER.call(tool, args)

    cmd = ["fastmcp", "call", server_spec, tool, "--json"]
    for k, v in args.items():
        cmd.append(f"{k}={v}")

    proc = subprocess.run(cmd, capture_output=True, text=True, cwd=str(MCP_PROJECT_ROOT))
    if proc.returncode != 0:
        raise RuntimeError(f"fastmcp call failed: {proc.stderr or proc.stdout}")

    # fastmcp 输出中可能有额外日志行，提取最后一个 JSON 对象
    out = proc.stdout.strip()
    first = out.find("{")
    if first < 0:
        raise RuntimeError(f"Cannot parse fastmcp output: {out}")
    try:
        return json.loads(out[first:])
    except json.JSONDecodeError as e:
        raise RuntimeError(f"Invalid fastmcp JSON output: {out}") from e


def format_fastmcp_cmd(cmd: list[str]) -> str:
    """
    将 fastmcp CLI 参数列表格式化为可读的命令字符串（用于打印/日志）。

    @param cmd: subprocess 参数列表
    @returns: 可读命令行字符串
    """

    parts: list[str] = []
    for p in cmd:
        # 兼容 Windows/PowerShell：含空格的参数加双引号。
        if " " in p or "\t" in p:
            parts.append(f"\"{p}\"")
        else:
            parts.append(p)
    return " ".join(parts)


def main() -> int:
    """
    客户端入口。

    @returns: 进程退出码（0 成功，非 0 失败）
    """

    args = parse_args()
    setup_client_logging()
    _configure_tool_call_mode(args.tool_call_mode)
    # Priority: hardcoded demo key -> environment variable override.
    api_key = DEFAULT_SILICONFLOW_API_KEY.strip() or os.getenv(args.api_key_env, "").strip()
    if not api_key:
        print(
            "[ERROR] Missing API key.\n"
            "- Option A: set DEFAULT_SILICONFLOW_API_KEY in code\n"
            f"- Option B: set environment variable: {args.api_key_env}"
        )
        logger.error("Missing API key (no DEFAULT_SILICONFLOW_API_KEY and no env)")
        return 1

    logger.info("Client started (server_spec=%s model=%s tool_call_mode=%s)", args.server_spec, args.model, args.tool_call_mode)
    print(
        "DeepSeek MCP client started. Terminal output: compact (phase headers + one line per step). "
        "Use --verbose for full JSON/Args/Cmd. Type 'exit' to quit."
    )
    while True:
        try:
            user_text = input("\nUser> ").strip()
        except (KeyboardInterrupt, EOFError):
            print("\nBye.")
            return 0

        if not user_text:
            continue
        if user_text.lower() in {"exit", "quit"}:
            logger.info("User exit")
            print("Bye.")
            return 0

        preferred_template: str | None = None
        preferred_params: dict[str, Any] = {}
        router_snapshot_json = ""
        try:
            fres_router = run_mcp_call(server_spec=args.server_spec, tool="get_fleet_status", args={"robot_ids_csv": ""})
            snap_router = extract_tool_json_string(fres_router) or json.dumps(fres_router, ensure_ascii=False)
            router_snapshot_json = snap_router
            preflight_msg = preflight_user_request_against_fleet(user_text, router_snapshot_json)
            if preflight_msg:
                print(preflight_msg)
                logger.warning("preflight aborted user turn (before template router)")
                continue
            router = infer_template_route_with_llm(
                api_key=api_key,
                model=args.model,
                user_text=user_text,
                fleet_snapshot_json=snap_router,
                args=args,
            )
            if isinstance(router, dict):
                preferred_template = str(router.get("template", "")).strip() or None
                preferred_params = router.get("params") if isinstance(router.get("params"), dict) else {}
                reason_router = str(router.get("reason", "")).strip()
                print(
                    f"Planner> template-router choose={preferred_template or 'none'}"
                    + (f" reason={reason_router}" if reason_router else "")
                )
                logger.info(
                    "template_router choose=%s params=%s reason=%s",
                    preferred_template,
                    json.dumps(preferred_params, ensure_ascii=False),
                    reason_router,
                )
        except Exception as e:
            logger.warning("template router runtime failed: %s", e)

        multi_coord_matches = re.findall(
            r"[（(]?\s*-?\d+(?:\.\d+)?\s*[,，]\s*-?\d+(?:\.\d+)?\s*[）)]?",
            user_text,
        )
        has_multi_coord_targets = len(multi_coord_matches) >= 2

        route_req: tuple[str, list[tuple[float, float]]] | None = None
        if preferred_template in {None, "single_robot_route"}:
            if preferred_template == "single_robot_route":
                rid_pref = str(preferred_params.get("robot_id", "")).strip()
                wps_pref = preferred_params.get("waypoints")
                if rid_pref and isinstance(wps_pref, list):
                    norm_wps: list[tuple[float, float]] = []
                    for wp in wps_pref:
                        if isinstance(wp, (list, tuple)) and len(wp) >= 2:
                            xw = wp[0]
                            yw = wp[1]
                            if isinstance(xw, (int, float)) and isinstance(yw, (int, float)):
                                norm_wps.append((float(xw), float(yw)))
                    if len(norm_wps) >= 2:
                        route_req = (rid_pref, norm_wps)
            if route_req is None:
                route_req = parse_single_robot_multi_waypoints_request(user_text)
        if route_req:
            rid_route, waypoints_route = route_req
            route_plan = RobotRoutePlan(
                robot_id=rid_route,
                waypoints=[(float(x), float(y)) for x, y in waypoints_route],
                tolerance_m=float(args.closed_loop_tolerance_m),
                current_index=0,
            )
            print(
                f"Planner> single-robot route template matched "
                f"(robot={route_plan.robot_id}, waypoints={route_plan.waypoints})"
            )
            try:
                ok_route = run_single_robot_route_template(args=args, route=route_plan)
                if not ok_route:
                    print("[ERROR] route template did not converge; remaining waypoints blocked by gate.")
            except Exception as e:
                logger.exception("single-robot route template failed: %s", e)
                print(f"[ERROR] single-robot route template failed: {e}")
            continue

        if preferred_template in {"single_point", "complex_intent"} and has_multi_coord_targets:
            llm_tasks = infer_multi_robot_point_tasks_with_llm(
                api_key=api_key,
                model=args.model,
                user_text=user_text,
                fleet_snapshot_json=router_snapshot_json,
                args=args,
            )
            llm_tasks = validate_decomposed_point_tasks_before_execute(
                llm_tasks,
                fleet_snapshot_json=router_snapshot_json,
                user_text=user_text,
                log_label="single-point multi-coord",
            )
            if llm_tasks:
                print(
                    "Planner> single-point per-robot template matched "
                    f"(router={preferred_template}) tasks={llm_tasks}"
                )
                try:
                    execute_decomposed_single_point_tasks(
                        tasks=llm_tasks,
                        user_text=user_text,
                        args=args,
                        api_key=api_key,
                        model=args.model,
                    )
                except Exception as e:
                    logger.exception("single-point per-robot template failed: %s", e)
                    print(f"[ERROR] single-point per-robot template failed: {e}")
                continue

        point_req: tuple[str, float, float] | None = None
        if preferred_template in {None, "single_point"}:
            if preferred_template == "single_point":
                rid_pref = str(preferred_params.get("robot_id", "")).strip()
                tx_pref = preferred_params.get("target_x")
                ty_pref = preferred_params.get("target_y")
                if rid_pref and isinstance(tx_pref, (int, float)) and isinstance(ty_pref, (int, float)):
                    point_req = (rid_pref, float(tx_pref), float(ty_pref))
            if point_req is None:
                point_req = parse_point_goal_request(user_text)
        multi_pts_req = parse_multi_point_goal_request(user_text)
        line_req = infer_line_formation_from_nl(user_text, args)
        if point_req and len(multi_pts_req) <= 1 and line_req is None:
            rid_point, tx_point, ty_point = point_req
            print(
                "Planner> single-point template matched "
                f"(robot={rid_point}, target=({float(tx_point):.3f},{float(ty_point):.3f}))"
            )
            try:
                run_closed_loop_point_template(
                    args=args,
                    robot_id=rid_point,
                    target_x=float(tx_point),
                    target_y=float(ty_point),
                )
                run_mcp_call(server_spec=args.server_spec, tool="stop_robot", args={"robot_id": rid_point})
                fres_point = run_mcp_call(server_spec=args.server_spec, tool="get_fleet_status", args={"robot_ids_csv": ""})
                poses_point = fleet_poses_from_mcp_result(fres_point)
                cfg_path = str(MCP_PROJECT_ROOT / "robots.json")
                point_goal = CompletionGoal(
                    kind="point_goal",
                    robot_ids=[rid_point],
                    target_m=0.0,
                    target_points={rid_point: (float(tx_point), float(ty_point))},
                )
                ok_point, reason_point, metrics_point = verify_completion_goal(
                    point_goal,
                    poses_point,
                    tol_m=float(args.closed_loop_tolerance_m),
                    config_path=cfg_path,
                )
                if ok_point:
                    print(f"[VERIFY] point-goal 已达标: {reason_point}")
                    continue
                # 单车点位任务不进入多轮 AUTO-LOOP，仅在验证阶段最多一次 LLM 补动作。
                if not args.no_completion_followup:
                    print("[VERIFY] point-goal 未达标，触发一次性 LLM 验证/补动作。")
                    once_prompt = build_completion_followup_prompt(
                        user_text,
                        round_idx=1,
                        max_rounds=1,
                        metrics=metrics_point,
                        reason=reason_point,
                        goal=point_goal,
                    )
                    once_plan = call_deepseek(
                        api_key=api_key,
                        model=args.model,
                        user_text=once_prompt,
                        connect_timeout_s=float(args.llm_connect_timeout_s),
                        read_timeout_s=float(args.llm_read_timeout_s),
                    )
                    once_phases = normalize_plan_phases(once_plan)
                    _emit_plan_preamble(
                        once_plan,
                        once_phases,
                        verbose=args.verbose,
                        log_event="LLM one-shot point verify followup",
                        terminal_header="Plan(point-verify-once)",
                    )
                    once_phases, _ = _audit_phases_degenerate_or_replan(
                        user_text, once_plan, once_phases, args=args, api_key=api_key, model=args.model
                    )
                    if once_phases is not None and has_action_in_phases(once_phases):
                        _execute_phases_with_runtime_replan(
                            phases=once_phases,
                            user_text=user_text,
                            args=args,
                            api_key=api_key,
                            model=args.model,
                            exec_label="PointVerifyOnce",
                            terminal_header="Plan(runtime-fix-point-verify-once)",
                        )
            except Exception as e:
                logger.exception("single-point template failed: %s", e)
                print(f"[ERROR] single-point template failed: {e}")
            continue

        mover_dist_req: tuple[str, str, float] | None = None
        if preferred_template in {None, "single_mover_distance"}:
            if preferred_template == "single_mover_distance":
                mv_pref = str(preferred_params.get("mover_robot_id", "")).strip()
                rf_pref = str(preferred_params.get("reference_robot_id", "")).strip()
                td_pref = preferred_params.get("target_distance_m")
                if mv_pref and rf_pref and isinstance(td_pref, (int, float)):
                    mover_dist_req = (mv_pref, rf_pref, float(td_pref))
            if mover_dist_req is None:
                mover_dist_req = parse_single_mover_distance_request(user_text)
        if mover_dist_req:
            mover_id, ref_id, tgt_d = mover_dist_req
            print(
                "Planner> single-mover distance (LLM target + template execute) matched "
                f"(mover={mover_id}, ref={ref_id}, target_distance={tgt_d}m)"
            )
            try:
                fres_plan = run_mcp_call(server_spec=args.server_spec, tool="get_fleet_status", args={"robot_ids_csv": ""})
                snap_txt_plan = extract_tool_json_string(fres_plan) or json.dumps(fres_plan, ensure_ascii=False)
                llm_target = infer_single_mover_target_with_llm(
                    api_key=api_key,
                    model=args.model,
                    user_text=user_text,
                    mover_robot_id=mover_id,
                    reference_robot_id=ref_id,
                    target_distance_m=float(tgt_d),
                    fleet_snapshot_json=snap_txt_plan,
                    args=args,
                )
                target_xy: tuple[float, float] | None = llm_target
                if target_xy is None:
                    # LLM 目标点解析失败时，回退到确定性几何补算，避免任务中断。
                    p_move = _fetch_pose(args, mover_id)
                    p_ref = _fetch_pose(args, ref_id)
                    if p_move is not None and p_ref is not None:
                        dx = float(p_ref["x"]) - float(p_move["x"])
                        dy = float(p_ref["y"]) - float(p_move["y"])
                        norm = math.hypot(dx, dy)
                        if norm < 1e-6:
                            ux, uy = math.cos(float(p_ref.get("yaw", 0.0))), math.sin(float(p_ref.get("yaw", 0.0)))
                        else:
                            ux, uy = dx / norm, dy / norm
                        target_xy = (float(p_ref["x"]) - ux * float(tgt_d), float(p_ref["y"]) - uy * float(tgt_d))
                        print(
                            f"[INTENT_TARGETS] fallback target by geometry mover={mover_id} "
                            f"target=({target_xy[0]:.3f},{target_xy[1]:.3f})"
                        )
                if target_xy is None:
                    print("[ERROR] 无法获取单移动方距离任务的目标点，跳过该请求。")
                    continue
                print(
                    f"[INTENT_TARGETS] llm target mover={mover_id} "
                    f"target=({target_xy[0]:.3f},{target_xy[1]:.3f}) ref={ref_id} distance={float(tgt_d):.3f}m"
                )
                run_closed_loop_point_template(
                    args=args,
                    robot_id=mover_id,
                    target_x=float(target_xy[0]),
                    target_y=float(target_xy[1]),
                )
                run_mcp_call(server_spec=args.server_spec, tool="stop_robot", args={"robot_id": mover_id})
                fres_verify = run_mcp_call(server_spec=args.server_spec, tool="get_fleet_status", args={"robot_ids_csv": ""})
                poses_verify = fleet_poses_from_mcp_result(fres_verify)
                cfg_path = str(MCP_PROJECT_ROOT / "robots.json")
                goal = CompletionGoal(kind="pair_distance", robot_ids=[mover_id, ref_id], target_m=float(tgt_d))
                ok_dist, reason_dist, metrics_dist = verify_completion_goal(
                    goal,
                    poses_verify,
                    tol_m=float(args.completion_tolerance_m),
                    config_path=cfg_path,
                )
                if ok_dist:
                    print(f"[VERIFY] pair-distance 已达标: {reason_dist}")
                    continue
                # 仅在验证阶段调用一次 LLM，避免反复思考导致时延。
                if not args.no_completion_followup:
                    print("[VERIFY] 单模板未达标，触发一次性 LLM 验证/补动作。")
                    once_prompt = build_completion_followup_prompt(
                        user_text,
                        round_idx=1,
                        max_rounds=1,
                        metrics=metrics_dist,
                        reason=reason_dist,
                        goal=goal,
                    )
                    once_plan = call_deepseek(
                        api_key=api_key,
                        model=args.model,
                        user_text=once_prompt,
                        connect_timeout_s=float(args.llm_connect_timeout_s),
                        read_timeout_s=float(args.llm_read_timeout_s),
                    )
                    once_phases = normalize_plan_phases(once_plan)
                    _emit_plan_preamble(
                        once_plan,
                        once_phases,
                        verbose=args.verbose,
                        log_event="LLM one-shot verify followup",
                        terminal_header="Plan(verify-once)",
                    )
                    once_phases, _ = _audit_phases_degenerate_or_replan(
                        user_text, once_plan, once_phases, args=args, api_key=api_key, model=args.model
                    )
                    if once_phases is not None and has_action_in_phases(once_phases):
                        _execute_phases_with_runtime_replan(
                            phases=once_phases,
                            user_text=user_text,
                            args=args,
                            api_key=api_key,
                            model=args.model,
                            exec_label="VerifyOnce",
                            terminal_header="Plan(runtime-fix-verify-once)",
                        )
            except Exception as e:
                logger.exception("single-mover distance template failed: %s", e)
                print(f"[ERROR] single-mover distance template failed: {e}")
            continue

        complex_task_probe = is_complex_constraint_task(user_text, args)
        # 模板路由已选 llm_plan 时不得再“升级”为逐车点位：否则会把不支持的意图误拆成多车去原点等错误执行。
        if preferred_template is None and not complex_task_probe:
            llm_tasks_nt = infer_multi_robot_point_tasks_with_llm(
                api_key=api_key,
                model=args.model,
                user_text=user_text,
                fleet_snapshot_json=router_snapshot_json,
                args=args,
            )
            llm_tasks_nt = validate_decomposed_point_tasks_before_execute(
                llm_tasks_nt,
                fleet_snapshot_json=router_snapshot_json,
                user_text=user_text,
                log_label="non-template point upgrade",
            )
            if llm_tasks_nt:
                print(
                    "Planner> non-template upgraded to per-robot point templates "
                    f"(router={preferred_template or 'none'}) tasks={llm_tasks_nt}"
                )
                try:
                    execute_decomposed_single_point_tasks(
                        tasks=llm_tasks_nt,
                        user_text=user_text,
                        args=args,
                        api_key=api_key,
                        model=args.model,
                    )
                except Exception as e:
                    logger.exception("non-template per-robot template failed: %s", e)
                    print(f"[ERROR] non-template per-robot template failed: {e}")
                continue

        planner_mode = str(getattr(args, "planner", "hybrid")).lower()
        complex_task = complex_task_probe
        print(f"Planner> mode={planner_mode} complex_task={complex_task}")
        if planner_mode == "hybrid" and complex_task and preferred_template in {None, "complex_intent", "llm_plan"}:
            try:
                intent = infer_complex_intent_with_llm(
                    api_key=api_key,
                    model=args.model,
                    user_text=user_text,
                    args=args,
                )
                executed = execute_complex_intent_template(intent=intent, user_text=user_text, args=args)
                if executed:
                    continue
                print("[WARN] complex intent template mapping failed, fallback to LLM tool-plan mode.")
            except Exception as e:
                logger.exception("Complex intent template path failed: %s", e)
                print(f"[ERROR] complex intent template path failed: {e}. fallback to LLM tool-plan mode.")

        llm_input = user_text
        if args.prime_list:
            try:
                inv = run_mcp_call(server_spec=args.server_spec, tool="list_robots", args={})
                snap = extract_tool_json_string(inv)
                if snap:
                    llm_input = (
                        "Live QT bind table from list_robots (trust this for which unit_id exist):\n"
                        f"{snap}\n\nUser request:\n{user_text}"
                    )
                    logger.info("Primed LLM context with list_robots snapshot length=%s", len(snap))
            except Exception as e:
                logger.warning("prime_list failed, continuing without snapshot: %s", e)

        try:
            plan = call_deepseek(
                api_key=api_key,
                model=args.model,
                user_text=llm_input,
                connect_timeout_s=float(args.llm_connect_timeout_s),
                read_timeout_s=float(args.llm_read_timeout_s),
            )
            phases = normalize_plan_phases(plan)
            _emit_plan_preamble(plan, phases, verbose=args.verbose)
            phases, plan = _audit_phases_degenerate_or_replan(
                user_text, plan, phases, args=args, api_key=api_key, model=args.model
            )
            if phases is None:
                continue
            if args.dry_run:
                continue

            phase1_results = _execute_phases_with_runtime_replan(
                phases=phases,
                user_text=user_text,
                args=args,
                api_key=api_key,
                model=args.model,
                exec_label="Phase",
                terminal_header="Plan(runtime-fix-1)",
            )

            if needs_action_from_user_intent(user_text) and not has_action_in_phases(phases):
                replan_input = build_action_replan_input(
                    user_text=user_text, executed_phases=phases, observed_results=phase1_results
                )
                phase2_plan = call_deepseek(
                    api_key=api_key,
                    model=args.model,
                    user_text=replan_input,
                    connect_timeout_s=float(args.llm_connect_timeout_s),
                    read_timeout_s=float(args.llm_read_timeout_s),
                )
                phase2_phases = normalize_plan_phases(phase2_plan)
                _emit_plan_preamble(
                    phase2_plan,
                    phase2_phases,
                    verbose=args.verbose,
                    log_event="LLM phase2 plan",
                    terminal_header="Plan2",
                )
                if has_action_in_phases(phase2_phases):
                    _execute_phases_with_runtime_replan(
                        phases=phase2_phases,
                        user_text=user_text,
                        args=args,
                        api_key=api_key,
                        model=args.model,
                        exec_label="Phase2",
                        terminal_header="Plan(runtime-fix-2)",
                    )
                else:
                    print("[WARN] Phase2 plan still has no action step; no movement executed.")

            if not args.no_completion_followup:
                cfg_path = str(MCP_PROJECT_ROOT / "robots.json")
                mx = max(0, int(args.completion_max_extra_rounds))
                history_lines: list[str] = []
                for p in phases:
                    history_lines.append(f"Phase:{p.get('name', 'phase')} -> {compact_step_sequence(p.get('steps') or [])}")
                print(f"[AUTO-LOOP] 启用 LLM 自主闭环，最大续跑 {mx} 轮。")
                auto_done = False
                for extra in range(1, mx + 1):
                    fres = run_mcp_call(
                        server_spec=args.server_spec,
                        tool="get_fleet_status",
                        args={"robot_ids_csv": ""},
                    )
                    snap_txt = extract_tool_json_string(fres) or json.dumps(fres, ensure_ascii=False)
                    metric_hint = ""
                    metric_ok = False
                    metric_reason = ""
                    comp_goal = infer_completion_goal(user_text, args)
                    if comp_goal is not None:
                        poses = fleet_poses_from_mcp_result(fres)
                        ok, reason, metrics = verify_completion_goal(
                            comp_goal,
                            poses,
                            tol_m=float(args.completion_tolerance_m),
                            config_path=cfg_path,
                        )
                        metric_ok = bool(ok)
                        metric_reason = str(reason)
                        if comp_goal.kind in {"point_goal", "multi_point"}:
                            metric_hint = (
                                f"goal={comp_goal.kind}:{comp_goal.robot_ids}:"
                                f"{json.dumps(comp_goal.target_points or {}, ensure_ascii=False)}; "
                                f"ok={ok}; reason={reason}; metrics={json.dumps(metrics, ensure_ascii=False)}"
                            )
                        elif comp_goal.kind == "composite":
                            metric_hint = (
                                f"goal=composite:{comp_goal.robot_ids}:"
                                f"subgoals={json.dumps([g.kind for g in (comp_goal.subgoals or [])], ensure_ascii=False)}; "
                                f"ok={ok}; reason={reason}; metrics={json.dumps(metrics, ensure_ascii=False)}"
                            )
                        else:
                            metric_hint = (
                                f"goal={comp_goal.kind}:{comp_goal.robot_ids}:{comp_goal.target_m}m; "
                                f"ok={ok}; reason={reason}; metrics={json.dumps(metrics, ensure_ascii=False)}"
                            )
                    if comp_goal is not None and metric_ok:
                        auto_done = True
                        print(f"[AUTO-LOOP] 完成: 几何验收达标（{metric_reason}）")
                        logger.info("autonomous loop done by geometric verification round=%s reason=%s", extra, metric_reason)
                        break
                    fu = build_autonomous_followup_prompt(
                        user_text,
                        round_idx=extra,
                        max_rounds=mx,
                        fleet_snapshot_json=snap_txt,
                        history_lines=history_lines,
                        metric_hint=metric_hint,
                        goal=comp_goal,
                    )
                    plan = call_deepseek(
                        api_key=api_key,
                        model=args.model,
                        user_text=fu,
                        connect_timeout_s=float(args.llm_connect_timeout_s),
                        read_timeout_s=float(args.llm_read_timeout_s),
                    )
                    done, done_reason = parse_llm_done_signal(plan)
                    if done:
                        if comp_goal is not None and not metric_ok:
                            print("[AUTO-LOOP] LLM 判定完成，但几何验收未达标；继续续跑。")
                            logger.warning(
                                "autonomous loop ignore llm done due to metric mismatch round=%s reason=%s",
                                extra,
                                metric_reason,
                            )
                        else:
                            auto_done = True
                            done_reason = done_reason or "LLM 判定任务达标，主动结束。"
                            print(f"[AUTO-LOOP] 完成: {done_reason}")
                            logger.info("autonomous loop done at round=%s reason=%s", extra, done_reason)
                            break
                    phases = normalize_plan_phases(plan)
                    _emit_plan_preamble(
                        plan,
                        phases,
                        verbose=args.verbose,
                        log_event=f"LLM autonomous followup {extra}",
                        terminal_header=f"Plan(auto-{extra})",
                    )
                    phases, plan = _audit_phases_degenerate_or_replan(
                        user_text, plan, phases, args=args, api_key=api_key, model=args.model
                    )
                    if phases is None:
                        print("[AUTO-LOOP] 续跑计划未通过退化审计，停止。")
                        break
                    if violates_autoloop_goal_scope(phases, comp_goal):
                        print("[AUTO-LOOP] 续跑计划引入与点位目标无关的 pair-distance 步骤，已拒绝本轮执行。")
                        logger.warning("autonomous loop round=%s violates point-goal scope; skip round", extra)
                        history_lines.append(f"Auto{extra}:rejected_scope_violation")
                        continue
                    if not has_action_in_phases(phases):
                        print("[AUTO-LOOP] LLM 返回未包含动作步骤，停止续跑。")
                        logger.warning("autonomous loop round=%s has no action; stop", extra)
                        break
                    round_results = _execute_phases_with_runtime_replan(
                        phases=phases,
                        user_text=user_text,
                        args=args,
                        api_key=api_key,
                        model=args.model,
                        exec_label=f"Auto{extra}",
                        terminal_header=f"Plan(runtime-fix-auto-{extra})",
                    )
                    for p in phases:
                        history_lines.append(
                            f"Auto{extra}:{p.get('name', 'phase')} -> {compact_step_sequence(p.get('steps') or [])}"
                        )
                    history_lines.append(f"Auto{extra}:results={len(round_results)}")
                if (not auto_done) and mx > 0:
                    print(f"[AUTO-LOOP] 达到最大续跑次数 ({mx}) 或提前中止，结束。")
        except Exception as e:
            logger.exception("Request failed: %s", e)
            print(f"[ERROR] {e}")


if __name__ == "__main__":
    sys.exit(main())

