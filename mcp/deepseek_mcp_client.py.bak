_LOCAL_TOOL_RUNNER: "LocalToolRunner | None" = None


class PlanRuntimeRejected(RuntimeError):
    """
    运行时审计拒绝：用于携带已执行观测结果，便于触发重规划。

    @param message: 拒绝原因
    @param observed_results: 已执行结果快照
    """

    def __init__(self, message: str, observed_results: list[tuple[str, dict[str, Any], dict[str, Any]]]) -> None:
        super().__init__(message)
        self.observed_results = observed_results


def setup_client_logging() -> None:
    """
    配置客户端日志：写入项目根目录 `logs/client.log`（UTF-8），并输出到 stderr。

    幂等：若已为 logger 添加过 handler 则跳过，避免重复刷写。
    """

    if logger.handlers:
        return
    log_dir = Path(__file__).resolve().parent / "logs"
    log_dir.mkdir(parents=True, exist_ok=True)
    log_path = log_dir / "client.log"
    fmt = logging.Formatter("%(asctime)s [%(levelname)s] %(name)s: %(message)s")
    fh = logging.FileHandler(log_path, encoding="utf-8")
    fh.setFormatter(fmt)
    fh.setLevel(logging.INFO)
    sh = logging.StreamHandler(sys.stderr)
    sh.setFormatter(fmt)
    # 终端仅保留警告/错误，避免 INFO 大 JSON 影响交互；详细信息保留在日志文件。
    sh.setLevel(logging.WARNING)
    logger.setLevel(logging.INFO)
    logger.addHandler(fh)
    logger.addHandler(sh)


