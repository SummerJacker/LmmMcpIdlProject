        "--prime-list",
        action="store_true",
        help="Before each LLM turn, call list_robots and attach snapshot (recommended for NL+QT mock verification)",
    )
    parser.add_argument(
        "--closed-loop-max-iters",
        type=int,
        default=10,
        help="Max iterations for distance closed-loop template, default: 10",
    )
    parser.add_argument(
        "--closed-loop-tolerance-m",
        type=float,
        default=0.1,
        help="Distance convergence tolerance in meters, default: 0.1",
